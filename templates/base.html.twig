<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}YOUL TCG{% endblock %}</title>
    <link rel="icon"
          href="{{ asset('images/ytcg_logo.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Pirata+One&display=swap">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/theme.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/base.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/holo.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/holo-presets.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/frame.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>
<body class="flex min-h-screen flex-col bg-bg font-sans text-ink antialiased">
<div class="scanlines" aria-hidden="true"></div>
{% block header %}
    {{ include('parts/_header.html.twig') }}
{% endblock %}
{% block body %}
{% endblock %}
{% block footer %}
    {{ include('parts/_footer.html.twig') }}
{% endblock %}
{# realtime: one Mercure subscription per page, redispatched as live-updates:* window events #}
{% set liveUpdatesUrl = live_updates_url() %}
{% if liveUpdatesUrl %}
    <div hidden data-controller="live-updates" data-live-updates-url-value="{{ liveUpdatesUrl }}" data-testid="live-updates"></div>
{% endif %}
<div class="toast-stack" aria-live="polite"
     data-controller="toast"
     data-action="toast:show@window->toast#show live-updates:toast@window->toast#show live-updates:notification@window->toast#show"></div>
</body>
</html>

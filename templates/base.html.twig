<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}YTCG{% endblock %}</title>
    <link rel="icon"
          href="{{ asset('images/ytcg_logo.png') }}">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/base.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/cards/rarity.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen bg-gray-700">
{% block header %}
    {{ include('parts/_header.html.twig') }}
{% endblock %}
{% block body %}
{% endblock %}
</body>
</html>

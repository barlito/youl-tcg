<header class="border-b border-hairline">
    <div class="flex items-center justify-between px-6 py-5 lg:px-14">
        <a href="{{ path('homepage') }}" class="flex items-center gap-3.5">
            <img src="{{ asset('images/ytcg_logo.png') }}" alt="Logo YOUL"
                 class="h-12 w-12 object-contain [filter:drop-shadow(0_0_14px_#a435f0aa)]">
            <span class="flex flex-col gap-1 leading-none">
                <span class="skew-brand font-display text-[26px] font-bold tracking-[-0.04em] text-ink-strong">YOUL</span>
                <span class="font-mono text-[9px] tracking-[.28em] text-primary">TRADING CARD GAME</span>
            </span>
        </a>

        <nav class="hidden items-center gap-7 font-display text-sm font-semibold uppercase tracking-[.1em] md:flex">
            {{ _self.nav_link('homepage', 'Accueil') }}
            {{ _self.nav_link('collection', 'Collection', ['recycle']) }}
            {{ _self.nav_link('universes', 'Univers') }}
            {{ _self.nav_link('boosters', 'Boosters') }}
            {{ _self.nav_link('leaderboard', 'Classement') }}
            {% if feature_enabled('trades') and app.user %}
                {{ component('TradesNavLink', { active: app.request.get('_route')|default('') starts with 'trades' }) }}
            {% elseif feature_enabled('trades') %}
                <a href="{{ path('trades') }}" class="text-ink-muted hover:text-ink-strong">Échanges</a>
            {% else %}
                {{ _self.nav_soon('Échanges') }}
            {% endif %}
            {{ _self.nav_soon('Duels') }}
        </nav>

        <div class="flex items-center gap-3 sm:gap-4">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="chip-mono text-ink-dim hover:text-primary">Admin</a>
            {% endif %}
            {% if app.user %}
                {{ component('NotificationBell') }}
                {% set balance = wallet_balance() %}
                <a href="{{ youl_coin_hub_url }}" class="chip-mono text-ink hover:text-primary"
                   data-controller="wallet-balance"
                   data-action="live-updates:wallet-changed@window->wallet-balance#update"
                   data-testid="wallet-balance"
                   {% if not balance %}title="Solde Youl Coin momentanément indisponible"{% endif %}>
                    <span data-wallet-balance-target="amount">{{ balance ? balance.format : '—' }}</span> YLC
                </a>
                <span class="flex items-center gap-2.5 border border-hairline bg-surface p-1 sm:pr-3.5">
                    <span class="flex h-7 w-7 items-center justify-center bg-gradient-to-br from-primary to-magenta font-display text-sm font-bold text-black">
                        {{ app.user.username|first|upper }}
                    </span>
                    <span class="hidden font-mono text-xs text-ink sm:inline">{{ app.user.username }}</span>
                </span>
                <a href="{{ path('app_logout') }}" class="chip-mono text-ink-dim hover:text-magenta">Quitter</a>
            {% endif %}
        </div>
    </div>
</header>

{% macro nav_link(route, label, aliases = []) %}
    {# starts with = les sous-pages allument aussi l'entrée (universes_show → Univers) ;
       aliases = pages rattachées à l'entrée sans en partager le préfixe (recycle → Collection) #}
    {% set current = app.request.get('_route')|default('') %}
    {% set isActive = current starts with route or aliases|filter(alias => current starts with alias)|length > 0 %}
    <a href="{{ path(route) }}"
       class="text-ink-muted hover:text-ink-strong {{ isActive ? 'active' : '' }}"
       {{ isActive ? 'aria-current="page"' }}>{{ label }}</a>
{% endmacro %}

{% macro nav_soon(label) %}
    <span class="flex items-center gap-1.5 text-ink-dim" aria-disabled="true">
        {{ label }}
        <span class="font-mono text-[9px] tracking-[.15em] text-soon">SOON</span>
    </span>
{% endmacro %}

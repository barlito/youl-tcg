{# « À faire aujourd'hui » : une tuile par action (selon les feature flags), puis la bande
   collection / classement / série / wishlist. Tuile = un seul lien ; en mobile elle passe en ligne
   (icône + titre + texte + ›), le faux bouton disparaît. #}
{% set claims = today.claims %}
{% set streak = today.streak %}
{% set unopened = today.unopenedBoosters %}
{% set packsWaiting = claims.remaining > 0 or unopened > 0 %}
{% set fusions = today.fusions %}
{% set actions = (packsWaiting ? 1 : 0)
    + (today.pendingTrades ? 1 : 0)
    + (fusions and fusions.possible > 0 ? 1 : 0)
    + (today.recycledToday is same as(false) ? 1 : 0) %}
{% set catalogue = cardsTotal|default(0) %}

<section aria-labelledby="todo" class="flex flex-col gap-3 md:gap-4" data-testid="home-today">
    <div class="flex items-baseline justify-between gap-4">
        <h2 id="todo" class="h2 max-md:font-mono max-md:text-[11px] max-md:font-medium max-md:tracking-[.12em]">À faire aujourd'hui</h2>
        <span class="muted text-sm" data-testid="today-actions">{{ actions > 0 ? actions ~ ' action' ~ (actions > 1 ? 's') : 'Rien d\'urgent' }}</span>
    </div>

    <div class="act-grid">
        {# packs of the day: the tile lights up while something is waiting #}
        <a href="{{ path('boosters') }}" class="act{{ packsWaiting ? ' hot' }}" data-testid="today-claims">
            <span class="act__head"><span class="lbl">Packs du jour</span>{% if claims.remaining > 0 %}<span class="dot" aria-hidden="true"></span>{% endif %}</span>
            <span class="act__ic" aria-hidden="true">{{ claims.remaining > 0 ? claims.remaining : unopened }}</span>
            <span class="act__value"><span class="d text-[32px] text-ink-strong">{{ claims.remaining }}</span><span class="d text-lg text-ink-muted">/{{ claims.limit }}</span></span>
            <span class="act__text">
                {% if claims.remaining > 0 %}
                    gratuit{{ claims.remaining > 1 ? 's' }} à récupérer
                {% else %}
                    recharge dans <span data-controller="countdown" data-countdown-seconds-value="{{ claims.secondsUntilReset }}">--:--:--</span>
                {% endif %}
                {% if unopened > 0 %}
                    · <span class="text-live" data-testid="today-unopened">{{ unopened }} pack{{ unopened > 1 ? 's' }} à ouvrir</span>
                {% endif %}
            </span>
            <span class="act__cta btn btn-s {{ packsWaiting ? 'btn-p' : 'btn-g' }}">{{ claims.remaining > 0 ? 'Récupérer' : (unopened > 0 ? 'Ouvrir' : 'Mes packs') }}</span>
            <span class="act__chev" aria-hidden="true">›</span>
        </a>

        {% if today.pendingTrades is not null %}
            {% set trades = today.pendingTrades %}
            <a href="{{ path('trades') }}" class="act{{ trades > 0 ? ' hot' }}" data-testid="today-trades">
                <span class="act__head"><span class="lbl">Échanges</span>{% if trades > 0 %}<span class="badge">{{ trades }}</span>{% endif %}</span>
                <span class="act__ic text-live" aria-hidden="true">⇄</span>
                <span class="act__value"><span class="d text-[32px] text-ink-strong">{{ trades }}</span></span>
                <span class="act__text">
                    {{ trades > 0 ? (trades > 1 ? 'offres attendent ta réponse' : 'offre attend ta réponse') : 'Aucune offre reçue' }}
                </span>
                <span class="act__cta btn btn-s {{ trades > 0 ? 'btn-p' : 'btn-g' }}">{{ trades > 0 ? 'Voir l\'offre' ~ (trades > 1 ? 's') : 'Proposer' }}</span>
                <span class="act__chev" aria-hidden="true">›</span>
            </a>
        {% endif %}

        {% if fusions is not null %}
            <a href="{{ path('fusion') }}" class="act" data-testid="today-fusion">
                <span class="act__head"><span class="lbl">Fusion</span><span class="text-[#c27bff]" aria-hidden="true">✦</span></span>
                <span class="act__ic text-[#c27bff]" aria-hidden="true">✦</span>
                <span class="act__value"><span class="d text-[32px] text-ink-strong">✦ {{ fusions.possible }}</span></span>
                <span class="act__text">
                    {% if fusions.possible > 0 %}
                        fusion{{ fusions.possible > 1 ? 's' }} possible{{ fusions.possible > 1 ? 's' }} sur {{ fusions.cards }} carte{{ fusions.cards > 1 ? 's' }}
                    {% else %}
                        10 doublons normaux = 1 holo
                    {% endif %}
                </span>
                <span class="act__cta btn btn-g btn-s">Fusionner</span>
                <span class="act__chev" aria-hidden="true">›</span>
            </a>
        {% endif %}

        {% if today.recycledToday is not null %}
            <a href="{{ path('recycle') }}" class="act" data-testid="today-recycle">
                <span class="act__head"><span class="lbl">Recyclage</span>{% if not today.recycledToday %}<span class="dot" aria-hidden="true"></span>{% endif %}</span>
                <span class="act__ic {{ today.recycledToday ? 'text-ink-dim' : 'text-live' }}" aria-hidden="true">{{ today.recycledToday ? '✓' : '↻' }}</span>
                <span class="act__value"><span class="d text-[22px] {{ today.recycledToday ? 'text-ink-muted' : 'text-ink-strong' }}">{{ today.recycledToday ? 'Fait aujourd\'hui' : 'Disponible' }}</span></span>
                <span class="act__text">{{ today.recycledToday ? 'prochain recyclage demain' : '1 recyclage par jour · 10 pts = 1 pack' }}</span>
                <span class="act__cta btn btn-g btn-s">Recycler</span>
                <span class="act__chev" aria-hidden="true">›</span>
            </a>
        {% endif %}
    </div>

    {# bande QG : collection, classement, série, wishlist #}
    <div class="panel qg-band">
        <a href="{{ path('collection') }}" class="qg-band__cell qg-band__cell--wide" data-testid="today-collection">
            <span class="flex items-baseline justify-between gap-3">
                <span class="lbl">Collection</span>
                <span class="mono text-[13px] text-ink-strong">{% if catalogue > 0 %}{{ today.ownedCards }} / {{ catalogue }} · {% endif %}{{ today.completionPct }} %</span>
            </span>
            <span class="bar" aria-hidden="true"><i style="width: {{ today.completionPct }}%"></i></span>
        </a>
        <a href="{{ path('leaderboard') }}" class="qg-band__cell" data-testid="today-rank">
            <span class="lbl">Classement</span>
            <span class="d text-xl text-ink-strong">#{{ today.rank }}</span>
        </a>
        <a href="{{ path('boosters') }}" class="qg-band__cell" data-testid="today-streak">
            <span class="lbl">Série</span>
            <span class="d text-xl text-ink-strong">{{ streak.length }} j
                <span class="font-sans text-[13px] font-normal {{ streak.atRisk ? 'text-magenta' : 'text-ink-muted' }}">·
                    {% if streak.atRisk %}
                        ouvre un pack avant minuit !
                    {% elseif streak.openedToday %}
                        palier à {{ streak.nextMilestone }} j
                    {% else %}
                        ouvre un pack pour la lancer
                    {% endif %}
                </span>
            </span>
        </a>
        {% if today.wishesOnSale is not null %}
            <a href="{{ path('market', { wishlist: 1 }) }}" class="qg-band__cell" data-testid="today-wishlist">
                <span class="lbl">Wishlist</span>
                <span class="d text-xl text-ink-strong"><span class="text-magenta">♡</span> {{ today.wishesOnSale }}
                    <span class="font-sans text-[13px] font-normal text-ink-muted">· {{ today.wishesOnSale > 0 ? 'en vente' : 'rien en vente' }}</span>
                </span>
            </a>
        {% endif %}
    </div>
</section>

{# « En direct » : the week's big pulls (rarity + universe only, never the card), the 1/1 hunt,
   community counters and the newest market listings (listings are visible in clear) #}
{% macro ago(date) %}
    {%- set seconds = 'now'|date('U') - date|date('U') -%}
    {%- if seconds < 3600 -%}il y a {{ max(1, (seconds / 60)|round(0, 'floor')) }} min
    {%- elseif seconds < 86400 -%}il y a {{ (seconds / 3600)|round(0, 'floor') }} h
    {%- else -%}il y a {{ (seconds / 86400)|round(0, 'floor') }} j
    {%- endif -%}
{% endmacro %}

<section id="direct" aria-labelledby="live" class="flex flex-col gap-4 pt-12 md:pt-16" data-testid="home-live">
    <div class="flex flex-col gap-1.5">
        <p class="eyebrow">En direct</p>
        <h2 id="live" class="h2">Le multivers <span class="grad">bouge</span></h2>
    </div>

    <div class="grid gap-4 lg:grid-cols-[1.2fr_1fr]">
        <div class="flex min-w-0 flex-col gap-2">
            <span class="lbl">Gros tirages de la semaine</span>
            {% if community.pulls is empty %}
                <p class="panel p-5 text-sm text-ink-muted">
                    Aucune légendaire tirée cette semaine. La tienne sera peut-être la première.
                </p>
            {% else %}
                <ul class="panel divide-y divide-hairline" data-testid="live-pulls">
                    {% for pull in community.pulls %}
                        <li class="flex items-center gap-3 px-4 py-3" data-testid="live-pull">
                            {% if pull.unique %}
                                <span class="chip chip-soon shrink-0">◆ 1/1</span>
                            {% else %}
                                <span class="chip shrink-0 r-{{ pull.rarity|first }}" style="border-color: color-mix(in srgb, var(--rarity-{{ pull.rarity }}) 45%, transparent);">
                                    {{ rarity_icon(pull.rarity) }} {{ rarity_label(pull.rarity) }}{{ pull.holo ? ' ✦' }}
                                </span>
                            {% endif %}
                            <p class="min-w-0 flex-1 truncate text-sm text-ink-muted">
                                <a href="{{ path('leaderboard_player', { discordId: pull.discordId }) }}" class="font-semibold text-ink-strong hover:text-magenta">{{ pull.player }}</a>
                                {{ pull.unique ? 'a trouvé une 1/1' : 'a tiré une légendaire' }} dans
                                <a href="{{ path('universes_show', { slug: pull.slug }) }}" class="text-ink-strong hover:text-magenta">{{ pull.universe }}</a>
                            </p>
                            <span class="lbl shrink-0 normal-case tracking-normal">{{ _self.ago(pull.openedAt) }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="grid grid-cols-2 gap-3 self-start" data-testid="live-counters">
            {% set counters = [
                {label: '1/1 trouvées', value: community.uniques.found ~ ' / ' ~ community.uniques.total, accent: true},
                {label: 'Joueurs actifs (7 j)', value: community.activePlayers},
                {label: 'Packs ouverts', value: packsOpenedCount|number_format(0, ',', ' ')},
                {label: 'Cartes tirées', value: cardsPulledCount|number_format(0, ',', ' ')},
                {label: 'Holos en circulation', value: community.holoCopies|number_format(0, ',', ' ')},
                {label: 'Échanges conclus', value: community.tradesAccepted|number_format(0, ',', ' ')},
                {label: 'Fusions réalisées', value: community.fusions|number_format(0, ',', ' ')},
                {label: 'Cartes à collectionner', value: cardsTotal|number_format(0, ',', ' ')},
            ] %}
            {% for counter in counters %}
                <div class="panel flex flex-col gap-1 px-4 py-3{{ counter.accent|default(false) ? ' hot' }}">
                    <span class="lbl">{{ counter.label }}</span>
                    <span class="d text-2xl {{ counter.accent|default(false) ? 'text-soon' : 'text-ink-strong' }}">{{ counter.value }}</span>
                </div>
            {% endfor %}
        </div>
    </div>

    {% if latestListings is not empty %}
        <div class="flex items-end justify-between gap-4 pt-6">
            <span class="lbl">Fraîchement au marché</span>
            <a href="{{ path('market') }}" class="btn btn-g btn-s">Tout le marché</a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4" data-testid="live-listings">
            {% for listing in latestListings %}
                {% set card = listing.card %}
                <a href="{{ path('market', { univers: card.extension.slug }) }}" class="panel group relative flex min-w-0 flex-col gap-2 p-3 transition-colors hover:border-primary" data-testid="live-listing">
                    {% if listing.holo %}
                        <span class="chip chip-holo absolute right-2 top-2 z-10 bg-bg/90">✦ Holo</span>
                    {% endif %}
                    <div class="mx-auto w-full max-w-[11rem]">
                        {{ include('components/CardComponent.html.twig', {
                            card: card,
                            holo: listing.holo,
                            interactive: false,
                            lazy: true,
                            id: 'home-listing-' ~ listing.id,
                        }, with_context = false) }}
                    </div>
                    <span class="cn" title="{{ card.name }}">{{ card.name }}</span>
                    <span class="lbl truncate"><span class="r-{{ card.rarity.value|first }}">{{ rarity_icon(card.rarity.value) }} {{ card.rarity.label }}</span> · {{ listing.seller.username }}</span>
                    <span class="d text-lg text-ink-strong">{{ coin_amount(listing.price) }} <span class="text-xs text-soon">YLC</span></span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</section>

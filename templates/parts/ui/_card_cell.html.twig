{#
  Card cell `.cell`: artwork + name + rarity (icon + label, ♛ 1/1) + quantities.
  Params: card (null = masked: card back, no name/artwork), rarity (scalar, only hint of a masked card),
    quantity (« ×N », holos included), holoQuantity (« ✦ N »), holo (default false), interactive (3D tilt, default false),
    lazy (default true), id (DOM id, set it when the card shows twice), maskedLabel (default « Carte à trouver »),
    showRarity (default true), suffix (appended to the rarity line), unique (1/1 mark of a MASKED card),
    wishUrl / wished (♡, visible cards only), holoToggleClass (adds « ✦ HOLO », owned in both finishes),
    badge ({ text, class, testid }), artClass, state (data-state), attrs (map), rarityTestid, testid (default « card-cell »)
#}
{% set card = card|default(null) %}
{% set quantity = quantity|default(null) %}
{% set holoQuantity = holoQuantity|default(0) %}
{% set rarityValue = card ? card.rarity.value : rarity|default(null) %}
{% set holoToggleClass = card ? holoToggleClass|default(null) : null %}
{% set badge = badge|default(null) %}
<div class="cell" data-testid="{{ testid|default('card-cell') }}"
     {%- if rarityValue %} data-rarity="{{ rarityValue }}"{% endif %}
     {%- if state|default(null) %} data-state="{{ state }}"{% endif %}
     {%- for name, value in attrs|default({}) %} {{ name }}="{{ value }}"{% endfor %}
     {%- if holoToggleClass %} data-controller="holo-toggle" data-holo-toggle-holo-class-value="{{ holoToggleClass }}"{% endif %}>
    <div class="cell__art">
        <div class="{{ artClass|default('') }}">
            {% if card %}
                {{ include('components/CardComponent.html.twig', {
                    card: card,
                    holo: holo|default(false),
                    interactive: interactive|default(false),
                    lazy: lazy ?? true,
                    id: id|default(card.id),
                }, with_context = false) }}
            {% else %}
                {{ include('parts/_masked_card.html.twig', rarityValue ? { rarity: rarityValue } : {}, with_context = false) }}
            {% endif %}
        </div>
        {% if quantity %}<span class="qty">×{{ quantity }}</span>{% endif %}
        {% if badge %}
            <span class="cell__badge chip {{ badge.class|default('') }}"{% if badge.testid|default(null) %} data-testid="{{ badge.testid }}"{% endif %}>{{ badge.text }}</span>
        {% endif %}
        {% if holoToggleClass %}
            {# hors de .card : un clic sur la carte déclenche le zoom 3D #}
            <button type="button" class="cell__toggle chip chip-holo" aria-pressed="true"
                    data-action="holo-toggle#toggle" data-holo-toggle-target="button" data-testid="holo-toggle">✦ Holo</button>
        {% endif %}
        {% if card and wishUrl|default(null) %}
            {{ include('parts/_wish_button.html.twig', { url: wishUrl, active: wished|default(false) }, with_context = false) }}
        {% endif %}
    </div>
    {% if card %}
        <span class="cn" title="{{ card.name }}">{{ card.name }}</span>
    {% else %}
        <span class="cm">{{ maskedLabel|default('Carte à trouver') }}</span>
    {% endif %}
    {% if (showRarity ?? true) and rarityValue %}
        <span class="lbl r-{{ rarityValue|first }}"{% if rarityTestid|default(null) %} data-testid="{{ rarityTestid }}"{% endif %}>
            {{ rarity_icon(rarityValue) }} {{ rarity_label(rarityValue) }}
            {%- if (card and card.isUnique) or (not card and unique|default(false)) %} <span class="r-s" data-testid="chip-unique">· {{ unique_icon() }} 1/1</span>{% endif %}
            {%- if holoQuantity > 0 %} <span class="text-magenta">· ✦ {{ holoQuantity }}</span>{% endif %}
            {%- if suffix|default(null) %} <span class="text-ink-muted">· {{ suffix }}</span>{% endif %}
        </span>
    {% endif %}
</div>

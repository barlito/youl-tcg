{#
  « Mon espace » sub-navigation (`.tab`), for the nav block of _page_header; feature-flagged tabs follow their flag.
  Params: current = collection | wishlist | openings | recycle | fusion, counts (optional, same keys, e.g. { openings: 15 })
#}
{% set counts = counts|default({}) %}
{% set items = [
    { key: 'collection', route: 'collection', label: 'Collection', enabled: true },
    { key: 'wishlist', route: 'wishlist', label: 'Wishlist', enabled: feature_enabled('wishlist') },
    { key: 'openings', route: 'opening_history', label: 'Mes ouvertures', enabled: true },
    { key: 'recycle', route: 'recycle', label: 'Recyclage', enabled: feature_enabled('recycling') },
    { key: 'fusion', route: 'fusion', label: 'Fusion', enabled: feature_enabled('fusion') },
] %}
<nav aria-label="Mon espace" class="subnav" data-controller="subnav" data-testid="my-space-nav">
    {% for item in items|filter(item => item.enabled) %}
        {% set isCurrent = item.key == current|default('') %}
        <a href="{{ path(item.route) }}" class="tab"{{ isCurrent ? ' aria-current="page"' }}>
            {{- item.label -}}
            {% if counts[item.key] is defined and counts[item.key] is not null %}
                <span class="lbl" data-testid="my-space-count-{{ item.key }}">{{ counts[item.key] }}</span>
            {% endif %}
        </a>
    {% endfor %}
</nav>

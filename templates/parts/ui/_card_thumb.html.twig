{# Flat thumbnail of a VISIBLE card with its rarity glow. Params: card (never masked), holo (default false), class #}
<img class="card-thumb g-{{ card.rarity.value|first }}{{ holo|default(false) ? ' card-thumb--holo' }} {{ class|default('') }}"
     src="{{ card.imageName ? vich_uploader_asset(card) : asset('images/default_card.png') }}"
     alt="" loading="lazy" decoding="async">

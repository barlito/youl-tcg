{# 20 px mobile tab bar icon. `name`: home | boosters | collection | trades | universes | more #}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    {%- if name == 'home' -%}
        <path d="M3 10.5 12 3l9 7.5V21H3z"/>
    {%- elseif name == 'boosters' -%}
        <rect x="5" y="3" width="14" height="18"/><path d="M9 8h6"/>
    {%- elseif name == 'collection' -%}
        <rect x="3" y="4" width="8" height="16"/><rect x="13" y="4" width="8" height="16"/>
    {%- elseif name == 'trades' -%}
        <path d="M4 8h14l-4-4"/><path d="M20 16H6l4 4"/>
    {%- elseif name == 'universes' -%}
        <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/>
    {%- else -%}
        <circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>
    {%- endif -%}
</svg>

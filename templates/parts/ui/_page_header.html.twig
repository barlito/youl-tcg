{#
  Page header `.ph`, used with embed:
    {% embed 'parts/ui/_page_header.html.twig' with { eyebrow: 'Mon espace', title: 'Mes ouvertures', lead: '…' } %}
        {% block actions %}<a class="btn btn-p" href="…">Ouvrir un pack</a>{% endblock %}
    {% endembed %}
  Params: eyebrow, title (h1 text), lead, testid (default « page-header »).
  Blocks: title (rich h1), actions (right, below on mobile), aside (under the lead), nav (sub-navigation on the bottom edge)
#}
{% set navHtml %}{% block nav %}{% endblock %}{% endset %}
{% set actionsHtml %}{% block actions %}{% endblock %}{% endset %}
{% set navHtml = navHtml|trim %}
{% set actionsHtml = actionsHtml|trim %}
<div class="ph" data-testid="{{ testid|default('page-header') }}">
    <div class="wrap flex flex-col gap-5 pt-8 md:pt-9 {{ navHtml ? '' : 'pb-8' }}">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div class="flex min-w-0 flex-col gap-2.5">
                {% if eyebrow|default %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
                <h1 class="h1">{% block title %}{{ title }}{% endblock %}</h1>
                {% if lead|default %}<p class="lead">{{ lead }}</p>{% endif %}
                {% block aside %}{% endblock %}
            </div>
            {% if actionsHtml %}
                <div class="flex shrink-0 flex-wrap items-center gap-2.5">{{ actionsHtml|raw }}</div>
            {% endif %}
        </div>
        {{ navHtml|raw }}
    </div>
</div>

{# « Prochain univers » striped tile, no link: flagged universe's name + blurred artwork, else a placeholder; `class` = grid sizing #}
{% set coverUrl = upcoming
    ? (upcoming.imageName ? vich_uploader_asset(upcoming) : (upcomingCover|default ? asset('uploads/cards/' ~ upcomingCover)))
    : null %}
<article class="tile tile--soon soon-tile {{ class|default('') }}{{ upcoming ? '' : ' opacity-70' }}" data-testid="soon-tile">
    {% if coverUrl %}
        {# scale-110: the blur pulls the edges inwards, push them out of the frame #}
        <img src="{{ coverUrl }}" alt="" loading="lazy" onerror="this.remove()" aria-hidden="true"
             class="soon-tile__img scale-110 blur-lg">
    {% endif %}
    <span class="chip chip-soon mb-auto self-start bg-bg/80">▸ Bientôt</span>
    <span class="d up text-[22px] leading-none text-ink-strong">{{ upcoming ? upcoming.name : 'Prochain univers' }}</span>
    <span class="text-sm text-ink-muted">{{ upcoming ? 'Annonce à suivre.' : 'Annonce bientôt. Reste connecté.' }}</span>
</article>

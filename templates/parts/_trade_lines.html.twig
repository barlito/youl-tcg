{# Cartes d'un côté d'une offre. `lines` = TradeLineView[], `label` = intitulé,
   `tone` = give|get (couleur de l'intitulé), `idPrefix` = préfixe d'id unique
   (une même carte peut figurer dans plusieurs offres de la page). La visibilité
   est déjà tranchée côté serveur : une vue masquée ne porte aucune carte,
   seulement sa rareté. #}
{% set copies = lines|reduce((sum, line) => sum + line.totalQuantity, 0) %}
<div class="trade-side trade-side--{{ tone|default('get') }}">
    <span class="lbl trade-side__label">{{ label }} · {{ copies }} carte{{ copies > 1 ? 's' }}</span>
    {% if lines is empty %}
        <p class="muted text-sm">—</p>
    {% else %}
        <div class="trade-side__cells">
            {% for line in lines %}
                {% if line.new %}
                    {% set suffix = 'nouvelle' %}
                {% elseif tone|default('get') == 'get' and line.masked and line.owned is same as(0) %}
                    {% set suffix = 'nouvelle pour toi' %}
                {% elseif line.masked and line.owned is same as(0) %}
                    {% set suffix = 'plus en ta possession' %}
                {% elseif not line.masked and line.owned %}
                    {% set suffix = 'tu en as ' ~ line.owned %}
                {% else %}
                    {% set suffix = null %}
                {% endif %}
                {{ include('parts/ui/_card_cell.html.twig', {
                    card: line.card,
                    rarity: line.rarity.value,
                    quantity: line.totalQuantity > 1 ? line.totalQuantity : null,
                    holoQuantity: line.holoQuantity,
                    holo: line.holoQuantity > 0,
                    id: idPrefix ~ '-' ~ loop.index,
                    maskedLabel: 'Carte inconnue',
                    suffix: suffix,
                    rarityTestid: line.masked ? 'masked-rarity' : null,
                    testid: 'trade-line',
                }, with_context = false) }}
            {% endfor %}
        </div>
    {% endif %}
</div>

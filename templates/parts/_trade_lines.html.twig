{# Cartes d'un côté d'une offre. `lines` = TradeLineView[], `label` = intitulé,
   `idPrefix` = préfixe d'id unique (une même carte peut figurer dans plusieurs
   offres de la page). La visibilité est déjà tranchée côté serveur : une vue
   masquée ne porte aucune carte, seulement sa rareté. #}
<div>
    <p class="chip-mono text-ink-muted">{{ label }}</p>
    {% if lines is empty %}
        <p class="mt-2 text-sm text-ink-dim">—</p>
    {% else %}
        <div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4">
            {% for line in lines %}
                <div class="min-w-0">
                    <div class="relative">
                        {% if line.masked %}
                            {{ include('parts/_masked_card.html.twig', { rarity: line.rarity.value }, with_context = false) }}
                        {% else %}
                            {{ include('components/CardComponent.html.twig', {
                                card: line.card,
                                holo: line.holoQuantity > 0,
                                interactive: false,
                                lazy: true,
                                id: idPrefix ~ '-' ~ loop.index,
                            }, with_context = false) }}
                        {% endif %}
                        <span class="chip-mono absolute -right-1.5 -top-1.5 z-10 bg-black/90 px-1.5 py-0.5 font-bold text-white">
                            ×{{ line.totalQuantity }}{% if line.holoQuantity > 0 %} <span class="text-magenta">✦{{ line.holoQuantity }}</span>{% endif %}
                        </span>
                    </div>
                    <p class="mt-1.5 truncate font-display text-[11px] font-bold uppercase leading-tight {{ line.masked ? 'text-ink-dim' : 'text-ink-strong' }}"
                       {% if not line.masked %}title="{{ line.card.name }}"{% endif %}>
                        {{ line.masked ? 'Carte inconnue' : line.card.name }}
                    </p>
                    <p class="chip-mono truncate" style="color: var(--rarity-{{ line.rarity.value }});"{% if line.masked %} data-testid="masked-rarity"{% endif %}>
                        {{ line.rarity.label }}
                    </p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

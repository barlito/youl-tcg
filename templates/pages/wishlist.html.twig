{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Ma wishlist
{% endblock %}

{% block body %}
    <main>
        {% embed 'parts/ui/_page_header.html.twig' with {
            eyebrow: 'Mon espace',
            title: 'Ma wishlist',
            lead: 'Tu es prévenu dès qu\'une carte surveillée passe en vente. Pour les cartes que tu n\'as jamais vues, surveille leur univers entier.',
        } %}
            {% block actions %}
                <a href="{{ path('market', { wishlist: 1 }) }}" class="btn btn-g max-md:w-full" data-testid="market-wishlist-link">Voir au marché</a>
            {% endblock %}
            {% block nav %}{{ include('parts/ui/_my_space_nav.html.twig', { current: 'wishlist' }) }}{% endblock %}
        {% endembed %}

        {{ component('WishlistPanel') }}
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Ma collection
{% endblock %}

{% block body %}
    <main>
    {% set query = view.query %}
    {% set slugParams = currentExtension ? { slug: currentExtension.slug } : {} %}
    {% set rarityOptions = card_rarities()|reverse %}

    {% embed 'parts/ui/_profile_head.html.twig' with {
        player: app.user,
        entry: entry,
        owned: comparison.owned,
        total: comparison.total,
        percentage: comparison.completionPct,
    } %}
        {% block top %}<p class="eyebrow">Mon espace</p>{% endblock %}
        {% block meta %}
            joueur depuis {{ app.user.createdAt|date('m/Y') }} ·
            <a href="{{ path('leaderboard') }}" class="text-ink-muted hover:text-ink-strong" data-testid="leaderboard-link">#{{ entry.rank }} au classement</a>
        {% endblock %}
        {% block aside %}
            <div class="flex flex-col gap-2.5 md:min-w-[340px]">
                <a href="{{ path('boosters') }}" class="btn btn-p" data-testid="open-pack-link">
                    Ouvrir un pack{% if unopenedBoosters > 0 %} · {{ unopenedBoosters }}{% endif %}
                </a>
                {% if feature_enabled('recycling') or feature_enabled('fusion') %}
                    <div class="flex gap-2.5">
                        {% if feature_enabled('recycling') %}
                            <a href="{{ path('recycle') }}" class="btn btn-g btn-s flex-1" data-testid="recycle-link">Recycler</a>
                        {% endif %}
                        {% if feature_enabled('fusion') %}
                            <a href="{{ path('fusion') }}" class="btn btn-g btn-s flex-1" data-testid="fusion-link">Fusionner</a>
                        {% endif %}
                    </div>
                {% endif %}
                <p class="lbl text-center md:text-right" data-testid="daily-packs">
                    Packs gratuits du jour : <span class="text-ink-strong">{{ remainingClaims }} / {{ dailyLimit }}</span>
                </p>
            </div>
        {% endblock %}
        {% block nav %}
            {{ include('parts/ui/_my_space_nav.html.twig', {
                current: 'collection',
                counts: { wishlist: wishlistEnabled ? wishedIds|length : null, openings: entry.openedBoosters },
            }) }}
        {% endblock %}
    {% endembed %}

    <div class="wrap flex flex-col gap-7 pb-24 pt-6 md:pt-8">
        {{ include('parts/ui/_universe_strip.html.twig', {
            strip: strip,
            currentExtension: currentExtension,
            route: 'collection',
            query: query.params(),
            owned: comparison.owned,
            total: comparison.total,
            percentage: comparison.completionPct,
        }) }}

        {% if visible.owned == 0 %}
            <div class="panel flex flex-col items-center gap-3 px-8 py-12 text-center" data-testid="empty-state">
                <p class="h2">Vide.</p>
                <p class="muted text-sm">
                    {{ currentExtension is not null ? 'Aucune carte de cet univers. Ouvre un pack, gros youl.' : 'Aucune carte pour le moment. Ouvre un pack, gros youl.' }}
                </p>
                <a href="{{ path('boosters') }}" class="btn btn-p mt-2">Ouvrir un pack</a>
            </div>
        {% endif %}

        {% if visible.total > 0 %}
            {# filtres dans l'url (GET) : partageables, et la recherche reste côté serveur,
               où une carte face cachée n'est jamais comparée à un nom #}
            <form method="get" action="{{ path('collection', slugParams) }}" role="search"
                  class="panel coll-filters" aria-label="Filtres"
                  data-controller="collection-filters" data-testid="collection-filters">
                <div class="coll-filters__top">
                    <label for="collection-search" class="sr">Rechercher une de mes cartes</label>
                    <input id="collection-search" class="field coll-filters__q" type="search" name="q"
                           value="{{ query.search }}" maxlength="{{ constant('App\\Dto\\CollectionQuery::MAX_SEARCH_LENGTH') }}"
                           placeholder="Rechercher une carte…" autocomplete="off" data-testid="collection-search">
                    <button type="button" class="seg coll-filters__toggle{{ query.panelFilterCount > 0 ? ' on' }}"
                            aria-expanded="false" aria-controls="collection-filter-panel"
                            data-collection-filters-target="toggle" data-action="collection-filters#toggle"
                            data-testid="collection-filters-toggle">
                        Filtres{% if query.panelFilterCount > 0 %} · {{ query.panelFilterCount }}{% endif %}
                    </button>
                </div>

                <div id="collection-filter-panel" class="coll-filters__panel" data-collection-filters-target="panel">
                    <div role="group" aria-label="Possession" class="flex flex-wrap gap-1.5" data-testid="possession-filters">
                        {% for filter in [
                            { value: 'toutes', label: 'Toutes', count: visible.total },
                            { value: 'possedees', label: 'Possédées', count: visible.owned },
                            { value: 'manquantes', label: 'Manquantes', count: visible.missingBoth },
                        ] %}
                            {% set active = query.possession.value == filter.value %}
                            {% if filter.count == 0 and not active and not loop.first %}
                                {# rien à montrer : lisible mais inactif #}
                                <span class="seg opacity-40" aria-disabled="true" data-filter="{{ filter.value }}">{{ filter.label }} · 0</span>
                            {% else %}
                                <a href="{{ path('collection', slugParams|merge(query.params({ filtre: loop.first ? null : filter.value }))) }}"
                                   class="seg{{ active ? ' on' }}"{{ active ? ' aria-current="true"' }}
                                   data-filter="{{ filter.value }}">{{ filter.label }} · {{ filter.count }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% if query.possession.value != 'toutes' %}<input type="hidden" name="filtre" value="{{ query.possession.value }}">{% endif %}

                    <span class="coll-filters__sep" aria-hidden="true"></span>

                    <label class="sr" for="collection-rarity">Rareté</label>
                    <select id="collection-rarity" name="rarete" class="dd dd-select{{ query.rarity ? ' on' }}"
                            data-action="collection-filters#submit" data-testid="collection-rarity">
                        <option value="">Rareté : toutes</option>
                        {% for rarity in rarityOptions %}
                            <option value="{{ rarity.value }}" {{ query.rarity == rarity ? 'selected' }}>{{ rarity.icon }} {{ rarity.label }}</option>
                        {% endfor %}
                    </select>

                    <label class="sr" for="collection-finish">Finition</label>
                    <select id="collection-finish" name="finition" class="dd dd-select{{ query.finish ? ' on' }}"
                            data-action="collection-filters#submit" data-testid="collection-finish">
                        <option value="">Finition : toutes</option>
                        <option value="holo" {{ query.finish and query.finish.value == 'holo' ? 'selected' }}>✦ Holo</option>
                        <option value="normale" {{ query.finish and query.finish.value == 'normale' ? 'selected' }}>Normale</option>
                    </select>

                    <label class="sr" for="collection-sort">Trier par</label>
                    <select id="collection-sort" name="tri" class="dd dd-select md:ml-auto{{ query.sort.value != 'univers' ? ' on' }}"
                            data-action="collection-filters#submit" data-testid="collection-sort">
                        {% for sort in enum('App\\Enum\\Collection\\CollectionSortEnum').cases() %}
                            <option value="{{ sort.value }}" {{ query.sort == sort ? 'selected' }}>Tri : {{ sort.label|lower }}</option>
                        {% endfor %}
                    </select>

                    <div class="flex items-center gap-4 max-md:w-full max-md:justify-between">
                        {% if query.isFiltered %}
                            <a href="{{ path('collection', slugParams) }}" class="tl" data-testid="collection-reset">Réinitialiser</a>
                        {% endif %}
                        <button type="submit" class="btn btn-p btn-s coll-filters__apply">Appliquer</button>
                    </div>
                </div>
            </form>

            {% if query.search %}
                <p class="muted -mt-3 text-[13px]" data-testid="collection-search-hint">
                    La recherche ne porte que sur tes cartes : une carte face cachée n'a pas encore de nom pour toi.
                </p>
            {% endif %}
        {% endif %}

        {% for section in view.sections %}
            {% set universe = section.universe %}
            <section class="flex flex-col gap-4"
                     {% if universe %}aria-labelledby="u-{{ universe.extension.slug }}" data-testid="collection-universe"{% else %}aria-labelledby="u-results" data-testid="collection-results"{% endif %}>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    {% if universe %}
                        <h2 id="u-{{ universe.extension.slug }}" class="h2">
                            <a href="{{ path('universes_show', { slug: universe.extension.slug }) }}" class="text-ink-strong no-underline hover:text-primary">{{ universe.extension.name }}</a>
                        </h2>
                        <span class="muted" data-testid="universe-count">
                            {{ universe.owned }} / {{ universe.total }} possédée{{ universe.owned > 1 ? 's' }} · {{ universe.missingBoth }} à trouver
                            {%- if query.isFiltered %} · {{ section.items|length }} affichée{{ section.items|length > 1 ? 's' }}{% endif %}
                        </span>
                    {% else %}
                        <h2 id="u-results" class="h2">{{ view.resultCount }} carte{{ view.resultCount > 1 ? 's' }}</h2>
                        <span class="muted">triées par {{ query.sort.label|lower }}</span>
                    {% endif %}
                    {% if loop.first %}
                        <span class="muted text-[13px] md:ml-auto" data-testid="masking-hint">Face cachée = pas encore trouvée, seule la rareté est visible</span>
                    {% endif %}
                </div>

                <div class="set-grid set-grid--dense" data-testid="collection-grid">
                    {% for item in section.items %}
                        {% set userCard = item.profileCard %}
                        {% set suffix = universe ? null : item.card.extension.name %}
                        {% if userCard %}
                            {% set ownsHolo = userCard.holoQuantity > 0 %}
                            {# quantity = TOUTES les copies (holos compris) : une normale existe si quantity > holoQuantity #}
                            {% set ownsNormal = userCard.quantity > userCard.holoQuantity %}
                            {% set showHolo = query.finish ? query.finish.value == 'holo' : ownsHolo %}
                            {{ include('parts/ui/_card_cell.html.twig', {
                                card: item.card,
                                quantity: userCard.quantity,
                                holoQuantity: userCard.holoQuantity,
                                holo: showHolo,
                                interactive: true,
                                suffix: suffix,
                                state: item.state.value,
                                testid: 'collection-tile',
                                holoToggleClass: ownsHolo and ownsNormal and not query.finish ? (card_visual(item.card).holoEffect.cssClass ?? 'holo--basic') : null,
                                wishUrl: wishlistEnabled ? path('wishlist_card_toggle', { id: item.card.id }) : null,
                                wished: wishedIds[item.card.id ~ ''] is defined,
                            }, with_context = false) }}
                        {% else %}
                            {# carte manquante : dos de carte, rareté seule (jamais nom, artwork ni id) #}
                            {{ include('parts/ui/_card_cell.html.twig', {
                                card: null,
                                rarity: item.card.rarity.value,
                                unique: item.card.isUnique,
                                suffix: suffix,
                                state: item.state.value,
                                testid: 'collection-tile',
                                artClass: 'opacity-60',
                            }, with_context = false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </section>
        {% else %}
            {% if visible.total > 0 %}
                <div class="panel flex flex-col items-center gap-3 px-8 py-12 text-center" data-testid="filter-empty">
                    <p class="h2">Aucune carte.</p>
                    <p class="muted text-sm">
                        {{ query.search ? 'Aucune de tes cartes ne correspond à « ' ~ query.search ~ ' ».' : 'Rien ne correspond à ces filtres.' }}
                    </p>
                    <a href="{{ path('collection', slugParams) }}" class="btn btn-g btn-s mt-2">Réinitialiser les filtres</a>
                </div>
            {% endif %}
        {% endfor %}
    </div>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Le multivers des Youls
{% endblock %}

{% set days = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'] %}
{% set months = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

{% block body %}
    {% set claims = today.claims %}
    {% set unopened = today.unopenedBoosters %}
    <main class="pb-24">
        {# ------------------------------------------------------------ Hero #}
        {#- the band carries the halo full-bleed, the hero content stays in the container -#}
        <div class="home-hero-band">
        <section class="wrap home-hero" data-testid="home-hero">
            <div class="flex min-w-0 flex-col gap-4 md:gap-5">
                <p class="eyebrow">Ton QG · {{ days['now'|date('w', 'Europe/Paris')] }} {{ 'now'|date('j', 'Europe/Paris') }} {{ months['now'|date('n', 'Europe/Paris') - 1] }}</p>
                <h1 class="home-hero__title d up">Salut <span class="grad">{{ app.user.username }}</span>.</h1>
                <p class="home-hero__lead" data-testid="home-headline">{{ headline }}</p>
                <div class="flex flex-wrap gap-3 pt-2">
                    {% if claims.remaining > 0 %}
                        <a class="btn btn-p max-md:w-full" href="{{ path('boosters') }}" data-testid="hero-claim">
                            Récupérer {{ claims.remaining > 1 ? 'mes ' ~ claims.remaining ~ ' packs' : 'mon pack' }}
                        </a>
                    {% endif %}
                    {% if unopened > 0 %}
                        <a class="btn {{ claims.remaining > 0 ? 'btn-g max-md:hidden' : 'btn-p max-md:w-full' }}" href="{{ path('boosters', { filtre: 'stock' }) }}" data-testid="hero-open">
                            Ouvrir un pack · {{ unopened }}
                        </a>
                    {% endif %}
                    {% if claims.remaining == 0 and unopened == 0 %}
                        <a class="btn btn-g max-md:w-full" href="{{ path('universes') }}">Explorer les univers</a>
                    {% endif %}
                </div>
            </div>
            {# les cartes du jour, en éventail derrière le logo #}
            <div class="home-hero__stage">
                <img src="{{ asset('images/ytcg_logo.png') }}" alt="" class="home-hero__logo">
                {% for card in cards %}
                    <div class="home-hero__card home-hero__card--{{ loop.index }}">
                        <div class="hero-float" style="--float-delay: {{ (loop.index0 * 0.4)|number_format(1) }}s;">
                            {{ include('components/CardComponent.html.twig') }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
        </div>

        <div class="wrap">
        {# ---------------------------------------------- À faire + bande QG #}
        {{ include('parts/home/_today.html.twig') }}

        {# ------------------------------------------------ Presque complets #}
        {% if toFinish is not empty %}
            <section aria-labelledby="near" class="flex flex-col gap-4 pt-12 md:pt-16" data-testid="home-to-finish">
                <div class="flex items-end justify-between gap-4">
                    <div class="flex flex-col gap-1.5">
                        <p class="eyebrow">Presque complets</p>
                        <h2 id="near" class="h2">Encore un effort</h2>
                    </div>
                    <a class="btn btn-g btn-s max-md:hidden" href="{{ path('collection') }}">Toute ma collection</a>
                    <a class="lbl text-magenta md:hidden" href="{{ path('collection') }}">Tout voir</a>
                </div>
                <div class="near-row">
                    {% for universe in toFinish %}
                        {% set extension = universe.extension %}
                        {% set missing = universe.total - universe.owned %}
                        {% embed 'parts/ui/_universe_tile.html.twig' with {
                            extension: extension,
                            class: 'near-row__tile',
                            nameClass: 'text-base md:text-[22px]',
                            testid: 'to-finish-universe',
                            universe: universe,
                            missing: missing,
                        } only %}
                            {% block name_aside %}<span class="d shrink-0 text-base leading-none text-ink-strong md:text-[22px]">{{ universe.percentage }} %</span>{% endblock %}
                            {% block content %}
                                <div class="bar"><i style="width: {{ universe.percentage }}%"></i></div>
                                <span class="text-sm text-ink">
                                    <span class="max-md:hidden">{{ universe.owned }} / {{ universe.total }} · </span><strong class="font-semibold text-magenta">il en manque {{ missing }}</strong>
                                </span>
                                {% if universe.reward %}
                                    {# seules les cartes tirées par le joueur comptent pour la récompense #}
                                    <span class="lbl text-ink max-md:hidden" data-testid="to-finish-reward">★ {{ universe.reward.drawn }}/{{ universe.reward.total }} tirées par toi · +{{ universe.reward.amount }} YLC</span>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# --------------------------------------------------------- Univers #}
        <section id="univers" aria-labelledby="univ" class="flex flex-col gap-4 pt-12 md:pt-16">
            <div class="flex items-end justify-between gap-4">
                <div class="flex flex-col gap-1.5">
                    <p class="eyebrow">Univers · {{ universesTotal }} live{{ upcoming ? ', 1 bientôt' }}</p>
                    <h2 id="univ" class="h2">Les univers</h2>
                </div>
                <a class="btn btn-g btn-s shrink-0 whitespace-nowrap" href="{{ path('universes') }}">Tous les univers</a>
            </div>

            {# les 3 derniers univers sortis ; la liste complète vit sur /univers #}
            <div class="home-univ home-univ--n{{ min(universes|length, 3) }}">
                {% for item in universes %}
                    {% set extension = item.extension %}
                    {% set owned = ownedByExtension[extension.id ~ '']|default(0) %}
                    {% embed 'parts/ui/_universe_tile.html.twig' with {
                        extension: extension,
                        class: loop.first ? 'home-univ__main' : '',
                        nameClass: loop.first ? 'text-[30px]' : 'text-xl',
                        item: item,
                        owned: owned,
                        first: loop.first,
                    } only %}
                        {% block top %}
                            {# live = at least one claimable booster right now #}
                            {% if item.hasClaimableBooster %}<span class="chip chip-live bg-bg/80" data-testid="live-badge">● live</span>{% endif %}
                        {% endblock %}
                        {% block content %}
                            {% if first and extension.description %}
                                <span class="line-clamp-2 text-sm text-ink">{{ extension.description }}</span>
                            {% endif %}
                            <span class="lbl text-ink">
                                {{ item.cardCount }} carte{{ item.cardCount > 1 ? 's' }} ·
                                {% if item.cardCount > 0 and owned >= item.cardCount %}<span class="text-live">✓ complet</span>{% else %}tu en as {{ owned }}{% endif %}
                            </span>
                        {% endblock %}
                    {% endembed %}
                {% endfor %}

                {# Tuile teaser : absorbe la 4e case du layout magazine, sans bouton #}
                {{ include('parts/_soon_tile.html.twig', { upcoming, upcomingCover, class: 'home-univ__soon' }, with_context = false) }}
            </div>
        </section>

        {# ------------------------------------------------------ En direct #}
        {{ include('parts/home/_live.html.twig') }}

        {# --------------------------------------------------------- Raretés #}
        {% set rarities = card_rarities() %}
        <section id="raretes" aria-labelledby="rar" class="flex flex-col gap-4 pt-12 md:pt-16">
            <div class="flex flex-col gap-1.5">
                <p class="eyebrow">Raretés</p>
                <h2 id="rar" class="h2">{{ rarities|length }} paliers.</h2>
            </div>
            {# Pas de « drop rate » global : les vrais taux sont définis slot par slot, booster par booster (« Taux » du hub) #}
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
                {% for rarity in rarities %}
                    <div class="panel flex flex-col gap-1 p-4" style="border-top: 3px solid var(--rarity-{{ rarity.value }});">
                        <span class="lbl r-{{ rarity.value|first }}">Palier {{ '%02d'|format(loop.index) }}</span>
                        <span class="d up text-xl text-ink-strong"><span class="r-{{ rarity.value|first }}">{{ rarity_icon(rarity.value) }}</span> {{ rarity.label }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# --------------------------------------------------------- Roadmap #}
        <section id="roadmap" aria-labelledby="road" class="flex flex-col gap-4 pt-12 md:pt-16">
            <div class="flex flex-col gap-1.5">
                <p class="eyebrow">Roadmap</p>
                <h2 id="road" class="h2">La suite.</h2>
            </div>
            {% set roadmap = [
                {quarter: 'Q3 26', state: 'Live', title: 'Ouverture de packs', chip: 'chip-live'},
                {quarter: 'Q4 26', state: 'Live', title: 'Échanges & marché', chip: 'chip-live'},
                {quarter: 'Q4 26', state: 'Nouveau', title: 'Fusion & wishlist', chip: 'chip-holo'},
                {quarter: 'Q1 27', state: 'Prévu', title: 'Mode Duel', chip: 'chip-soon'},
                {quarter: '2027', state: 'Vision', title: 'Saisons ranked', chip: ''},
            ] %}
            <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
                {% for step in roadmap %}
                    <li class="panel flex flex-col gap-2 p-4">
                        <span class="flex items-center justify-between gap-2"><span class="lbl">{{ step.quarter }}</span><span class="chip {{ step.chip }}">{{ step.state }}</span></span>
                        <span class="d up text-lg leading-tight text-ink-strong">{{ step.title }}</span>
                    </li>
                {% endfor %}
            </ol>
        </section>
        </div>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Nouvelle offre d'échange
{% endblock %}

{% block body %}
    <main data-controller="player-search">
        <div class="ph" data-testid="page-header">
            <div class="wrap flex flex-col gap-5 pb-8 pt-6 md:flex-row md:items-end md:justify-between md:pt-9">
                <div class="flex min-w-0 flex-col gap-2.5">
                    <a href="{{ path('trades') }}" class="lbl no-underline hover:text-ink-strong">‹ Échanges</a>
                    <h1 class="h1">Avec <span class="grad">qui</span> ?</h1>
                    <p class="lead">Les joueurs sont classés par intérêt : ceux qui ont le plus de cartes qui te manquent en premier.</p>
                </div>
                {% if scores is not empty %}
                    <div class="shrink-0">
                        <label for="player-search" class="sr">Chercher un joueur</label>
                        <input id="player-search" type="search" class="field w-full md:w-[280px]"
                               placeholder="Chercher un joueur…" autocomplete="off"
                               data-action="input->player-search#filter"
                               data-testid="player-search">
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="wrap pb-24 pt-8">
            {% if scores is empty %}
                <div class="panel px-8 py-16 text-center" data-testid="no-players">
                    <p class="d up text-lg text-ink-strong">Personne.</p>
                    <p class="muted mt-3 text-sm">Tu es seul sur le multivers pour l'instant.</p>
                </div>
            {% else %}
                <div class="player-grid" data-testid="player-list">
                    {% for score in scores %}
                        {% set player = score.player %}
                        {% set best = loop.first and score.total > 0 %}
                        <a href="{{ path('trades_compose', { discordId: player.discordId }) }}"
                           class="panel player-match{{ best ? ' hot' }}"
                           data-player-search-target="player"
                           data-name="{{ player.username|lower }}"
                           data-testid="player-match">
                            {% if best %}<span class="chip chip-fill player-match__best" data-testid="best-match">Meilleur match</span>{% endif %}
                            <span class="av oct-s h-12 w-12 text-xl" aria-hidden="true">{{ player.username|first|upper }}</span>
                            <span class="flex min-w-0 flex-col gap-2.5">
                                <strong class="d up flex flex-wrap items-center gap-x-2 gap-y-1 text-[17px] text-ink-strong">
                                    <span class="min-w-0 truncate">{{ player.username }}</span>
                                    {% if (player.discordId ~ '') in offersFrom %}<span class="chip chip-soon" data-testid="offer-received">offre reçue</span>{% endif %}
                                </strong>
                                <span class="grid grid-cols-2 gap-2.5">
                                    <span data-testid="match-they-have">
                                        <span class="d block text-2xl {{ score.theyHaveForMe > 0 ? 'text-live' : 'text-ink-dim' }}">{{ score.theyHaveForMe }}</span>
                                        <span class="muted block text-xs leading-snug">carte{{ score.theyHaveForMe > 1 ? 's' }} qui te manque{{ score.theyHaveForMe > 1 ? 'nt' }}</span>
                                    </span>
                                    <span data-testid="match-i-have">
                                        <span class="d block text-2xl {{ score.iHaveForThem > 0 ? 'text-ink-strong' : 'text-ink-dim' }}">{{ score.iHaveForThem }}</span>
                                        <span class="muted block text-xs leading-snug">de tes doublons lui manque{{ score.iHaveForThem > 1 ? 'nt' }}</span>
                                    </span>
                                </span>
                            </span>
                        </a>
                    {% endfor %}
                </div>
                <p class="panel muted mt-4 px-6 py-10 text-center text-sm" hidden data-player-search-target="empty" data-testid="no-player-match">
                    Aucun joueur ne correspond à ta recherche.
                </p>
            {% endif %}
        </div>
    </main>
{% endblock %}

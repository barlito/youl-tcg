{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Nouvelle offre d'échange
{% endblock %}

{% block body %}
    <main>
        <section class="relative border-b border-hairline px-6 py-10 lg:px-12">
            <div class="glow-ambient" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl">
                <p class="eyebrow">04 / Échanges</p>
                <h1 class="mt-2 font-display text-4xl font-bold uppercase tracking-[-0.04em] text-ink-strong md:text-5xl">
                    Avec <span class="text-primary">qui</span> ?
                </h1>
                <p class="mt-2 max-w-lg text-sm text-ink-muted">
                    Choisis le joueur à qui proposer un échange.
                </p>
            </div>
        </section>

        <section class="px-6 py-10 lg:px-12">
            <div class="mx-auto max-w-7xl">
                {% if players is empty %}
                    <div class="border border-dashed border-hairline px-8 py-16 text-center text-ink-dim" data-testid="no-players">
                        <p class="font-display text-lg font-bold uppercase tracking-[.15em]">Personne.</p>
                        <p class="mt-3 text-sm">Tu es seul sur le multivers pour l'instant.</p>
                    </div>
                {% else %}
                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-testid="player-list">
                        {% for player in players %}
                            <a href="{{ path('trades_compose', { discordId: player.discordId }) }}"
                               class="flex items-center gap-3 border border-hairline bg-surface p-4 transition-colors hover:border-primary/60">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-primary to-magenta font-display text-lg font-bold text-black">
                                    {{ player.username|first|upper }}
                                </span>
                                <span class="min-w-0">
                                    <span class="block truncate font-display text-sm font-bold uppercase tracking-[-0.02em] text-ink-strong">{{ player.username }}</span>
                                    <span class="chip-mono text-ink-dim">{{ player.distinctCardCount }} cartes</span>
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                <a href="{{ path('trades') }}" class="btn-ghost mt-8 inline-block">◂ Retour aux échanges</a>
            </div>
        </section>
    </main>
{% endblock %}

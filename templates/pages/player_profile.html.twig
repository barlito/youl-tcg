{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Profil de {{ profile.username }}
{% endblock %}

{% block body %}
    <main>
    {# pseudo tronqué : un pseudo Discord long ferait déborder les segments en mobile #}
    {% set shortName = profile.username|slice(0, 12) ~ (profile.username|length > 12 ? '…' : '') %}

    {% embed 'parts/ui/_profile_head.html.twig' with {
        player: profile,
        entry: entry,
        owned: comparison.owned,
        total: comparison.total,
        percentage: comparison.completionPct,
        completionTestid: 'profile-completion',
    } %}
        {% block top %}
            <a href="{{ path('leaderboard') }}" class="lbl no-underline hover:text-ink-strong" data-testid="back-to-leaderboard">‹ Classement</a>
        {% endblock %}
        {% block meta %}
            <span data-testid="profile-rank">#{{ entry.rank }}</span> · joueur depuis {{ profile.createdAt|date('m/Y') }}
        {% endblock %}
        {% block aside %}
            <div class="panel hot flex flex-col gap-3 p-4 md:w-[320px] md:p-[18px]" data-testid="between-us">
                <span class="lbl text-ink">Entre vous deux</span>
                <span class="text-ink" data-testid="between-us-theirs">
                    <strong class="d text-[22px] text-ink-strong">{{ match.theyHaveForMe }}</strong>
                    carte{{ match.theyHaveForMe > 1 ? 's' }} de {{ profile.username }} te manque{{ match.theyHaveForMe > 1 ? 'nt' }}
                </span>
                <span class="text-ink" data-testid="between-us-mine">
                    <strong class="d text-[22px] text-ink-strong">{{ match.iHaveForThem }}</strong>
                    de tes doublons lui manque{{ match.iHaveForThem > 1 ? 'nt' }}
                </span>
                {% if feature_enabled('trades') %}
                    <a href="{{ path('trades_compose', { discordId: profile.discordId }) }}" class="btn btn-p btn-w" data-testid="propose-trade">⇄ Proposer un échange</a>
                {% endif %}
                <a href="{{ path('collection') }}" class="lbl self-start hover:text-ink-strong" data-testid="collection-link">◈ Ma collection</a>
            </div>
        {% endblock %}
    {% endembed %}

    <div class="wrap flex flex-col gap-10 pb-24 pt-6 md:pt-8">
        {{ include('parts/ui/_universe_strip.html.twig', {
            strip: strip,
            currentExtension: currentExtension,
            route: 'leaderboard_player',
            routeParams: { discordId: profile.discordId },
            owned: comparison.owned,
            total: comparison.total,
            percentage: comparison.completionPct,
            title: 'Sa collection par univers',
        }) }}

        {{ component('MarketBoard', { sellerId: profile.discordId }) }}

        {# ------------------------------------- Collection comparée par univers #}
        <section aria-labelledby="cmp" class="flex flex-col gap-4" data-controller="profile-filter">
            <div class="flex flex-wrap items-center gap-3">
                <h2 id="cmp" class="h2 mr-3">Vos collections</h2>
                {% if visible.total > 0 %}
                    <div role="group" aria-label="Comparer" class="flex flex-wrap gap-1.5" data-testid="profile-filters">
                        {% for filter in [
                            { state: 'all', label: 'Tout', count: visible.total, hint: 'Face cachée = tu ne l\'as pas : seule sa rareté est visible. ◈ = ' ~ profile.username ~ ' l\'a, toi non.' },
                            { state: 'profile-only', label: 'Seulement ' ~ shortName, count: visible.profileOnly, hint: 'Ces cartes, ' ~ profile.username ~ ' les a et toi non : seule leur rareté est visible.' },
                            { state: 'visitor-only', label: 'Seulement toi', count: visible.visitorOnly, hint: 'Ces cartes, tu les as et ' ~ profile.username ~ ' non.' },
                            { state: 'common', label: 'En commun', count: visible.common, hint: 'Ces cartes, vous les avez tous les deux.' },
                            { state: 'missing-both', label: 'Aucun de vous deux', count: visible.missingBoth, hint: 'Ces cartes, aucun de vous deux ne les a encore.' },
                        ] %}
                            {# un filtre à 0 n'a rien à montrer : il reste lisible mais inactif #}
                            <button type="button"
                                    class="seg{{ loop.first ? ' on' }}"
                                    data-state="{{ filter.state }}"
                                    data-hint="{{ filter.hint }}"
                                    data-profile-filter-target="button"
                                    data-action="profile-filter#select"
                                    aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                    {{ filter.count == 0 and not loop.first ? 'disabled' }}>
                                {{ filter.label }} · {{ filter.count }}
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if visible.total > 0 %}
                <p class="muted m-0 text-[13px]" data-testid="masking-hint" data-profile-filter-target="hint">
                    Face cachée = tu ne l'as pas : seule sa rareté est visible. ◈ = {{ profile.username }} l'a, toi non.
                </p>
            {% endif %}

            {% if comparison.owned == 0 %}
                <div class="panel px-8 py-10 text-center" data-testid="empty-state">
                    <p class="h2">Collection vide.</p>
                    <p class="muted mt-2 text-sm">Ce joueur n'a encore aucune carte.</p>
                </div>
            {% endif %}

            {# annonce le résultat du filtrage aux lecteurs d'écran #}
            <p class="sr" aria-live="polite" data-profile-filter-target="status"></p>

            {% for universe in visible.universes %}
                <div class="flex flex-col gap-3.5 pt-2" data-profile-filter-target="universe" data-testid="profile-universe">
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                        <h3 class="d up text-lg text-ink-strong">
                            <a href="{{ path('universes_show', { slug: universe.extension.slug }) }}" class="text-ink-strong no-underline hover:text-primary">{{ universe.extension.name }}</a>
                        </h3>
                        <span class="lbl"
                              data-profile-filter-target="count"
                              data-total="{{ universe.total }}"
                              data-testid="universe-count">
                            {{ universe.total }} carte{{ universe.total > 1 ? 's' }}
                        </span>
                        {# compteurs du catalogue complet : estompés dès qu'un filtre restreint la grille #}
                        <span class="muted flex flex-wrap gap-x-4 gap-y-1 text-[13px] transition-opacity"
                              data-profile-filter-target="counters"
                              data-testid="universe-compare">
                            <span>{{ universe.common }} en commun</span>
                            <span>{{ universe.profileOnly }} seulement {{ profile.username }}</span>
                            <span>{{ universe.visitorOnly }} seulement toi</span>
                            <span>{{ universe.missingBoth }} manquante{{ universe.missingBoth > 1 ? 's' }} aux deux</span>
                        </span>
                    </div>

                    <div class="set-grid set-grid--dense" data-testid="profile-grid">
                        {% for item in universe.cards %}
                            {% set state = item.state.value %}
                                {% if state == 'common' %}
                                    {{ include('parts/ui/_card_cell.html.twig', {
                                        card: item.card,
                                        quantity: item.profileCard.quantity,
                                        holoQuantity: item.profileCard.holoQuantity,
                                        holo: item.profileCard.holoQuantity > 0,
                                        interactive: true,
                                        testid: 'profile-tile',
                                        state: state,
                                        attrs: { 'data-profile-filter-target': 'tile' },
                                    }, with_context = false) }}
                                {% elseif state == 'visitor-only' %}
                                    {{ include('parts/ui/_card_cell.html.twig', {
                                        card: item.card,
                                        interactive: true,
                                        artClass: 'opacity-50 grayscale',
                                        badge: { text: '✕ Lui manque', testid: 'chip-wanted' },
                                        testid: 'profile-tile',
                                        state: state,
                                        attrs: { 'data-profile-filter-target': 'tile' },
                                    }, with_context = false) }}
                                {% else %}
                                    {# carte qu'il a et pas toi, ou que personne n'a : dos de carte, rareté seule #}
                                    {{ include('parts/ui/_card_cell.html.twig', {
                                        card: null,
                                        rarity: item.card.rarity.value,
                                        unique: item.card.isUnique,
                                        maskedLabel: state == 'profile-only' ? 'Carte à trouver' : 'Aucun de vous deux',
                                        artClass: state == 'missing-both' ? 'opacity-50' : 'ring-1 ring-primary/60',
                                        badge: state == 'profile-only' ? { text: '◈ Sa collection', class: 'chip-fill', testid: 'chip-owned' } : null,
                                        testid: 'profile-tile',
                                        state: state,
                                        attrs: { 'data-profile-filter-target': 'tile' },
                                    }, with_context = false) }}
                                {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            {# filtre qui ne ramène rien : sans ça la page tombe dans le vide #}
            <div class="panel px-8 py-10 text-center"
                 data-profile-filter-target="empty"
                 data-testid="filter-empty"
                 hidden>
                <p class="h2">Rien dans cet état.</p>
                <p class="muted mt-2 text-sm">Choisis un autre filtre.</p>
            </div>
        </section>
    </div>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Classement
{% endblock %}

{% block body %}
    <main>
    {% set tradesOn = feature_enabled('trades') %}
    {% set rankColors = { 1: 'var(--soon)', 2: '#e3e6ec', 3: '#e8a46a' } %}

    {% embed 'parts/ui/_page_header.html.twig' with {
        eyebrow: 'Social',
        title: 'Les collectionneurs',
        lead: sort.lead ~ ' Les uniques 1/1 restent secrètes : on affiche combien, jamais lesquelles.',
    } %}
        {% block actions %}
            <nav aria-label="Classer par" class="flex flex-wrap gap-1.5" data-testid="leaderboard-sorts">
                {% for option in sorts %}
                    {% set active = option == sort %}
                    <a href="{{ path('leaderboard', option.value == 'completion' ? {} : { tri: option.value }) }}"
                       class="seg{{ active ? ' on' }}"{{ active ? ' aria-current="true"' }}
                       data-sort="{{ option.value }}">{{ option.label }}</a>
                {% endfor %}
            </nav>
        {% endblock %}
    {% endembed %}

    <div class="wrap pb-24 pt-6 md:pt-8">
        <div class="panel" data-testid="leaderboard">
            {% if entries is empty %}
                <p class="muted px-8 py-16 text-center">Aucun joueur pour le moment.</p>
            {% else %}
                <table class="tbl lb-table">
                    <caption class="sr">Classement des joueurs par {{ sort.label|lower }}</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="w-[60px]">#</th>
                            <th scope="col">Joueur</th>
                            <th scope="col" class="lb-table__completion"{{ sort.value == 'completion' ? ' aria-sort="descending"' }}><span class="max-md:sr-only">Complétion</span><span class="md:hidden" aria-hidden="true">%</span></th>
                            <th scope="col" class="num max-md:hidden">Total</th>
                            <th scope="col" class="num max-md:hidden"{{ sort.value == 'holos' ? ' aria-sort="descending"' }}>Holos</th>
                            <th scope="col" class="num max-md:hidden">Uniques</th>
                            <th scope="col" class="num max-md:hidden"{{ sort.value == 'packs' ? ' aria-sort="descending"' }}>Packs</th>
                            {% if tradesOn %}<th scope="col" class="w-[170px] max-lg:hidden"><span class="sr">Actions</span></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in entries %}
                            {% set isMe = entry.user.discordId == currentUser.discordId %}
                            <tr class="{{ isMe ? 'me' }}" data-testid="leaderboard-row"{{ isMe ? ' data-current="true" aria-current="true"' }}>
                                <td class="d text-[22px]" style="color: {{ rankColors[entry.rank] ?? 'var(--text-muted)' }};">{{ '%02d'|format(entry.rank) }}</td>
                                <td>
                                    <span class="flex min-w-0 items-center gap-3">
                                        <span class="av oct-s h-9 w-9 shrink-0{{ isMe ? '' : ' bg-[#6d2bb0]' }}" aria-hidden="true">{{ entry.user.username|first|upper }}</span>
                                        <span class="flex min-w-0 flex-col">
                                            <span class="flex min-w-0 items-center gap-1.5">
                                                <a href="{{ path('leaderboard_player', { discordId: entry.user.discordId }) }}"
                                                   class="truncate font-semibold text-ink-strong hover:text-primary"
                                                   data-testid="leaderboard-player-link">{{ entry.user.username }}</a>
                                                {% if isMe %}<span class="chip chip-fill">toi</span>{% endif %}
                                            </span>
                                            <span class="lbl md:hidden" data-testid="leaderboard-summary">
                                                <span class="text-magenta">✦</span> {{ entry.holoCards }} · <span class="r-s">★</span> {{ entry.uniqueCards }} · {{ entry.openedBoosters }} pack{{ entry.openedBoosters > 1 ? 's' }}
                                            </span>
                                        </span>
                                    </span>
                                </td>
                                <td class="lb-table__completion">
                                    <span class="flex flex-col gap-1.5">
                                        <span class="flex justify-between gap-2">
                                            <span class="mono text-xs max-md:hidden">{{ entry.distinctCards }} / {{ entry.catalogueSize }}</span>
                                            <span class="mono text-xs text-ink-strong">{{ entry.completionPct }} %</span>
                                        </span>
                                        <span class="bar" aria-hidden="true"><i style="width: {{ entry.completionPct }}%"></i></span>
                                    </span>
                                </td>
                                <td class="num max-md:hidden">{{ entry.totalCards }}</td>
                                <td class="num max-md:hidden {{ entry.holoCards > 0 ? 'text-magenta' : 'muted' }}">✦ {{ entry.holoCards }}</td>
                                <td class="num max-md:hidden {{ entry.uniqueCards > 0 ? 'r-s' : 'muted' }}">★ {{ entry.uniqueCards }}</td>
                                <td class="num max-md:hidden">{{ entry.openedBoosters }}</td>
                                {% if tradesOn %}
                                    <td class="max-lg:hidden">
                                        {% if not isMe %}
                                            <a href="{{ path('trades_compose', { discordId: entry.user.discordId }) }}" class="btn btn-g btn-s whitespace-nowrap" data-testid="leaderboard-trade">⇄ Échanger</a>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    </main>
{% endblock %}

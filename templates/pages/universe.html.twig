{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — {{ extension.name }}
{% endblock %}

{% block body %}
    {% set ownedCount = ownedByCardId|length %}
    {% set totalCount = catalog|length %}
    {% set missingCount = totalCount - ownedCount %}
    {% set percentage = totalCount > 0 ? ((ownedCount / totalCount) * 100)|round(0, 'floor') : 0 %}
    {% set banners = extension.banners|filter(banner => banner.imageName) %}
    {% set packsInStock = 0 %}
    {% set openable = null %}
    {% set claimable = false %}
    {% for booster in boosters %}
        {% set owned = ownedBoosterCounts[booster.id ~ '']|default(0) %}
        {% set packsInStock = packsInStock + owned %}
        {% if owned > 0 and openable is null %}{% set openable = booster %}{% endif %}
        {% if booster.claimable %}{% set claimable = true %}{% endif %}
    {% endfor %}

    <main>
    {# --------------------------------------------- Héro / bannières #}
    <section class="uni-hero" data-controller="carousel">
        <div class="uni-hero__media scrollbar-hidden snap-x snap-mandatory overflow-x-auto"
             data-carousel-target="track"
             data-action="wheel->carousel#wheel:!passive"
             data-testid="banner-carousel">
            {% if banners|length > 0 %}
                {% for banner in banners %}
                    <div class="relative h-full w-full shrink-0 snap-center">
                        <img src="{{ vich_uploader_asset(banner) }}" alt=""
                             class="absolute inset-0 h-full w-full object-cover" {{ not loop.first ? 'loading="lazy"' }}>
                    </div>
                {% endfor %}
            {% else %}
                {# pas de bannière uploadée : image extension → artwork de la carte la plus rare → gradient seul #}
                <div class="relative h-full w-full shrink-0">
                    <div class="absolute inset-0 bg-gradient-to-br from-[#2a0f44] via-[#7a1f9c] to-magenta opacity-60" aria-hidden="true"></div>
                    {% set fallbackUrl = extension.imageName
                        ? vich_uploader_asset(extension)
                        : (coverImage ? asset('uploads/cards/' ~ coverImage)) %}
                    {% if fallbackUrl %}
                        <img src="{{ fallbackUrl }}" alt="" onerror="this.remove()"
                             class="absolute inset-0 h-full w-full object-cover object-top">
                    {% endif %}
                </div>
            {% endif %}
        </div>
        <div class="uni-hero__shade" aria-hidden="true"></div>

        <div class="wrap uni-hero__content">
            <div class="flex max-w-[760px] flex-col gap-3.5">
                <a href="{{ path('universes') }}" class="lbl no-underline hover:text-ink-strong">‹ Tous les univers</a>
                <h1 class="h1">{{ extension.name }}</h1>
                {% if extension.description %}<p class="lead text-ink">{{ extension.description }}</p>{% endif %}

                <div class="grid gap-3 pt-1.5 sm:grid-cols-2">
                    <div class="panel flex flex-col gap-2 bg-surface/90 p-3.5" data-testid="universe-stats">
                        <span class="flex items-baseline justify-between gap-2"><span class="lbl">Ta complétion</span><span class="mono text-ink-strong">{{ ownedCount }} / {{ totalCount }} · {{ percentage }} %</span></span>
                        <span class="bar" aria-hidden="true"><i style="width: {{ percentage }}%"></i></span>
                        <span class="text-[13px] {{ missingCount > 0 ? 'text-magenta' : 'text-live' }}">
                            {{ missingCount > 0 ? 'il en manque ' ~ missingCount : (totalCount > 0 ? '✓ univers complet' : 'aucune carte publiée') }}
                        </span>
                    </div>
                    {% if reward %}
                        {# la récompense ne compte que les cartes tirées par le joueur lui-même #}
                        {% set rewardPct = reward.total > 0 ? ((reward.drawn / reward.total) * 100)|round(0, 'floor') : 0 %}
                        <div class="panel flex flex-col gap-2 bg-surface/90 p-3.5" data-testid="universe-reward">
                            {% if reward.rewarded %}
                                <span class="lbl text-soon">★ Récompense de complétion obtenue</span>
                                <span class="text-[13px] text-ink-muted">Tu as déjà touché la récompense de cet univers.</span>
                            {% else %}
                                <span class="flex items-baseline justify-between gap-2"><span class="lbl">Récompense · {{ reward.amount }} YLC</span><span class="mono text-ink-strong">{{ reward.drawn }} / {{ reward.total }}</span></span>
                                <span class="bar" aria-hidden="true"><i style="width: {{ rewardPct }}%; background: var(--soon)"></i></span>
                                <span class="text-[13px] text-ink-muted">cartes tirées par toi — celles reçues par échange ou achetées ne comptent pas</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    {% if boosters|length > 0 %}
                        <span class="lbl">▣ {{ boosters|length }} booster{{ boosters|length > 1 ? 's' }}</span>
                    {% endif %}
                    {% if uniquesTotal > 0 %}
                        <span class="lbl" data-testid="uniques-status">
                            ◆ Unique{{ uniquesTotal > 1 ? 's' }} 1/1 :
                            {% if uniquesClaimed == uniquesTotal %}
                                <span class="text-magenta">{{ uniquesClaimed }}/{{ uniquesTotal }} droppée{{ uniquesTotal > 1 ? 's' }}</span>
                            {% else %}
                                <span class="text-live">{{ uniquesTotal - uniquesClaimed }}/{{ uniquesTotal }} encore dans le pool</span>
                            {% endif %}
                        </span>
                    {% endif %}
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-1.5">
                    {% if openable and totalCount > 0 %}
                        <a class="btn btn-p max-md:w-full" href="{{ path('booster_open', { id: openable.id }) }}" data-testid="universe-open">Ouvrir · {{ packsInStock }} en stock</a>
                    {% endif %}
                    {% if claimable and totalCount > 0 and remaining_booster_claims() > 0 %}
                        <a class="btn btn-g max-md:w-full" href="{{ path('boosters') }}" data-testid="universe-claim">Récupérer un pack gratuit</a>
                    {% endif %}
                    {% if wishlistEnabled and (watching or ownedCount < totalCount) %}
                        {{ include('parts/_wish_button.html.twig', {
                            variant: 'universe',
                            url: path('wishlist_universe_toggle', { slug: extension.slug }),
                            active: watching,
                        }, with_context = false) }}
                    {% endif %}
                    <a href="{{ path('collection', { slug: extension.slug }) }}" class="lbl hover:text-ink-strong" data-testid="collection-link">◈ Voir dans ma collection</a>
                </div>
            </div>
        </div>

        {% if banners|length > 1 %}
            <div class="uni-hero__nav flex gap-1.5">
                <button type="button" data-action="carousel#prev" aria-label="Bannière précédente" class="ib">◂</button>
                <button type="button" data-action="carousel#next" aria-label="Bannière suivante" class="ib">▸</button>
            </div>
        {% endif %}
    </section>

    <div class="wrap flex flex-col gap-5 pb-24 pt-8">
        {# ------------------------------------------------------------ Set #}
        <div class="flex flex-wrap items-center gap-3">
            <h2 class="h2 mr-3">Le set · {{ totalCount }} carte{{ totalCount > 1 ? 's' }}</h2>
            <nav aria-label="Filtrer par possession" class="flex flex-wrap gap-1.5">
                {% for key, label in { toutes: 'Toutes', possedees: 'Possédées · ' ~ ownedCount, manquantes: 'Manquantes · ' ~ missingCount } %}
                    <a href="{{ path('universes_show', key == 'toutes' ? { slug: extension.slug } : { slug: extension.slug, filtre: key }) }}"
                       class="seg{{ filter == key ? ' on' }}"{{ filter == key ? ' aria-current="true"' }}
                       data-testid="set-filter-{{ key }}">{{ label }}</a>
                {% endfor %}
            </nav>
            <span class="lbl md:ml-auto">Tri : rareté ↓</span>
        </div>

        <div class="set-grid" data-testid="set-grid">
            {% for card in catalog %}
                {% set userCard = ownedByCardId[card.id ~ ''] ?? null %}
                {% if filter == 'toutes' or (filter == 'possedees' and userCard) or (filter == 'manquantes' and not userCard) %}
                    {% if userCard %}
                        {{ include('parts/ui/_card_cell.html.twig', {
                            card: card,
                            quantity: userCard.quantity,
                            holoQuantity: userCard.holoQuantity,
                            holo: userCard.holoQuantity > 0,
                            interactive: true,
                            wishUrl: wishlistEnabled ? path('wishlist_card_toggle', { id: card.id }) : null,
                            wished: wishedIds[card.id ~ ''] is defined,
                        }, with_context = false) }}
                    {% else %}
                        {# carte manquante : dos de carte, rareté seule (jamais nom, artwork ni id) #}
                        {{ include('parts/ui/_card_cell.html.twig', { card: null, rarity: card.rarity.value }, with_context = false) }}
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
        {% if filter != 'toutes' and (filter == 'possedees' ? ownedCount : missingCount) == 0 %}
            <p class="panel px-6 py-8 text-center text-sm text-ink-muted">
                {{ filter == 'possedees' ? 'Tu n\'as encore aucune carte de cet univers.' : 'Rien ne manque : univers complet !' }}
            </p>
        {% endif %}

        {# ------------------------------------------------------- Boosters #}
        {% if boosters|length > 0 %}
            <section aria-labelledby="u-boosters" class="flex flex-col gap-4 pt-10">
                <h2 id="u-boosters" class="h2">Boosters de l'univers</h2>
                <div class="pack-grid" data-testid="universe-boosters">
                    {% for booster in boosters %}
                        {% set owned = ownedBoosterCounts[booster.id ~ '']|default(0) %}
                        <article class="pack{{ owned > 0 ? ' pack--has' }}">
                            <div class="flex items-center justify-between gap-2">
                                <span class="lbl min-w-0 truncate text-ink-strong">{{ booster.displayName }}</span>
                                <span class="lbl shrink-0 px-2{{ owned > 0 ? ' bg-primary text-ink-strong' }}">{{ owned }} en stock</span>
                            </div>
                            <div class="pack__art">
                                <canvas width="840" height="1300"
                                        data-controller="pack-front"
                                        data-pack-front-bg-url-value="{{ booster.imageName ? vich_uploader_asset(booster) : (booster.extension.imageName ? vich_uploader_asset(booster.extension) : '') }}"
                                        data-pack-front-fallback-url-value="{{ asset('images/ytcg_background.png') }}"
                                        data-pack-front-logo-url-value="{{ asset('images/ytcg_logo.png') }}"
                                        data-pack-front-name-value="{{ booster.displayName }}"
                                        data-pack-front-count-value="{{ booster.cardCount }}"
                                        data-pack-front-plain-value="{{ booster.imageName ? 'true' : 'false' }}"
                                        aria-label="Pack {{ booster.displayName }}" role="img"
                                        class="pack__canvas"></canvas>
                            </div>
                            {% if owned > 0 and totalCount > 0 %}
                                <a href="{{ path('booster_open', { id: booster.id }) }}" class="btn btn-p btn-w">Ouvrir · {{ owned }}</a>
                            {% elseif booster.claimable %}
                                <a href="{{ path('boosters') }}" class="btn btn-g btn-w">Récupérer sur le hub</a>
                            {% endif %}
                            {% if not booster.claimable %}
                                <span class="text-xs text-soon" title="Ce pack se gagne en event ou via un code — il n'est pas récupérable.">✕ Non récupérable</span>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
    </main>
{% endblock %}

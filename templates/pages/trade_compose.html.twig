{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Offre à {{ counterpart.username }}
{% endblock %}

{% block body %}
    <main>
        <div class="ph" data-testid="page-header">
            <div class="wrap flex flex-col gap-2 pb-5 pt-4 md:gap-2.5 md:pb-6 md:pt-8">
                <a href="{{ path('trades_new') }}" class="lbl no-underline hover:text-ink-strong" data-testid="change-player">‹ Changer de joueur</a>
                <h1 class="h1 composer-title">Offre à <span class="grad">{{ counterpart.username }}</span></h1>
                <p class="lead max-md:hidden">
                    Choisis ce que tu donnes et ce que tu demandes. Tes cartes proposées sont réservées tant que l'offre est en attente.
                </p>
            </div>
        </div>

        {% if not hasSomethingToOffer and not counterpartHasCards %}
            <div class="wrap py-10">
                <div class="panel px-8 py-16 text-center" data-testid="nothing-to-trade">
                    <p class="d up text-lg text-ink-strong">Rien à échanger.</p>
                    <p class="muted mt-3 text-sm">Aucun de vous deux n'a de carte disponible pour le moment.</p>
                </div>
            </div>
        {% else %}
            {{ component('TradeComposer', { counterpartId: counterpart.discordId }) }}
        {% endif %}
    </main>
{% endblock %}

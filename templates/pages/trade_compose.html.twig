{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Offre à {{ counterpart.username }}
{% endblock %}

{% block body %}
    <main>
        <section class="relative border-b border-hairline px-6 py-10 lg:px-12">
            <div class="glow-ambient" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl">
                <p class="eyebrow">04 / Échanges</p>
                <h1 class="mt-2 font-display text-4xl font-bold uppercase tracking-[-0.04em] text-ink-strong md:text-5xl">
                    Offre à <span class="text-primary">{{ counterpart.username }}</span>
                </h1>
                <p class="mt-2 max-w-xl text-sm text-ink-muted">
                    Compose ton offre des deux côtés. Tant qu'elle est en attente, les exemplaires proposés
                    sont réservés : impossible de les engager ailleurs.
                </p>
            </div>
        </section>

        <section class="px-6 py-10 lg:px-12">
            <div class="mx-auto max-w-7xl">
                {% if not hasSomethingToOffer and not counterpartHasCards %}
                    <div class="border border-dashed border-hairline px-8 py-16 text-center text-ink-dim">
                        <p class="font-display text-lg font-bold uppercase tracking-[.15em]">Rien à échanger.</p>
                        <p class="mt-3 text-sm">Aucun de vous deux n'a de carte disponible pour le moment.</p>
                    </div>
                {% else %}
                    {{ component('TradeComposer', { counterpartId: counterpart.discordId }) }}
                {% endif %}

                <a href="{{ path('trades_new') }}" class="btn-ghost mt-8 inline-block">◂ Changer de joueur</a>
            </div>
        </section>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Offre à {{ counterpart.username }}
{% endblock %}

{% block body %}
    <main>
        <section class="relative border-b border-hairline px-6 py-7 md:py-10 lg:px-12">
            <div class="glow-ambient" aria-hidden="true"></div>
            <div class="relative mx-auto flex max-w-7xl flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-6">
                <div>
                    <p class="eyebrow">04 / Échanges</p>
                    <h1 class="mt-2 font-display text-4xl font-bold uppercase tracking-[-0.04em] text-ink-strong md:text-5xl">
                        Offre à <span class="text-primary">{{ counterpart.username }}</span>
                    </h1>
                    <p class="mt-2 hidden max-w-xl text-sm text-ink-muted sm:block">
                        Choisis ce que tu donnes et ce que tu demandes, normales et holos à part.
                        Tant que l'offre est en attente, tes exemplaires proposés sont réservés.
                    </p>
                </div>
                <a href="{{ path('trades_new') }}" class="btn-ghost shrink-0 self-start !px-4 !py-2 !text-xs md:self-auto md:!px-6 md:!py-3.5 md:!text-sm">◂ Changer de joueur</a>
            </div>
        </section>

        {% if not hasSomethingToOffer and not counterpartHasCards %}
            <section class="px-6 py-10 lg:px-12">
                <div class="mx-auto max-w-7xl border border-dashed border-hairline px-8 py-16 text-center text-ink-dim">
                    <p class="font-display text-lg font-bold uppercase tracking-[.15em]">Rien à échanger.</p>
                    <p class="mt-3 text-sm">Aucun de vous deux n'a de carte disponible pour le moment.</p>
                </div>
            </section>
        {% else %}
            {{ component('TradeComposer', { counterpartId: counterpart.discordId }) }}
        {% endif %}
    </main>
{% endblock %}

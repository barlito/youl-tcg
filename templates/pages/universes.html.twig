{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Univers
{% endblock %}

{% block body %}
    {% embed 'parts/ui/_page_header.html.twig' with {
        eyebrow: 'Jouer',
        title: 'Les univers',
        lead: 'Chaque univers a ses cartes, ses raretés et ses uniques.'
            ~ (rewardsOn ? ' Complète-en un avec des cartes tirées toi-même pour gagner des Youl Coin.' : ''),
        testid: 'universes-header',
    } %}
        {% block actions %}
            <form method="get" action="{{ path('universes') }}" role="search" class="flex w-full items-center gap-2 md:w-auto">
                <label for="universe-search" class="sr">Chercher un univers</label>
                <input id="universe-search" class="field h-10 w-full md:w-60" type="search" name="q" value="{{ search }}"
                       placeholder="Chercher un univers…" autocomplete="off" data-testid="universe-search">
                {% if sort != 'presque' %}<input type="hidden" name="tri" value="{{ sort }}">{% endif %}
            </form>
            <nav aria-label="Trier les univers" class="flex flex-wrap gap-1.5">
                {% for key, label in { presque: 'Presque finis', recents: 'Plus récents', az: 'A → Z' } %}
                    <a href="{{ path('universes', (key == 'presque' ? {} : { tri: key })|merge(search ? { q: search } : {})) }}"
                       class="seg{{ sort == key ? ' on' }}"{{ sort == key ? ' aria-current="true"' }}
                       data-testid="universe-sort-{{ key }}">{{ label }}</a>
                {% endfor %}
            </nav>
        {% endblock %}
    {% endembed %}

    <main class="wrap flex flex-col gap-10 pb-24 pt-8" data-testid="universes-grid">
        {% if search and toComplete is empty and completed is empty %}
            <p class="panel px-6 py-10 text-center text-ink-muted" data-testid="universe-search-empty">
                Aucun univers ne correspond à « {{ search }} ».
                <a href="{{ path('universes', sort != 'presque' ? { tri: sort } : {}) }}" class="tl ml-2">Tout afficher</a>
            </p>
        {% endif %}

        {# ------------------------------------------------------ À compléter #}
        {% if toComplete is not empty %}
            <section aria-labelledby="u-todo" class="flex flex-col gap-3.5" data-testid="universes-todo">
                <div class="flex items-baseline gap-3">
                    <h2 id="u-todo" class="h2">À compléter</h2>
                    <span class="muted">{{ toComplete|length }} univers</span>
                </div>
                {# les 4 premiers en grand, le reste en liste compacte #}
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    {% for universe in toComplete|slice(0, 4) %}
                        {% set extension = universe.extension %}
                        {% embed 'parts/ui/_universe_tile.html.twig' with {
                            extension: extension,
                            coverUrl: extension.imageName ? vich_uploader_asset(extension) : (universe.coverImage ? asset('uploads/cards/' ~ universe.coverImage)),
                            class: 'h-[230px] md:h-[280px]',
                            universe: universe,
                        } only %}
                            {% block top %}
                                {# live = at least one claimable booster right now #}
                                {% if universe.hasClaimableBooster %}<span class="chip chip-live bg-bg/80" data-testid="live-badge">● live</span>{% endif %}
                            {% endblock %}
                            {% block content %}
                                {% if extension.description %}<span class="line-clamp-2 text-[13px] text-ink">{{ extension.description }}</span>{% endif %}
                                {{ include('parts/_universe_progress.html.twig', { universe: universe }, with_context = false) }}
                            {% endblock %}
                        {% endembed %}
                    {% endfor %}
                </div>
                {% if toComplete|length > 4 %}
                    <div class="panel universe-list">
                        {% for universe in toComplete|slice(4) %}
                            {% set extension = universe.extension %}
                            <a href="{{ path('universes_show', { slug: extension.slug }) }}" class="universe-list__item" data-testid="universe-tile">
                                <span class="flex items-baseline justify-between gap-3">
                                    <span class="d up min-w-0 truncate text-ink-strong">{{ extension.name }}</span>
                                    <span class="mono shrink-0 text-ink-strong">{{ universe.percentage }} %</span>
                                </span>
                                {{ include('parts/_universe_progress.html.twig', { universe: universe, compact: true }, with_context = false) }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        {% endif %}

        {# -------------------------------------------------------- Complétés #}
        {% if completed is not empty %}
            <section aria-labelledby="u-done" class="flex flex-col gap-3.5" data-testid="universes-done">
                <div class="flex flex-wrap items-baseline gap-3">
                    <h2 id="u-done" class="h2">Complétés <span class="text-live">✓</span></h2>
                    <span class="muted">
                        {{ completed|length }} univers
                        {%- if rewardsOn and coinsEarned > 0 %} · {{ coinsEarned|number_format(0, ',', ' ') }} YLC gagnés{% endif %}
                    </span>
                </div>
                <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                    {% for universe in completed %}
                        {% embed 'parts/ui/_universe_tile.html.twig' with {
                            extension: universe.extension,
                            coverUrl: universe.extension.imageName ? vich_uploader_asset(universe.extension) : (universe.coverImage ? asset('uploads/cards/' ~ universe.coverImage)),
                            class: 'h-[150px] md:h-[180px]',
                            nameClass: 'text-base md:text-xl',
                            universe: universe,
                        } only %}
                            {% block content %}
                                <span class="lbl text-live">✓ {{ universe.owned }} / {{ universe.total }} · {{ universe.percentage }} %</span>
                            {% endblock %}
                        {% endembed %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# ---------------------------------------------------------- Bientôt #}
        {% if upcoming %}
            <section aria-labelledby="u-soon" class="flex flex-col gap-3.5">
                <h2 id="u-soon" class="h2">Bientôt</h2>
                <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                    {{ include('parts/_soon_tile.html.twig', { upcoming, upcomingCover, class: 'h-[150px] md:h-[180px]' }, with_context = false) }}
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}

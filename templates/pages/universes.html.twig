{% extends 'base.html.twig' %}

{% block title %}
    YOUL TCG — Univers
{% endblock %}

{% block body %}
    <main>
        {# ------------------------------------------------------------ Hero #}
        <section class="relative border-b border-hairline px-6 py-10 lg:px-12">
            <div class="glow-ambient" aria-hidden="true"></div>
            <div class="relative mx-auto flex max-w-7xl flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="eyebrow">02 / Univers</p>
                    <h1 class="mt-2 font-display text-4xl font-bold uppercase tracking-[-0.04em] text-ink-strong md:text-5xl">
                        Les <span class="text-primary">univers</span>.
                    </h1>
                    <p class="mt-2 max-w-md text-sm text-ink-muted">
                        Chaque univers est une extension : ses cartes, ses raretés, ses uniques.
                        Explore le pokédex de chacun et traque ce qui te manque.
                    </p>
                </div>
                <span class="font-mono text-xs text-ink-dim">{{ '%02d'|format(universes|length) }} UNIVERS LIVE</span>
            </div>
        </section>

        {# ----------------------------------------------------------- Grille #}
        <section class="px-6 pb-24 pt-10 lg:px-12">
            <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-3" data-testid="universes-grid">
                {% for universe in universes %}
                    {% set extension = universe.extension %}
                    <a href="{{ path('universes_show', { slug: extension.slug }) }}"
                       class="group relative h-72 overflow-hidden border border-hairline bg-surface transition-colors hover:border-primary/60">
                        <div class="absolute inset-0 bg-gradient-to-br from-[#2a0f44] via-[#7a1f9c] to-magenta opacity-50" aria-hidden="true"></div>
                        {% set coverUrl = extension.imageName
                            ? vich_uploader_asset(extension)
                            : (universe.coverImage ? asset('images/cards/' ~ universe.coverImage)) %}
                        {% if coverUrl %}
                            <img src="{{ coverUrl }}" alt="" loading="lazy" onerror="this.remove()"
                                 class="absolute inset-0 h-full w-full object-cover object-top opacity-60 transition duration-300 group-hover:scale-[1.03] group-hover:opacity-80">
                        {% endif %}
                        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/95" aria-hidden="true"></div>

                        <div class="absolute left-4 right-4 top-4 flex items-center justify-between">
                            <span class="chip-mono bg-black/80 px-2 py-0.5 font-bold text-live">● LIVE</span>
                            {% if extension.code %}
                                <span class="chip-mono text-white">{{ extension.code }}</span>
                            {% endif %}
                        </div>

                        <div class="absolute bottom-4 left-4 right-4">
                            <h2 class="font-display text-2xl font-bold uppercase leading-[.95] tracking-[-0.03em] text-white">
                                {{ extension.name }}
                            </h2>
                            <p class="mt-1.5 text-[11px] text-white/80">
                                {{ extension.description|slice(0, 90) }}{{ extension.description|length > 90 ? '…' }}
                            </p>
                            <div class="mt-3 border-t border-white/20 pt-2.5">
                                <div class="chip-mono flex justify-between text-white/90">
                                    <span>{{ universe.owned }}/{{ universe.total }} cartes</span>
                                    <span class="font-bold text-primary">{{ universe.percentage }}%</span>
                                </div>
                                <div class="mt-1.5 h-1 bg-white/15">
                                    <div class="h-full bg-gradient-to-r from-primary to-magenta" style="width: {{ universe.percentage }}%;"></div>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}

{%- set holo = holo|default(false) -%}
{#- lazy: opt-in for grid usages (collection / univers) — keep the default
    eager where the card is visible immediately (homepage, opening reveal) -#}
{%- set lazy = lazy|default(false) -%}
{%- set id = id|default(card.id) -%}
{%- set visual = card_visual(card) -%}
{#- CSS frame variant (cards/frame.css): resolved through the visual-config
    cascade (default 'youl', 'none' opts out); an explicit `frame` param
    (dev preview) wins over the cascade -#}
{%- set frame = frame|default(visual.frameVariant) -%}
{%- set frame = frame == 'none' ? null : frame -%}
{%- set styleVars = [] -%}
{%- if visual.maskUrl %}{% set styleVars = styleVars|merge(["--mask: url('#{visual.maskUrl}')"]) %}{% endif -%}
{%- if visual.foilUrl %}{% set styleVars = styleVars|merge(["--foil: url('#{visual.foilUrl}')"]) %}{% endif -%}
{%- if visual.foilSizeCss %}{% set styleVars = styleVars|merge(["--imgsize: #{visual.foilSizeCss}"]) %}{% endif -%}
{%- if visual.glow %}{% set styleVars = styleVars|merge(["--card-glow: #{visual.glow}"]) %}{% endif -%}
{%- if visual.borderColor %}{% set styleVars = styleVars|merge(["--card-border: #{visual.borderColor}"]) %}{% endif -%}
{%- if visual.nameFont %}{% set styleVars = styleVars|merge(["--frame-name-font: #{visual.nameFont.cssFamily}"]) %}{% endif -%}
{%- if visual.frameLineStart %}{% set styleVars = styleVars|merge(["--frame-line-1: #{visual.frameLineStart}"]) %}{% endif -%}
{%- if visual.frameLineEnd %}{% set styleVars = styleVars|merge(["--frame-line-2: #{visual.frameLineEnd}"]) %}{% endif -%}
{# holo rendering only exists through the presets: a card drawn holo whose
   cascade resolves no preset falls back to the basic recipe #}
{%- set holoClass = visual.holoEffect ? visual.holoEffect.cssClass : (holo ? 'holo--basic' : null) -%}
<div id="{{ id }}"
     class="card interactive{{ visual.hasMask ? ' masked' }}{{ holo ? ' holo' }}{{ card.isUnique ? ' unique' }}{{ frame ? ' framed' }}{{ visual.cssClass ? ' ' ~ visual.cssClass }}{{ holoClass ? ' ' ~ holoClass }}"
     data-rarity="{{ card.rarity.value }}"
     data-controller="card"
     {%- if styleVars is not empty %} style="{{ styleVars|join('; ') }}"{% endif %}>
    <div class="card__translater">
        <div class="card__rotator">
            {# real back face: shown mid-spin by the click-to-zoom flip
               (card__front is backface-hidden, so without it the card would
               blink out between 90° and 270°) #}
            <div class="card__back" aria-hidden="true">
                <img src="{{ asset('images/card-back.svg') }}" alt="" draggable="false">
            </div>
            <div class="card__front">
                <img src="{{ vich_uploader_asset(card) }}" alt="{{ card.name }}"{% if lazy %} loading="lazy"{% endif %} decoding="async" onerror="this.onerror=null;this.src='{{ asset('images/default_card.png') }}';">
                <div class="card__shine"></div>
                <div class="card__glare"></div>
                {#- the .card-frame__body wrappers carry the container-type (cqi
                    sizing): containment on the translateZ'd layers themselves
                    would flatten them under the holo, cf. frame.css -#}
                {%- if frame %}
                <div class="card__watermark card__watermark--{{ frame }}" aria-hidden="true">
                    <div class="card-frame__body"></div>
                </div>
                <div class="card__frame card__frame--{{ frame }}" aria-hidden="true">
                    <div class="card-frame__body">
                        <span class="card-frame__name">{{ card.name }}</span>
                        {%- if card.extension.logoName %}
                        <img class="card-frame__ext-logo" src="{{ vich_uploader_asset(card.extension, 'logoFile') }}" alt="{{ card.extension.name }}" draggable="false">
                        {%- else %}
                        <span class="card-frame__ext">{{ card.extension.name }}</span>
                        {%- endif %}
                        <span class="card-frame__rarity" aria-hidden="true"></span>
                    </div>
                </div>
                {% endif -%}
            </div>
        </div>
    </div>
</div>

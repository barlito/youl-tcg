{# re-rendered live whenever an offer of the reader moves (other player, other tab) #}
<div {{ attributes.defaults({'data-action': 'live-updates:trades-changed@window->live#$render'}) }}>
    {% set received = this.received %}
    {% set sent = this.sent %}
    {% set history = this.history %}
    {% set focused = this.focusedOffer %}
    {% set currentTab = this.currentTab %}
    {% set tabsHtml %}
        <div class="subnav trade-tabs" role="tablist" aria-label="Échanges" data-testid="trade-tabs">
            {{ _self.tab('received', 'Reçues', received|length, currentTab, true) }}
            {{ _self.tab('sent', 'Envoyées', sent|length, currentTab, false) }}
            {{ _self.tab('history', 'Historique', this.historyCount, currentTab, false) }}
        </div>
    {% endset %}
    <main>
        {% embed 'parts/ui/_page_header.html.twig' with {
            eyebrow: 'Social',
            title: 'Échanges',
            lead: 'Propose tes doublons contre ce qui te manque. Les cartes engagées dans une offre restent réservées jusqu\'à la réponse.',
        } %}
            {% block actions %}
                <a href="{{ path('trades_new') }}" class="btn btn-p max-md:w-full" data-testid="new-offer">Nouvelle offre</a>
            {% endblock %}
            {% block nav %}{{ tabsHtml }}{% endblock %}
        {% endembed %}

        <div class="wrap flex flex-col gap-6 pb-24 pt-6 md:pt-8">
            {% if error %}
                <div class="panel flash-msg flash-msg--err" role="alert" data-controller="reveal-message" data-reveal-message-key-value="{{ error }}" data-testid="trade-error">⚠ {{ error }}</div>
            {% elseif success %}
                <div class="panel flash-msg flash-msg--ok" role="status" data-controller="reveal-message" data-reveal-message-key-value="{{ success }}" data-testid="trade-success">⇄ {{ success }}</div>
            {% endif %}

            {# --------------------------------------------------------- Reçues #}
            <section id="trade-pane-received" role="tabpanel" aria-labelledby="trade-tab-received" class="trade-pane flex flex-col gap-6"
                     {{ currentTab != 'received' ? 'hidden' }}>
                {% if received is empty %}
                    {{ _self.empty('Aucune offre en attente. Tranquille.', 'no-received') }}
                {% else %}
                    <div class="flex flex-col gap-6" data-testid="received-offers">
                        {% for offer in received %}
                            {% set given = this.requestedView(offer) %}
                            {% set got = this.offeredView(offer) %}
                            {% set isConfirming = confirming == (offer.id ~ '') %}
                            <article class="panel hot trade-offer{{ isConfirming ? ' trade-offer--confirming' }}" data-testid="received-offer">
                                {{ _self.offer_header(offer.proposer, 'te propose un échange', offer) }}
                                {{ _self.offer_body(given, 'Tu donnes', got, 'Tu reçois', 'r-' ~ offer.id) }}
                                <div class="trade-offer__foot">
                                    {% if isConfirming %}
                                        <p class="muted flex-1 text-[13px]" data-testid="accept-confirmation">
                                            Les cartes changent de collection immédiatement, sans retour possible.
                                        </p>
                                        <div class="trade-offer__actions">
                                            <button type="button" class="btn btn-g btn-s"
                                                    data-action="live#action"
                                                    data-live-action-param="abortAccept"
                                                    data-testid="abort-accept">Pas encore</button>
                                            <button type="button" class="btn btn-p btn-s"
                                                    data-action="live#action"
                                                    data-live-action-param="accept"
                                                    data-live-offer-id-param="{{ offer.id }}"
                                                    data-loading="addAttribute(disabled)"
                                                    data-testid="confirm-accept">✓ Confirmer l'échange</button>
                                        </div>
                                    {% else %}
                                        <p class="muted flex-1 text-[13px]">
                                            {{ _self.masking_hint(got, 'proposée') }}
                                            {{ offer.proposer.username }} t'offre {{ _self.digest(got) }} contre {{ _self.digest(given) }}.
                                        </p>
                                        <div class="trade-offer__actions">
                                            <button type="button" class="btn btn-x btn-s"
                                                    data-action="live#action"
                                                    data-live-action-param="refuse"
                                                    data-live-offer-id-param="{{ offer.id }}"
                                                    data-loading="addAttribute(disabled)"
                                                    data-testid="refuse-offer">Refuser</button>
                                            <button type="button" class="btn btn-p btn-s"
                                                    data-action="live#action"
                                                    data-live-action-param="askAccept"
                                                    data-live-offer-id-param="{{ offer.id }}"
                                                    data-testid="accept-offer">Accepter</button>
                                        </div>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {# -------------------------------------------------------- Envoyées #}
            <section id="trade-pane-sent" role="tabpanel" aria-labelledby="trade-tab-sent" class="trade-pane flex flex-col gap-6"
                     {{ currentTab != 'sent' ? 'hidden' }}>
                {% if sent is empty %}
                    {{ _self.empty('Tu n\'as aucune offre en attente.', 'no-sent', true) }}
                {% else %}
                    <div class="flex flex-col gap-6" data-testid="sent-offers">
                        {% for offer in sent %}
                            {% set given = this.offeredView(offer) %}
                            {% set got = this.requestedView(offer) %}
                            <article class="panel trade-offer" data-testid="sent-offer">
                                {{ _self.offer_header(offer.receiver, 'doit répondre à ton offre', offer) }}
                                {{ _self.offer_body(given, 'Tu donnes', got, 'Tu reçois', 's-' ~ offer.id) }}
                                <div class="trade-offer__foot">
                                    <p class="muted flex-1 text-[13px]">
                                        {{ _self.masking_hint(got, 'demandée') }}
                                        Tes cartes proposées restent réservées tant que {{ offer.receiver.username }} n'a pas répondu.
                                    </p>
                                    <div class="trade-offer__actions">
                                        <button type="button" class="btn btn-x btn-s"
                                                data-action="live#action"
                                                data-live-action-param="cancel"
                                                data-live-offer-id-param="{{ offer.id }}"
                                                data-loading="addAttribute(disabled)"
                                                data-testid="cancel-offer">Annuler l'offre</button>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {# ------------------------------------------------------ Historique #}
            <section id="trade-pane-history" role="tabpanel" aria-labelledby="trade-tab-history" class="trade-pane flex flex-col gap-3"
                     {{ currentTab != 'history' ? 'hidden' }}>
                {% if history is empty %}
                    {{ _self.empty('Aucun échange terminé pour l\'instant.', 'no-history') }}
                {% else %}
                    {% set pageCount = this.historyPageCount %}
                    {% set page = this.currentHistoryPage %}
                    <h2 class="sr">Historique</h2>
                    {% if pageCount > 1 %}
                        <span class="lbl self-end" data-testid="history-page">Page {{ page }} / {{ pageCount }}</span>
                    {% endif %}
                    {# keyed by page: a page change swaps the list instead of morphing opened entries into others #}
                    <div id="trade-history-page-{{ page }}" class="flex flex-col gap-2.5" data-testid="trade-history">
                        {% for offer in history %}
                            {% set isMine = offer.proposer.discordId == app.user.discordId %}
                            {% set accepted = offer.status.value == 'accepted' %}
                            {% set isFocused = focused and focused.id ~ "" == offer.id ~ "" %}
                            {% set given = this.historyGivenView(offer) %}
                            {% set got = this.historyReceivedView(offer) %}
                            {% set givenCopies = given|reduce((sum, line) => sum + line.totalQuantity, 0) %}
                            {% set gotCopies = got|reduce((sum, line) => sum + line.totalQuantity, 0) %}
                            <details id="history-{{ offer.id }}" class="panel trade-hist{{ isFocused ? ' trade-hist--focused' }}" data-testid="history-entry"
                                     {%- if isFocused %} open data-focused data-controller="trade-focus"{% endif %}>
                                <summary class="trade-hist__summary">
                                    {{ _self.status(offer.status) }}
                                    <span class="trade-hist__text">
                                        {{ isMine ? 'Offre à' : 'Offre de' }} <strong class="text-ink-strong">{{ isMine ? offer.receiver.username : offer.proposer.username }}</strong>
                                        <span class="muted">· {{ accepted ? 'tu as reçu' : 'tu aurais reçu' }} {{ gotCopies }} carte{{ gotCopies > 1 ? 's' }} contre {{ givenCopies }}</span>
                                    </span>
                                    <span class="lbl">{{ offer.resolvedAt ? offer.resolvedAt|date('d/m/Y · H:i', 'Europe/Paris') : '' }}</span>
                                    <span class="trade-hist__chev" aria-hidden="true">▸</span>
                                </summary>
                                <div class="trade-hist__detail" data-testid="history-detail">
                                    {{ _self.offer_body(
                                        given, accepted ? 'Tu as donné' : 'Tu aurais donné',
                                        got, accepted ? 'Tu as reçu' : 'Tu aurais reçu',
                                        'h-' ~ offer.id
                                    ) }}
                                    {% if given|merge(got)|filter(line => line.masked)|length > 0 %}
                                        <p class="muted px-5 pb-4 text-[13px]" data-testid="masking-hint">
                                            Face cachée = carte que tu n'as jamais eue : seule sa rareté est affichée.
                                        </p>
                                    {% endif %}
                                </div>
                            </details>
                        {% endfor %}
                    </div>
                    {% if pageCount > 1 %}
                        <nav class="flex items-center justify-between gap-3" aria-label="Pagination de l'historique" data-testid="history-pagination">
                            {{ _self.page_button(page - 1, '‹ Plus récents', page <= 1, 'history-prev') }}
                            {{ _self.page_button(page + 1, 'Plus anciens ›', page >= pageCount, 'history-next') }}
                        </nav>
                    {% endif %}
                {% endif %}
            </section>
        </div>
    </main>

    {% set revealLines = this.revealLines %}
    {% if revealLines is not empty %}
        {{ include('parts/_trade_reveal.html.twig', {
            offer: focused,
            lines: revealLines,
            counterpart: focused.proposer.discordId == app.user.discordId ? focused.receiver.username : focused.proposer.username,
        }, with_context = false) }}
    {% endif %}
</div>

{% macro tab(name, label, count, current, hot) %}
    <button type="button" role="tab" id="trade-tab-{{ name }}"
            class="tab{{ name == current ? ' on' }}"
            aria-selected="{{ name == current ? 'true' : 'false' }}"
            aria-controls="trade-pane-{{ name }}"
            data-action="live#action"
            data-live-action-param="showTab"
            data-live-tab-param="{{ name }}"
            data-testid="tab-{{ name }}">
        {{ label }}
        {% if hot and count > 0 %}<span class="badge" data-testid="tab-{{ name }}-count">{{ count }}</span>{% else %}<span class="lbl" data-testid="tab-{{ name }}-count">{{ count }}</span>{% endif %}
    </button>
{% endmacro %}

{% macro empty(message, testid, cta = false) %}
    <div class="panel flex flex-col items-center gap-4 px-6 py-14 text-center" data-testid="{{ testid }}">
        <p class="muted text-sm">{{ message }}</p>
        {% if cta %}<a href="{{ path('trades_new') }}" class="btn btn-g btn-s">Proposer un échange</a>{% endif %}
    </div>
{% endmacro %}

{% macro page_button(target, label, disabled, testid) %}
    <button type="button" class="btn btn-g btn-s"
            data-action="live#action"
            data-live-action-param="goToHistoryPage"
            data-live-page-param="{{ target }}"
            {% if disabled %}disabled{% else %}data-loading="addAttribute(disabled)"{% endif %}
            data-testid="{{ testid }}">{{ label }}</button>
{% endmacro %}

{% macro status(status) %}
    {% set tone = {
        pending: 'chip-soon',
        accepted: 'chip-live',
        refused: 'chip-err',
        cancelled: '',
        invalidated: '',
    }[status.value] %}
    <span class="chip {{ tone }} shrink-0" data-testid="offer-status">{{ status.label }}</span>
{% endmacro %}

{% macro offer_header(player, caption, offer) %}
    <header class="trade-offer__head">
        <span class="av oct-s h-9 w-9 text-base" aria-hidden="true">{{ player.username|first|upper }}</span>
        <span class="trade-offer__who text-[15px]">
            <a href="{{ path('leaderboard_player', { discordId: player.discordId }) }}" class="font-bold text-ink-strong hover:text-primary">{{ player.username }}</a>
            <span class="text-ink">{{ caption }}</span>
        </span>
        <span class="lbl trade-offer__when">{{ offer.createdAt ? offer.createdAt|date('d/m · H:i', 'Europe/Paris') }}</span>
        {{ _self.status(offer.status) }}
    </header>
{% endmacro %}

{% macro offer_body(givenLines, givenLabel, gotLines, gotLabel, idPrefix) %}
    <div class="trade-offer__body">
        {{ include('parts/_trade_lines.html.twig', { lines: givenLines, label: givenLabel, tone: 'give', idPrefix: 'trade-' ~ idPrefix ~ '-l' }, with_context = false) }}
        <span class="trade-offer__swap d" aria-hidden="true">⇄</span>
        {{ include('parts/_trade_lines.html.twig', { lines: gotLines, label: gotLabel, tone: 'get', idPrefix: 'trade-' ~ idPrefix ~ '-r' }, with_context = false) }}
    </div>
{% endmacro %}

{# « 1 légendaire, 2 communes » — rarest first #}
{% macro digest(lines) %}
    {%- set parts = [] -%}
    {%- for rarity in ['legendary', 'rare', 'uncommon', 'common'] -%}
        {%- set copies = lines|filter(line => line.rarity.value == rarity)|reduce((sum, line) => sum + line.totalQuantity, 0) -%}
        {%- if copies > 0 -%}
            {%- set parts = parts|merge([copies ~ ' ' ~ rarity_label(rarity)|lower ~ (copies > 1 ? 's')]) -%}
        {%- endif -%}
    {%- endfor -%}
    {{- parts is empty ? 'rien' : parts|join(', ') -}}
{% endmacro %}

{% macro masking_hint(lines, verb) %}
    {%- set masked = lines|filter(line => line.masked)|length -%}
    {%- if masked > 0 -%}
        <span data-testid="masking-hint">Tu ne possèdes pas {{ masked > 1 ? masked ~ ' des cartes ' ~ verb ~ 's' : 'la carte ' ~ verb }} : seule {{ masked > 1 ? 'leur' : 'sa' }} rareté est visible.</span>
    {%- endif -%}
{% endmacro %}

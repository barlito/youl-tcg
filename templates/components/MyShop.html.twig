{# re-rendered live: a sale, a withdrawal or any inventory change refreshes the shop #}
<div {{ attributes.defaults({'data-action': 'live-updates:market-changed@window->live#$render live-updates:inventory-changed@window->live#$render', 'data-testid': 'my-shop'}) }}>
    {% set listings = this.listings %}
    {% set sellable = this.sellable %}
    {% set history = this.history %}
    {% set max = this.maxListings %}
    <main>
        {% embed 'parts/ui/_page_header.html.twig' with {
            title: 'Ma boutique',
            lead: 'Jusqu\'à ' ~ max ~ ' cartes en vente à ton prix. Une carte en vente est réservée : ni échangeable, ni recyclable. Tu reçois le prix moins la commission.',
        } %}
            {% block aside %}
                <a href="{{ path('market') }}" class="lbl order-first no-underline" data-testid="back-to-market">‹ Marché</a>
            {% endblock %}
        {% endembed %}

        <div class="wrap flex flex-col gap-10 pb-24 pt-6 md:pt-8">
            {# an error about the price being typed stays next to its field #}
            {% set inlineError = error and (editingId or (selling and this.canPublish)) %}
            {% if error and not inlineError %}
                <div class="panel flash-msg flash-msg--err" role="alert" data-controller="reveal-message" data-reveal-message-key-value="{{ error }}" data-testid="shop-error">⚠ {{ error }}</div>
            {% elseif success %}
                <div class="panel flash-msg flash-msg--ok" role="status" data-controller="reveal-message" data-reveal-message-key-value="{{ success }}" data-testid="shop-success">✦ {{ success }}</div>
            {% endif %}

            {# ------------------------------------------------ En vente #}
            <section aria-labelledby="shop-sale" class="flex flex-col gap-3.5">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h2 id="shop-sale" class="h2">En vente</h2>
                    <span class="muted" data-testid="quota">{{ listings|length }} / {{ max }} emplacements</span>
                </div>
                <div class="shop-slots" data-testid="my-listings">
                    {% for listing in listings %}
                        {% set card = listing.card %}
                        {% set busy = listing.status.value == 'reserved_for_purchase' %}
                        <article class="panel hot shop-slot" data-testid="my-listing">
                            {{ include('parts/ui/_card_thumb.html.twig', { card: card, holo: listing.holo }, with_context = false) }}
                            <div class="flex min-w-0 flex-col gap-1.5">
                                <span class="cn" title="{{ card.name }}">{{ card.name }}</span>
                                <span class="lbl r-{{ card.rarity.value|first }} truncate">{{ card.rarity.icon }} {{ card.rarity.label }} · {{ card.extension.name }}{% if listing.holo %} <span class="text-magenta">· ✦ holo</span>{% endif %}</span>
                                {% if editingId == (listing.id ~ '') %}
                                    <label class="lbl" for="edit-price-{{ listing.id }}">Nouveau prix (YLC)</label>
                                    <input id="edit-price-{{ listing.id }}" class="field w-full" type="text" inputmode="numeric"
                                           data-model="editPrice" value="{{ editPrice }}" data-testid="edit-price"{{ inlineError ? ' aria-invalid="true" aria-describedby="edit-price-error"' }}>
                                    {% if inlineError %}
                                        <span id="edit-price-error" class="field-error" role="alert" data-testid="shop-error">⚠ {{ error }}</span>
                                    {% endif %}
                                    <span class="mt-auto flex gap-2">
                                        <button type="button" class="btn btn-p btn-s flex-1"
                                                data-action="live#action" data-live-action-param="savePrice" data-live-listing-id-param="{{ listing.id }}"
                                                data-loading="addAttribute(disabled) addClass(opacity-50)" data-testid="save-price">Enregistrer</button>
                                        <button type="button" class="btn btn-g btn-s" data-action="live#action" data-live-action-param="cancelEdit">Annuler</button>
                                    </span>
                                {% else %}
                                    <span class="d text-2xl text-ink-strong" data-testid="my-listing-price">{{ coin_amount(listing.price) }} <span class="lbl">YLC</span></span>
                                    {% if busy %}
                                        <span class="text-xs text-soon" data-testid="listing-busy">⏳ Achat en cours de vérification</span>
                                    {% else %}
                                        <span class="muted text-xs">commission déduite à la vente · {{ _self.since(listing.createdAt) }}</span>
                                    {% endif %}
                                    <span class="mt-auto flex gap-2">
                                        <button type="button" class="btn btn-g btn-s flex-1"
                                                data-action="live#action" data-live-action-param="startEdit" data-live-listing-id-param="{{ listing.id }}"
                                                data-testid="edit-listing" {{ busy ? 'disabled' }}>Prix</button>
                                        <button type="button" class="btn btn-x btn-s"
                                                data-action="live#action" data-live-action-param="withdraw" data-live-listing-id-param="{{ listing.id }}"
                                                {% if busy %}disabled{% else %}data-loading="addAttribute(disabled) addClass(opacity-50)"{% endif %} data-testid="withdraw-listing">Retirer</button>
                                    </span>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                    {% for i in (listings|length < max ? range(1, max - listings|length) : []) %}
                        <a href="#vendre" class="panel shop-slot--empty" data-testid="{{ listings is empty and loop.first ? 'no-listings' : 'empty-slot' }}">
                            <span class="d text-[28px] text-primary" aria-hidden="true">+</span>
                            <span class="lbl text-ink">Mettre une carte en vente</span>
                        </a>
                    {% endfor %}
                </div>
            </section>

            {# ------------------------------------------- Mettre en vente #}
            <section id="vendre" aria-labelledby="shop-sell" class="flex scroll-mt-24 flex-col gap-3.5">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h2 id="shop-sell" class="h2">Mettre en vente</h2>
                    {% if this.sellableCount > 0 %}
                        <span class="muted" data-testid="sellable-count">{{ this.matchingCount }} carte{{ this.matchingCount > 1 ? 's' }} sur {{ this.sellableCount }} vendable{{ this.sellableCount > 1 ? 's' }}</span>
                    {% endif %}
                </div>

                {% if not this.canPublish %}
                    <p class="panel flash-msg text-soon" data-testid="quota-reached">Tu as atteint la limite de {{ max }} annonces : retires-en une pour en publier une autre.</p>
                {% elseif this.sellableCount == 0 %}
                    <div class="panel flex flex-col items-center gap-2 border-dashed px-6 py-12 text-center" data-testid="nothing-sellable">
                        <span class="muted">Aucune carte disponible : les copies engagées dans un échange ou déjà en vente ne comptent pas.</span>
                    </div>
                {% else %}
                    <div class="panel shop-filters">
                        <div class="shop-filters__row">
                            <label for="sell-q" class="sr">Chercher une carte</label>
                            <input id="sell-q" class="field shop-filters__q" type="search" placeholder="Chercher une carte…" autocomplete="off"
                                   data-model="debounce(250)|search" value="{{ search }}" data-testid="sell-search">
                            <label for="sell-universe" class="sr">Univers</label>
                            <select id="sell-universe" data-model="universe" class="dd dd-select{{ universe ? ' on' }}" data-testid="sell-universe">
                                <option value="">Univers : tous</option>
                                {% for option in this.universeOptions %}
                                    <option value="{{ option.extension.slug }}" {{ universe == option.extension.slug ? 'selected' }}>{{ option.extension.name }} · {{ option.count }}</option>
                                {% endfor %}
                            </select>
                            <label for="sell-rarity" class="sr">Rareté</label>
                            <select id="sell-rarity" data-model="rarity" class="dd dd-select{{ rarity ? ' on' }}" data-testid="sell-rarity">
                                <option value="">Rareté : toutes</option>
                                {% for option in this.rarities %}
                                    <option value="{{ option.value }}" {{ rarity == option.value ? 'selected' }}>{{ option.icon }} {{ option.label }}</option>
                                {% endfor %}
                            </select>
                            <label for="sell-finish" class="sr">Finition</label>
                            <select id="sell-finish" data-model="finish" class="dd dd-select{{ finish ? ' on' }}" data-testid="sell-finish">
                                <option value="">Finition : toutes</option>
                                <option value="normal" {{ finish == 'normal' ? 'selected' }}>Normale</option>
                                <option value="holo" {{ finish == 'holo' ? 'selected' }}>✦ Holo</option>
                            </select>
                            <button type="button" class="seg{{ duplicatesOnly ? ' on' }}" aria-pressed="{{ duplicatesOnly ? 'true' : 'false' }}"
                                    data-action="live#action" data-live-action-param="toggleDuplicates" data-testid="sell-duplicates">Doublons seulement</button>
                            <label for="sell-sort" class="sr">Tri</label>
                            <select id="sell-sort" data-model="sort" class="dd dd-select" data-testid="sell-sort">
                                {% for value, label in { copies: 'Tri : exemplaires', rarity: 'Tri : rareté', name: 'Tri : nom' } %}
                                    <option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            {% if this.hasActiveFilters %}
                                <button type="button" class="tl" data-action="live#action" data-live-action-param="resetFilters" data-testid="sell-reset">Tout effacer</button>
                            {% endif %}
                            <span class="muted text-[13px] md:ml-auto">Les cartes déjà en vente ou engagées dans un échange n'apparaissent pas</span>
                        </div>
                    </div>

                    <div class="panel overflow-x-auto">
                        <table class="tbl shop-table" data-testid="sellable-list">
                            <thead>
                                <tr>
                                    <th>Carte</th>
                                    <th class="max-md:hidden">Rareté</th>
                                    <th class="max-md:hidden">Finition</th>
                                    <th class="num">Exemplaires</th>
                                    <th class="num max-md:hidden">Dernière vente</th>
                                    <th class="shop-table__action"><span class="sr">Action</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in sellable %}
                                    {% set card = row.card %}
                                    {% set key = card.id ~ '|' ~ row.finish %}
                                    {% set lastSale = this.lastSale(card, row.finish) %}
                                    <tr class="{{ selling == key ? 'me' }}" data-testid="sellable">
                                        <td>
                                            <strong class="text-ink-strong">{{ card.name }}</strong> <span class="muted">· {{ card.extension.name }}</span>
                                            <span class="lbl mt-1 block md:hidden"><span class="r-{{ card.rarity.value|first }}">{{ card.rarity.icon }} {{ card.rarity.label }}</span>{% if row.finish == 'holo' %} <span class="text-magenta">· ✦ holo</span>{% endif %}</span>
                                        </td>
                                        <td class="r-{{ card.rarity.value|first }} max-md:hidden">{{ card.rarity.icon }} {{ card.rarity.label }}</td>
                                        <td class="max-md:hidden{{ row.finish == 'holo' ? ' text-magenta' }}">{{ row.finish == 'holo' ? '✦ holo' : 'normale' }}</td>
                                        <td class="num">×{{ row.copies }}</td>
                                        <td class="num max-md:hidden{{ lastSale is null ? ' muted' }}" data-testid="last-sale">{{ lastSale is null ? '—' : coin_amount(lastSale) ~ ' YLC' }}</td>
                                        <td class="shop-table__action">
                                            {% if selling != key %}
                                                <button type="button" class="btn btn-p btn-s"
                                                        data-action="live#action" data-live-action-param="startSelling"
                                                        data-live-card-id-param="{{ card.id }}" data-live-finish-param="{{ row.finish }}"
                                                        data-testid="sell-copy">Vendre</button>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% if selling == key %}
                                        <tr class="me">
                                            <td colspan="6">
                                                <div class="flex flex-wrap items-end gap-2">
                                                    <span class="flex min-w-[160px] flex-1 flex-col gap-1.5">
                                                        <label class="lbl" for="sell-price">Prix (YLC, entier)</label>
                                                        <input id="sell-price" class="field w-full" type="text" inputmode="numeric" data-model="sellPrice" value="{{ sellPrice }}" data-testid="sell-price">
                                                    </span>
                                                    <button type="button" class="btn btn-p btn-s"
                                                            data-action="live#action" data-live-action-param="publish"
                                                            data-loading="addAttribute(disabled) addClass(opacity-50)" data-testid="publish-listing">Mettre en vente</button>
                                                    <button type="button" class="btn btn-g btn-s" data-action="live#action" data-live-action-param="cancelSelling">Annuler</button>
                                                </div>
                                                {% if inlineError %}
                                                    <p class="field-error mt-2" role="alert" data-testid="shop-error">⚠ {{ error }}</p>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% else %}
                                    <tr><td colspan="6" class="muted text-center">Aucune carte ne correspond à ces filtres.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% if sellable is not empty %}
                            <p class="lbl px-4 py-3 text-center">
                                {%- if this.matchingCount > sellable|length -%}
                                    {{ this.matchingCount - sellable|length }} autre{{ this.matchingCount - sellable|length > 1 ? 's' }} carte{{ this.matchingCount - sellable|length > 1 ? 's' }} · affine les filtres pour les voir
                                {%- else -%}
                                    Fin des résultats
                                {%- endif -%}
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
            </section>

            {# ------------------------------------------------ Historique #}
            <section aria-labelledby="shop-hist" class="flex flex-col gap-3.5">
                <h2 id="shop-hist" class="h2">Historique</h2>
                {% if history is empty %}
                    <p class="muted" data-testid="no-history">Aucune vente ni aucun achat pour l'instant.</p>
                {% else %}
                    <div class="panel overflow-x-auto">
                        <table class="tbl shop-table" data-testid="shop-history">
                            <thead>
                                <tr>
                                    <th class="w-[90px]">Sens</th>
                                    <th>Carte</th>
                                    <th class="max-md:hidden">Avec</th>
                                    <th class="num">Prix</th>
                                    <th>Statut</th>
                                    <th class="num max-md:hidden">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for purchase in history %}
                                    {% set sold = this.isSeller(purchase) %}
                                    {% set status = purchase.status.value %}
                                    <tr data-testid="history-entry">
                                        <td class="lbl {{ sold ? 'text-live' : 'tone-violet' }}">{{ sold ? 'Vente' : 'Achat' }}</td>
                                        <td class="text-ink-strong">
                                            {{ purchase.listing.card.name }}{% if purchase.listing.holo %} <span class="text-magenta">✦</span>{% endif %}
                                            <span class="muted mt-1 block text-xs md:hidden">{{ sold ? purchase.buyer.username : purchase.seller.username }} · {{ purchase.requestedAt|date('d/m · H:i', 'Europe/Paris') }}</span>
                                        </td>
                                        <td class="max-md:hidden">{{ sold ? purchase.buyer.username : purchase.seller.username }}</td>
                                        <td class="num whitespace-nowrap">{{ coin_amount(purchase.price) }} YLC{% if sold and status == 'completed' %} <span class="muted">(reçu {{ this.netPayout(purchase) }})</span>{% endif %}</td>
                                        <td><span class="chip {{ status == 'completed' ? 'chip-live' : (status == 'failed' ? 'chip-err' : (status == 'refunded' ? '' : 'chip-soon')) }}">{{ purchase.status.label }}</span></td>
                                        <td class="num muted max-md:hidden whitespace-nowrap">{{ purchase.requestedAt|date('d/m · H:i', 'Europe/Paris') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>
    </main>
</div>

{% macro since(date) %}
    {%- set days = (('now'|date('U') - date|date('U')) / 86400)|round(0, 'floor') -%}
    {%- if days < 1 -%}depuis aujourd'hui
    {%- elseif days < 2 -%}depuis 1 j
    {%- else -%}depuis {{ days }} j
    {%- endif -%}
{% endmacro %}

{% set pending = pending_trade_offers() %}
<a href="{{ path('trades') }}"
   {{ attributes.defaults({
       class: 'flex items-center gap-1.5 text-ink-muted hover:text-ink-strong' ~ (active ? ' active' : ''),
       'data-action': 'live-updates:trades-changed@window->live#$render trades:changed@window->live#$render',
       'data-testid': 'nav-trades',
   }) }}>
    Échanges
    {% if pending > 0 %}
        <span class="flex h-4 min-w-4 items-center justify-center bg-primary px-1 font-mono text-[10px] font-bold text-black"
              data-testid="pending-trades-badge">{{ pending }}</span>
    {% endif %}
</a>

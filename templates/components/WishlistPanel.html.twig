<div {{ attributes.defaults({'data-testid': 'wishlist-panel'}) }}>
    {% set entries = this.entries %}
    {% set universes = this.universes %}

    <section class="px-6 pb-24 pt-8 lg:px-12">
        <div class="mx-auto max-w-7xl">
            {% if error %}
                <div class="mb-6 border border-magenta/50 bg-magenta/10 px-4 py-3 font-mono text-xs text-magenta" data-testid="wishlist-error">⚠ {{ error }}</div>
            {% endif %}

            {# ------------------------------------------ Univers surveillés #}
            <h2 class="font-display text-sm font-bold uppercase tracking-[.1em] text-ink-strong">
                Univers surveillés <span class="text-primary">{{ '%02d'|format(universes|length) }}</span>
            </h2>
            {% if universes is empty %}
                <p class="mt-3 text-sm text-ink-dim" data-testid="wishlist-no-universe">
                    Aucun univers surveillé. Depuis la page d'un univers, « Me prévenir pour mes cartes manquantes » t'alerte sans rien révéler des cartes que tu n'as pas trouvées.
                </p>
            {% else %}
                <ul class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3" data-testid="wishlist-universes">
                    {% for item in universes %}
                        <li class="flex items-center justify-between gap-3 border border-hairline bg-surface px-4 py-3" data-testid="wishlist-universe">
                            <div class="min-w-0">
                                <a href="{{ path('universes_show', { slug: item.universe.extension.slug }) }}" class="block truncate font-display text-xs font-bold uppercase text-ink-strong hover:text-primary">{{ item.universe.extension.name }}</a>
                                <p class="chip-mono mt-1 text-ink-muted" data-testid="wishlist-missing">
                                    {% if item.missing > 0 %}
                                        ♥ {{ item.missing }} carte{{ item.missing > 1 ? 's' }} manquante{{ item.missing > 1 ? 's' }} surveillée{{ item.missing > 1 ? 's' }}
                                    {% else %}
                                        ★ Univers complet
                                    {% endif %}
                                </p>
                            </div>
                            <button type="button"
                                    data-action="live#action" data-live-action-param="unwatch" data-live-slug-param="{{ item.universe.extension.slug }}"
                                    data-loading="addAttribute(disabled) addClass(opacity-50)"
                                    data-testid="wishlist-unwatch"
                                    class="shrink-0 border border-hairline px-3 py-2 font-mono text-[11px] uppercase tracking-[.1em] text-ink-dim hover:border-magenta hover:text-magenta">
                                Retirer ✕
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {# ------------------------------------------ Cartes souhaitées #}
            <h2 class="mt-12 font-display text-sm font-bold uppercase tracking-[.1em] text-ink-strong">
                Cartes souhaitées <span class="text-primary" data-testid="wishlist-count">{{ entries|length }}/{{ this.max }}</span>
            </h2>
            {% if entries is empty %}
                <div class="mt-4 border border-dashed border-hairline px-8 py-16 text-center text-ink-dim" data-testid="wishlist-empty">
                    <p class="font-display text-lg font-bold uppercase tracking-[.15em]">Rien ici.</p>
                    <p class="mt-3 text-sm">Ajoute une carte avec le ♡ depuis le marché, ta collection ou un échange.</p>
                </div>
            {% else %}
                <div class="mt-6 grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-3 xl:grid-cols-5" data-testid="wishlist-grid">
                    {% for item in entries %}
                        {% set entry = item.entry %}
                        <article class="relative flex flex-col border border-hairline bg-surface p-3" data-testid="wishlist-entry">
                            <div class="mx-auto w-full max-w-[13rem]">
                                {% if item.visible %}
                                    {{ include('components/CardComponent.html.twig', {
                                        card: entry.card,
                                        interactive: false,
                                        lazy: true,
                                        id: 'wish-' ~ entry.id,
                                    }, with_context = false) }}
                                {% else %}
                                    {{ include('parts/_masked_card.html.twig', {}, with_context = false) }}
                                {% endif %}
                            </div>
                            {% if item.visible %}
                                <p class="mt-3 truncate font-display text-xs font-bold uppercase leading-tight text-ink-strong" title="{{ entry.card.name }}">{{ entry.card.name }}</p>
                                <p class="chip-mono mt-0.5 truncate" style="color: var(--rarity-{{ entry.card.rarity.value }});">
                                    {{ entry.card.rarity.label }} · <span class="text-ink-dim">{{ entry.card.extension.name }}</span>
                                </p>
                            {% else %}
                                <p class="mt-3 truncate font-display text-xs font-bold uppercase leading-tight text-ink-dim">Carte repérée</p>
                            {% endif %}
                            <div class="mt-3 flex flex-col gap-2 border-t border-hairline pt-3">
                                {% if item.listed %}
                                    <a href="{{ path('market', { univers: entry.card.extension.slug }) }}" class="chip-mono border border-primary/60 bg-primary/10 px-2 py-1 text-center text-primary" data-testid="wishlist-listed">¤ En vente maintenant ▸</a>
                                {% endif %}
                                <button type="button"
                                        data-action="live#action" data-live-action-param="removeEntry" data-live-entry-id-param="{{ entry.id }}"
                                        data-loading="addAttribute(disabled) addClass(opacity-50)"
                                        data-testid="wishlist-remove"
                                        class="border border-hairline px-3 py-2 font-mono text-[11px] uppercase tracking-[.1em] text-ink-dim hover:border-magenta hover:text-magenta">
                                    ♥ Retirer
                                </button>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
</div>

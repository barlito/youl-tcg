<div {{ attributes.defaults({'data-testid': 'wishlist-panel', 'data-action': 'live-updates:market-changed@window->live#$render'}) }}>
    {% set entries = this.entries %}
    {% set universes = this.universes %}
    {% set watchable = this.watchable %}

    <div class="wrap wishlist-layout pb-24 pt-6 md:pt-8">
        {% if error %}
            <div class="panel flash-msg flash-msg--err wishlist-layout__msg" role="alert" data-controller="reveal-message" data-reveal-message-key-value="{{ error }}" data-testid="wishlist-error">⚠ {{ error }}</div>
        {% endif %}

        {# ------------------------------------------ Univers surveillés #}
        <section aria-labelledby="wish-universes" class="flex min-w-0 flex-col gap-3">
            <div class="flex items-baseline gap-3">
                <h2 id="wish-universes" class="h2 text-lg">Univers surveillés</h2>
                <span class="muted">{{ universes|length }}</span>
            </div>
            {% if universes is empty %}
                <p class="muted text-[13px]" data-testid="wishlist-no-universe">
                    Aucun univers surveillé. Tu seras prévenu pour chacune de tes cartes manquantes, sans rien révéler de celles que tu n'as pas trouvées.
                </p>
            {% else %}
                <ul class="flex flex-col gap-3" data-testid="wishlist-universes">
                    {% for item in universes %}
                        {% set extension = item.universe.extension %}
                        <li class="panel flex items-center gap-3 p-3.5" data-testid="wishlist-universe">
                            <span class="dot{{ item.missing == 0 ? ' opacity-40' }}" aria-hidden="true"></span>
                            <span class="flex min-w-0 flex-1 flex-col">
                                <a href="{{ path('universes_show', { slug: extension.slug }) }}" class="d up truncate text-ink-strong no-underline">{{ extension.name }}</a>
                                <span class="muted text-[13px]" data-testid="wishlist-missing">
                                    {%- if item.missing > 0 -%}
                                        {{ item.missing }} carte{{ item.missing > 1 ? 's' }} manquante{{ item.missing > 1 ? 's' }} surveillée{{ item.missing > 1 ? 's' }}
                                    {%- else -%}
                                        ★ Univers complet
                                    {%- endif -%}
                                </span>
                            </span>
                            <button type="button" class="btn btn-x btn-s"
                                    data-action="live#action" data-live-action-param="unwatch" data-live-slug-param="{{ extension.slug }}"
                                    data-loading="addAttribute(disabled)"
                                    aria-label="Ne plus surveiller {{ extension.name }}"
                                    data-testid="wishlist-unwatch">Retirer</button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if watchable is not empty %}
                <div class="flex gap-2" data-testid="wishlist-watch-form">
                    <label for="wish-add-universe" class="sr">Surveiller un univers</label>
                    <select id="wish-add-universe" class="field dd-select min-w-0 flex-1" data-model="watchSlug" data-testid="wishlist-watch-select">
                        <option value="">Ajouter un univers…</option>
                        {% for item in watchable %}
                            <option value="{{ item.extension.slug }}" {{ watchSlug == item.extension.slug ? 'selected' }}>{{ item.extension.name }} · {{ item.missing }} manquante{{ item.missing > 1 ? 's' }}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="btn btn-g btn-s self-center"
                            data-action="live#action" data-live-action-param="watch"
                            data-loading="addAttribute(disabled)"
                            data-testid="wishlist-watch">Ajouter</button>
                </div>
            {% endif %}
        </section>

        {# ------------------------------------------ Cartes souhaitées #}
        <section aria-labelledby="wish-cards" class="flex min-w-0 flex-col gap-3">
            <div class="flex items-baseline gap-3">
                <h2 id="wish-cards" class="h2 text-lg">Cartes souhaitées</h2>
                <span class="muted" data-testid="wishlist-count">{{ entries|length }} / {{ this.max }}</span>
            </div>
            {% if entries is empty %}
                <div class="panel flex flex-col items-center gap-2.5 border-dashed px-6 py-9 text-center" data-testid="wishlist-empty">
                    <span class="d up text-lg text-ink-strong">Rien ici pour l'instant</span>
                    <span class="muted max-w-[46ch]">Ajoute une carte avec ♡ depuis le marché, ta collection ou un échange.</span>
                    <div class="flex flex-wrap justify-center gap-2.5 pt-1.5">
                        <a class="btn btn-p btn-s" href="{{ path('market') }}">Parcourir le marché</a>
                        <a class="btn btn-g btn-s" href="{{ path('collection', { filtre: 'manquantes' }) }}">Voir mes manquantes</a>
                    </div>
                </div>
            {% else %}
                <div class="wishlist-grid" data-testid="wishlist-grid">
                    {% for item in entries %}
                        {% set entry = item.entry %}
                        <article class="panel flex min-w-0 flex-col gap-2 p-3" data-testid="wishlist-entry">
                            {% if item.visible %}
                                {{ include('parts/ui/_card_cell.html.twig', {
                                    card: entry.card,
                                    id: 'wish-' ~ entry.id,
                                    suffix: entry.card.extension.name,
                                    testid: 'wishlist-cell',
                                }, with_context = false) }}
                            {% else %}
                                {{ include('parts/ui/_card_cell.html.twig', {
                                    card: null,
                                    maskedLabel: 'Carte repérée',
                                    showRarity: false,
                                    testid: 'wishlist-cell',
                                }, with_context = false) }}
                            {% endif %}
                            {% if item.listed %}
                                <a href="{{ path('market', { univers: entry.card.extension.slug }) }}" class="chip chip-live justify-center no-underline" data-testid="wishlist-listed">¤ En vente maintenant ›</a>
                            {% endif %}
                            <button type="button" class="btn btn-g btn-s mt-auto"
                                    data-action="live#action" data-live-action-param="removeEntry" data-live-entry-id-param="{{ entry.id }}"
                                    data-loading="addAttribute(disabled)"
                                    data-testid="wishlist-remove">♥ Retirer</button>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            {% set onSale = this.missingOnSale %}
            {% if onSale is not empty %}
                <span class="lbl pt-3">En vente et qui te manquent</span>
                <div class="wishlist-sale" data-testid="wishlist-on-sale">
                    {% for listing in onSale %}
                        {% set card = listing.card %}
                        {% set wished = this.isWished(listing) %}
                        <article class="panel wishlist-sale__item" data-testid="wishlist-on-sale-item">
                            {{ include('parts/ui/_card_thumb.html.twig', { card: card, holo: listing.holo }, with_context = false) }}
                            <a href="{{ path('market', { univers: card.extension.slug }) }}" class="flex min-w-0 flex-col gap-[3px] no-underline">
                                <span class="cn">{{ card.name }}</span>
                                <span class="lbl r-{{ card.rarity.value|first }} truncate">{{ card.rarity.icon }} {{ card.rarity.label }} · {{ card.extension.name }}</span>
                                <span class="muted truncate text-xs">{{ coin_amount(listing.price) }} YLC chez {{ listing.seller.username }}{% if listing.holo %} · <span class="text-magenta">✦ holo</span>{% endif %}</span>
                            </a>
                            <button type="button" class="ib{{ wished ? ' wishlist-sale__wish--on' }}"
                                    data-action="live#action" data-live-action-param="toggleListingWish" data-live-listing-id-param="{{ listing.id }}"
                                    data-loading="addAttribute(disabled)"
                                    aria-pressed="{{ wished ? 'true' : 'false' }}"
                                    aria-label="{{ wished ? 'Retirer de ma wishlist' : 'Ajouter à ma wishlist' }}"
                                    data-testid="wishlist-on-sale-wish">{{ wished ? '♥' : '♡' }}</button>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
</div>

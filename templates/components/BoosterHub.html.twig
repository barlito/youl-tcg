{# another tab (or channel) changed the inventory: re-render in place #}
<div {{ attributes.defaults({'data-action': 'live-updates:inventory-changed@window->live#$render'}) }}>
    {% set dailyLimit = constant('App\\Service\\Booster\\BoosterClaimQuotaInterface::DAILY_LIMIT') %}
    {% set remainingClaims = this.remainingClaims %}
    {% set totalOwned = this.totalOwned %}
    {% set streak = this.streak %}
    <main>
        {# ----------------------------------------------------- Header + today's stats #}
        {% embed 'parts/ui/_page_header.html.twig' with {
            eyebrow: 'Jouer',
            title: 'Tes packs',
            lead: 'Chaque jour, ' ~ dailyLimit ~ ' packs gratuits. Choisis l\'univers que tu veux récupérer, puis ouvre-les quand tu veux.',
            testid: 'hub-header',
        } %}
            {% block actions %}
                <div class="panel hub-stats">
                    <div class="hub-stats__cell{{ remainingClaims > 0 ? ' hub-stats__cell--hot' }}" data-testid="daily-packs">
                        <span class="lbl flex items-center gap-2">{% if remainingClaims > 0 %}<span class="dot" aria-hidden="true"></span>{% endif %}Gratuits<span class="max-sm:hidden"> aujourd'hui</span></span>
                        <span><span class="d text-[28px] text-ink-strong">{{ remainingClaims }}</span><span class="d text-base text-ink-muted">/{{ dailyLimit }}<span class="max-sm:hidden"> restant{{ remainingClaims > 1 ? 's' }}</span></span></span>
                        <span class="text-xs text-ink-muted">reset dans <span data-controller="countdown" data-countdown-seconds-value="{{ this.secondsUntilReset }}">--:--:--</span></span>
                    </div>
                    <div class="hub-stats__cell" data-testid="total-owned">
                        <span class="lbl">En stock</span>
                        <span class="d text-[28px] {{ totalOwned > 0 ? 'text-ink-strong' : 'text-ink-muted' }}">{{ totalOwned }}</span>
                        <a href="{{ path('opening_history') }}" class="text-xs text-ink-muted underline-offset-2 hover:underline" data-testid="history-link">mes ouvertures</a>
                    </div>
                    <div class="hub-stats__cell" data-testid="streak-flame">
                        <span class="lbl">Série</span>
                        <span class="d text-[28px] {{ streak.running ? 'text-soon' : 'text-ink-strong' }}">{{ streak.running ? streak.length : 0 }} j</span>
                        <span class="text-xs {{ streak.atRisk ? 'text-soon' : 'text-ink-muted' }}">
                            {% if not streak.running %}
                                ouvre un pack pour la lancer
                            {% elseif streak.atRisk %}
                                ouvre un pack aujourd'hui !
                            {% else %}
                                prochain palier à {{ streak.nextMilestone }} j
                            {% endif %}
                        </span>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}

        <div class="wrap flex flex-col gap-6 pb-24 pt-6 md:gap-8 md:pt-8">
            {# ----------------------------------------------------- Streak reward #}
            {% set pendingRewards = this.pendingStreakRewards %}
            {% if pendingRewards is not empty or streakError or streakSuccess %}
                <section class="panel hot flex flex-col gap-3 px-5 py-4" data-testid="streak-reward-banner">
                    {% if pendingRewards is not empty %}
                        {% set reward = pendingRewards|first %}
                        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                            <div class="flex flex-col gap-1">
                                <span class="d up text-[15px] tracking-[.08em] text-ink-strong">
                                    🔥 Récompense de série — palier {{ reward.milestone }} jours
                                    {% if pendingRewards|length > 1 %}
                                        <span class="text-ink-muted" data-testid="streak-reward-counter">· 1 / {{ pendingRewards|length }}</span>
                                    {% endif %}
                                </span>
                                <span class="text-sm text-ink-muted">
                                    Choisis un pack bonus : il s'ajoute à ton stock sans entamer tes récupérations du jour.
                                    {% if pendingRewards|length > 1 %}
                                        Encore {{ pendingRewards|length - 1 }} récompense{{ pendingRewards|length > 2 ? 's' }} ensuite.
                                    {% endif %}
                                </span>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 md:justify-end">
                                {% set choices = this.streakRewardChoices %}
                                {% if choices is empty %}
                                    <p class="lbl">Aucun pack disponible pour l'instant — ta récompense t'attend.</p>
                                {% else %}
                                    <select data-model="norender|streakRewardBoosterId"
                                            aria-label="Choisir le pack de ta récompense"
                                            data-testid="streak-reward-select"
                                            class="field w-full min-w-0 md:w-72">
                                        <option value="">Choisis ton pack…</option>
                                        {% for booster in choices %}
                                            <option value="{{ booster.id }}" {{ booster.id == streakRewardBoosterId ? 'selected' }}>
                                                {{ booster.displayName }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    {# plain label + opacity while loading: swapping two spans
                                       leaves the hidden one hidden after the re-render #}
                                    <button type="button"
                                            data-action="live#action"
                                            data-live-action-param="chooseStreakReward"
                                            data-live-reward-id-param="{{ reward.id }}"
                                            data-loading="addAttribute(disabled) addClass(opacity-50)"
                                            data-testid="streak-reward-choice"
                                            class="btn btn-p btn-s max-md:w-full">
                                        Récupérer
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {% if streakError %}
                        <p class="chip chip-err w-full normal-case tracking-normal" data-testid="streak-error">⚠ {{ streakError }}</p>
                    {% elseif streakSuccess %}
                        <p class="chip chip-live w-full normal-case tracking-normal" data-testid="streak-success">✦ {{ streakSuccess }}</p>
                    {% endif %}
                </section>
            {% endif %}

            {# ----------------------------------------------------- Code redemption #}
            <section id="code" class="panel flex flex-col gap-3 px-5 py-4{{ codePrefilled ? ' hot' }}">
                <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <div class="flex flex-col gap-0.5">
                        <span class="d up text-[15px] tracking-[.08em] text-ink-strong">Un code booster ?</span>
                        {% if codePrefilled %}
                            <span class="text-sm text-magenta" data-testid="code-prefilled">🎁 Ton code est déjà saisi : valide-le pour récupérer tes packs.</span>
                        {% else %}
                            <span class="text-sm text-ink-muted">Les codes d'event et de giveaway ajoutent des packs sans toucher à tes gratuits.</span>
                        {% endif %}
                    </div>

                    <form data-action="live#action:prevent"
                          data-live-action-param="redeemCode"
                          class="flex w-full items-center gap-2 md:w-auto">
                        <label for="booster-code" class="sr">Code booster</label>
                        <input type="text"
                               id="booster-code"
                               data-model="norender|code"
                               value="{{ code }}"
                               placeholder="ABCD-EFGH-JKLM"
                               autocomplete="off"
                               spellcheck="false"
                               data-testid="code-input"
                               class="field hub-code min-w-0 flex-1 md:w-[220px] md:flex-none{{ codePrefilled ? ' hub-code--prefilled' }}">
                        {# plain label + opacity while loading: swapping two spans
                           leaves the hidden one hidden after the re-render #}
                        <button type="submit"
                                data-testid="code-submit"
                                data-loading="addAttribute(disabled) addClass(opacity-50)"
                                class="btn btn-g shrink-0">
                            Valider
                        </button>
                    </form>
                </div>

                {% if codeError %}
                    <p class="chip chip-err w-full normal-case tracking-normal" data-testid="code-error">⚠ {{ codeError }}</p>
                {% elseif codeSuccess %}
                    <p class="chip chip-live w-full normal-case tracking-normal" data-testid="code-success">✦ {{ codeSuccess }}</p>
                {% endif %}
            </section>

            {# ----------------------------------------------------- Shop #}
            {% set shopBoosters = this.shopBoosters %}
            {% if shopBoosters is not empty or purchaseError or purchaseSuccess %}
                <section id="boutique" class="panel flex flex-col gap-3 px-5 py-4" data-testid="shop">
                    <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-6">
                        <span class="d up text-[15px] tracking-[.08em] text-ink-strong"><span class="text-soon">¤</span> Boutique</span>
                        <span class="text-sm text-ink-muted">
                            Un pack par jour en Youl Coin, sans entamer tes récupérations gratuites : achète-le depuis sa tuile ci-dessous.
                            {% if this.remainingPurchases < 1 %}
                                Prochain achat dans <span data-controller="countdown" data-countdown-seconds-value="{{ this.secondsUntilReset }}" data-testid="shop-countdown">--:--:--</span>.
                            {% endif %}
                        </span>
                    </div>

                    {% if this.pendingPurchase %}
                        <p class="chip chip-soon w-full normal-case tracking-normal" data-testid="purchase-pending">
                            ⏳ Paiement en cours de vérification : ton pack arrivera dès que Youl Coin le confirme.
                        </p>
                    {% endif %}
                    {% if purchaseError %}
                        <p class="chip chip-err w-full normal-case tracking-normal" data-testid="purchase-error">⚠ {{ purchaseError }}</p>
                    {% elseif purchaseSuccess %}
                        <p class="chip chip-live w-full normal-case tracking-normal" data-testid="purchase-success">✦ {{ purchaseSuccess }}</p>
                    {% endif %}
                </section>
            {% endif %}

            {% if error %}
                <p class="chip chip-err w-full px-4 py-3 normal-case tracking-normal" data-testid="hub-error">⚠ {{ error }}</p>
            {% endif %}

            {# ----------------------------------------------------- Packs grid #}
            {% set boosters = this.boosters %}
            <section aria-labelledby="packs" class="flex flex-col gap-4">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <h2 id="packs" class="h2">Packs <span class="muted font-sans text-sm font-normal normal-case">{{ boosters|length }} disponible{{ boosters|length > 1 ? 's' }}</span></h2>
                    {% if boosters is not empty %}
                        {% set counts = this.filterCounts %}
                        {% set activeFilter = this.activeFilter %}
                        <div role="group" aria-label="Filtrer les packs" class="flex flex-wrap gap-2" data-testid="pack-filters">
                            {% for key, label in { tous: 'Tous', stock: 'En stock', incomplets: 'Univers incomplets' } %}
                                <button type="button"
                                        class="seg{{ activeFilter == key ? ' on' }}"
                                        aria-pressed="{{ activeFilter == key ? 'true' : 'false' }}"
                                        data-action="live#action"
                                        data-live-action-param="filterPacks"
                                        data-live-filter-param="{{ key }}"
                                        data-testid="pack-filter-{{ key }}">
                                    {{ label }} · {{ counts[key] }}
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {% if boosters is empty %}
                    <div class="panel border-dashed px-8 py-16 text-center text-ink-muted">
                        <p class="d up text-lg">Aucun pack.</p>
                        <p class="mt-3 text-sm">Reviens bientôt, de nouveaux univers arrivent.</p>
                    </div>
                {% else %}
                    {% set inventory = this.inventory %}
                    {% set drawableBoosterIds = this.drawableBoosterIds %}
                    {% set retrievableBoosterIds = this.retrievableBoosterIds %}
                    {% set shopBoosterIds = this.shopBoosterIds %}
                    {% set completion = this.completionByExtension %}
                    {% set filtered = this.filteredBoosters %}
                    {% if filtered is empty %}
                        <div class="panel px-6 py-10 text-center text-sm text-ink-muted" data-testid="pack-filter-empty">
                            {{ activeFilter == 'stock' ? 'Aucun pack en stock : récupère tes packs gratuits du jour.' : 'Tous les univers de tes packs sont complets. Bravo !' }}
                            <button type="button" class="tl ml-2" data-action="live#action" data-live-action-param="filterPacks" data-live-filter-param="tous">Voir tous les packs</button>
                        </div>
                    {% endif %}
                    <div class="pack-grid" data-testid="boosters-grid">
                        {% for booster in filtered %}
                            {% set owned = inventory[booster.id ~ '']|default(0) %}
                            {% set drawable = drawableBoosterIds[booster.id ~ '']|default(false) %}
                            {% set retrievable = booster.claimable and remainingClaims > 0 and retrievableBoosterIds[booster.id ~ '']|default(false) %}
                            {% set onSale = shopBoosterIds[booster.id ~ '']|default(false) %}
                            {% set universe = completion[booster.extension.id ~ '']|default(null) %}
                            <article class="pack{{ owned > 0 ? ' pack--has' }}" data-testid="booster-card">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="lbl min-w-0 truncate text-ink-strong" title="{{ booster.displayName }}">{{ booster.displayName }}</span>
                                    <span class="lbl shrink-0 px-2{{ owned > 0 ? ' bg-primary text-ink-strong' }}" data-testid="owned-count">{{ owned }} en stock</span>
                                </div>
                                {% if booster.extension.name not in booster.displayName %}
                                    <span class="lbl -mt-2 truncate">Cartes de {{ booster.extension.name }}</span>
                                {% endif %}

                                {# the pack front — same composite as the 3D opening pack, drawn into a canvas #}
                                <div class="pack__art">
                                    <canvas width="840" height="1300"
                                            data-controller="pack-front"
                                            data-pack-front-bg-url-value="{{ booster.imageName ? vich_uploader_asset(booster) : (booster.extension.imageName ? vich_uploader_asset(booster.extension) : '') }}"
                                            data-pack-front-fallback-url-value="{{ asset('images/ytcg_background.png') }}"
                                            data-pack-front-logo-url-value="{{ asset('images/ytcg_logo.png') }}"
                                            data-pack-front-name-value="{{ booster.displayName }}"
                                            data-pack-front-count-value="{{ booster.cardCount }}"
                                            {# custom booster image = full pack design: no text drawn on top #}
                                            data-pack-front-plain-value="{{ booster.imageName ? 'true' : 'false' }}"
                                            aria-label="Pack {{ booster.displayName }}" role="img"
                                            class="pack__canvas"></canvas>
                                </div>

                                {% if universe %}
                                    <div class="flex flex-col gap-1.5" data-testid="pack-completion">
                                        <span class="flex justify-between gap-2"><span class="text-sm text-ink-muted">Ta complétion</span><span class="mono text-xs text-ink-strong">{{ universe.owned }}/{{ universe.total }} · {{ universe.percentage }} %</span></span>
                                        <span class="bar" aria-hidden="true"><i style="width: {{ universe.percentage }}%"></i></span>
                                    </div>
                                {% endif %}

                                {# « Récupérer » and « Ouvrir » keep fixed slots: a click never turns the button under the pointer into another action #}
                                {% if not drawable %}
                                    <span class="btn btn-g btn-w" aria-disabled="true" title="Cette extension n'a pas encore de carte publiée.">À venir</span>
                                {% else %}
                                    <div class="pack__actions" data-testid="pack-actions">
                                        {% if not booster.claimable and onSale %}
                                            <span class="btn btn-g btn-s" aria-disabled="true" data-testid="shop-only">Boutique uniquement</span>
                                        {% elseif not booster.claimable %}
                                            <span class="btn btn-g btn-s" aria-disabled="true" data-testid="not-claimable"
                                                  title="Ce pack se gagne en event ou via un code — il n'est pas récupérable ici.">✕ Non récupérable</span>
                                        {% else %}
                                            <button type="button" class="btn {{ owned > 0 ? 'btn-g' : 'btn-p' }} btn-s"
                                                    data-testid="pack-claim"
                                                    {% if retrievable %}
                                                        data-action="live#action"
                                                        data-live-action-param="claimBooster"
                                                        data-live-booster-id-param="{{ booster.id }}"
                                                        data-loading="addAttribute(disabled) addClass(is-loading)"
                                                        aria-label="Récupérer un pack {{ booster.displayName }} ({{ remainingClaims }} gratuit{{ remainingClaims > 1 ? 's' }} restant{{ remainingClaims > 1 ? 's' }} aujourd'hui)"
                                                    {% else %}
                                                        disabled
                                                        title="{{ remainingClaims > 0 ? 'Ce pack ne peut pas être récupéré pour le moment.' : 'Plus de pack gratuit aujourd\'hui : reviens demain.' }}"
                                                    {% endif %}>Récupérer <span class="pack__count" data-testid="pack-claims-left">{{ remainingClaims }}</span></button>
                                        {% endif %}
                                        {% if owned > 0 %}
                                            <a href="{{ path('booster_open', {id: booster.id}) }}" class="btn btn-p btn-s" data-testid="pack-open"
                                               aria-label="Ouvrir un pack {{ booster.displayName }} ({{ owned }} en stock)">Ouvrir · {{ owned }}</a>
                                        {% else %}
                                            <span class="btn btn-g btn-s" aria-disabled="true" data-testid="pack-open"
                                                  title="Aucun pack {{ booster.displayName }} en stock">Ouvrir · 0</span>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {% if onSale %}
                                    {% set block = this.purchaseBlock(booster) %}
                                    <div class="flex items-center justify-between gap-2" data-testid="shop-item">
                                        <span class="lbl" title="Prix en Youl Coin"><span class="text-soon">¤</span> <span data-testid="shop-price">{{ coin_amount(booster.purchasePrice) }} YLC</span></span>
                                        {% if block %}
                                            <button type="button" disabled data-testid="shop-buy" class="tl cursor-not-allowed no-underline opacity-70">{{ block }}</button>
                                        {% elseif confirmingPurchaseBoosterId == booster.id %}
                                            <span class="flex shrink-0 gap-1.5">
                                                <button type="button" data-action="live#action" data-live-action-param="confirmPurchase" data-live-booster-id-param="{{ booster.id }}"
                                                        data-loading="addAttribute(disabled) addClass(opacity-50)" data-testid="shop-confirm"
                                                        class="btn btn-p btn-s">Confirmer</button>
                                                <button type="button" data-action="live#action" data-live-action-param="cancelPurchase" data-testid="shop-cancel"
                                                        aria-label="Annuler l'achat" class="ib">✕</button>
                                            </span>
                                        {% else %}
                                            <button type="button" data-action="live#action" data-live-action-param="askPurchase" data-live-booster-id-param="{{ booster.id }}"
                                                    data-testid="shop-buy" class="btn btn-g btn-s">Acheter</button>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {# bottom line: claimable on top of the stock / left to find, then « Taux » #}
                                <div class="pack__foot">
                                    {% if universe and universe.owned >= universe.total %}
                                        <span class="text-xs text-live">✓ Univers complet</span>
                                    {% elseif universe %}
                                        {% set missing = universe.total - universe.owned %}
                                        <span class="text-xs {{ missing == 1 ? 'text-magenta' : 'text-ink-muted' }}">{{ missing == 1 ? 'Plus qu\'une carte à trouver' : missing ~ ' cartes à trouver' }}</span>
                                    {% else %}
                                        <span></span>
                                    {% endif %}

                                    {# drop rates: native details/summary, no JS — the panel overlays the pack #}
                                    {% if booster.cardCount > 0 %}
                                        <details class="booster-rates">
                                            <summary class="tl" data-testid="drop-rates-toggle">Taux</summary>
                                            <div class="booster-rates__panel" data-testid="drop-rates-panel">
                                                <p class="lbl mb-2 text-ink-strong">Taux par carte</p>
                                                {% for slot in booster.dropRates %}
                                                    <div class="mb-1.5 flex flex-wrap items-baseline gap-x-2 font-mono text-[11px]">
                                                        <span class="text-ink-muted">Carte {{ loop.index }} ·</span>
                                                        {% for rarity, rate in slot.rates %}
                                                            <span class="r-{{ rarity|first }}">{{ rarity_icon(rarity) }} {{ rarity_label(rarity) }} {{ rate == rate|round ? rate|round : rate }}%</span>
                                                        {% endfor %}
                                                        {% if slot.holoChance > 0 %}
                                                            <span class="text-magenta">✦ Holo {{ slot.holoChance }}%</span>
                                                        {% endif %}
                                                        {% if slot.uniqueChance > 0 %}
                                                            <span class="text-soon" title="Chance de tirer une carte unique 1/1 encore non réclamée">{{ unique_icon() }} Unique 1/1 · {{ slot.uniqueRate == slot.uniqueRate|round ? slot.uniqueRate|round : slot.uniqueRate }}%</span>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </details>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>
</div>

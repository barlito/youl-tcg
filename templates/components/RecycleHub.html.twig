<div {{ attributes }}>
    <main>
        {# ------------------------------------------------ Hero / recyclables #}
        <section class="relative border-b border-hairline px-6 py-10 lg:px-12">
            <div class="glow-ambient" aria-hidden="true"></div>
            <div class="relative mx-auto flex max-w-7xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="eyebrow">Recyclage</p>
                    <h1 class="mt-2 font-display text-4xl font-bold uppercase tracking-[-0.04em] text-ink-strong md:text-5xl">
                        Recycle tes doublons
                    </h1>
                    <p class="mt-2 max-w-lg text-sm text-ink-muted">
                        Échange tes copies en trop contre des packs : chaque tranche de {{ this.cost }} points = 1 pack,
                        tous du modèle que tu choisis ({{ 2 * this.cost }} pts → 2 packs). Le reste sous {{ this.cost }} points est perdu,
                        et tu gardes toujours au moins un exemplaire de chaque carte.
                    </p>
                    <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[11px]" data-testid="recycle-scale">
                        {% for rarity in this.scale %}
                            <span style="color: var(--rarity-{{ rarity.value }});">{{ rarity.label }} {{ rarity.recyclePoints }} pt{{ rarity.recyclePoints > 1 ? 's' }}</span>
                        {% endfor %}
                        <span class="text-magenta">✦ Holo +1 pt</span>
                    </div>
                </div>

                <div class="border border-primary/50 bg-surface px-5 py-4 shadow-[0_0_24px_#a435f033]" data-testid="recyclable-total">
                    <p class="chip-mono text-ink-muted">Dans ta collection</p>
                    <p class="mt-1 font-display text-4xl font-bold leading-none tracking-[-0.04em] text-primary [text-shadow:0_0_14px_#a435f077]">
                        {{ this.recyclableTotal }}
                    </p>
                    <p class="mt-1 font-display text-xs font-bold uppercase tracking-[.1em] text-ink-strong">
                        exemplaire{{ this.recyclableTotal > 1 ? 's' }} recyclable{{ this.recyclableTotal > 1 ? 's' }}
                    </p>
                    {% if this.maxPointsTotal > 0 %}
                        <p class="chip-mono mt-2 text-ink-dim">
                            Jusqu'à {{ this.maxPointsTotal }} pts · {{ (this.maxPointsTotal / this.cost)|round(0, 'floor') }} pack{{ this.maxPointsTotal >= 2 * this.cost ? 's' }}
                        </p>
                    {% endif %}
                </div>
            </div>
        </section>

        {% if error %}
            <div class="mx-auto mt-6 max-w-7xl px-6 lg:px-12">
                <div class="border border-magenta/50 bg-magenta/10 px-4 py-3 font-mono text-xs text-magenta" data-testid="recycle-error">
                    ⚠ {{ error }}
                </div>
            </div>
        {% elseif success %}
            <div class="mx-auto mt-6 max-w-7xl px-6 lg:px-12">
                <div class="border border-live/50 bg-live/10 px-4 py-3 font-mono text-xs text-live" data-testid="recycle-success">
                    ♻ {{ success }}
                </div>
            </div>
        {% endif %}

        {% if not this.hasRows %}
            <section class="px-6 pb-24 pt-10 lg:px-12">
                <div class="mx-auto max-w-7xl border border-dashed border-hairline px-8 py-20 text-center text-ink-dim" data-testid="recycle-empty">
                    <p class="font-display text-lg font-bold uppercase tracking-[.15em]">Aucun doublon.</p>
                    <p class="mt-3 text-sm">Rien à recycler pour l'instant — seules les copies en double se recyclent, ta collection reste intacte.</p>
                    <a href="{{ path('boosters') }}" class="btn-arcade mt-8">Ouvrir un pack ▸</a>
                </div>
            </section>
        {% else %}
            {% set activeExtension = this.activeExtension %}
            {{ include('parts/_completion_strip.html.twig', {
                strip: this.strip,
                currentExtension: activeExtension,
                route: 'recycle',
                slugParam: 'univers',
                liveAction: 'filterUniverse',
                presorted: true,
                eyebrow: 'Doublons par univers',
                allStat: this.recyclableTotal ~ '',
                allCaption: 'recyclable' ~ (this.recyclableTotal > 1 ? 's'),
                allBar: null,
            }) }}

            {# ------------------------------------------------------ Doublons #}
            <section class="px-6 pb-12 pt-8 lg:px-12">
                <div class="mx-auto max-w-7xl">
                    <h2 class="mb-6 font-display text-sm font-bold uppercase tracking-[.1em] text-ink-strong">
                        1 · Choisis les copies à recycler
                    </h2>

                    {% for group in this.visibleUniverses %}
                        <div class="mb-12" data-testid="recycle-universe">
                            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                                <h3 class="font-display text-sm font-bold uppercase tracking-[.1em] text-ink-strong">
                                    {{ group.extension.name }}
                                </h3>
                                <span class="chip-mono text-primary" data-testid="universe-recyclable">
                                    ♻ {{ group.recyclable }} recyclable{{ group.recyclable > 1 ? 's' }}
                                </span>
                                <span class="chip-mono text-ink-dim">
                                    {{ group.rows|length }} carte{{ group.rows|length > 1 ? 's' }} · jusqu'à {{ group.maxPoints }} pts
                                </span>
                            </div>

                            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3" data-testid="recycle-grid">
                                {% for row in group.rows %}
                                    {% set card = row.card %}
                                    {% set sel = this.selectionFor(card.id) %}
                                    {% set totalSelected = sel.normal + sel.holo %}
                                    {% set recyclable = this.recyclableCopies(row) %}
                                    {% set normalCap = this.normalCap(row) %}
                                    {% set holoCap = this.holoCap(row) %}
                                    {% set canAddMore = totalSelected < recyclable %}
                                    <article class="relative flex flex-col border bg-surface p-4 transition-colors {{ totalSelected > 0 ? 'border-primary/70 shadow-[0_0_14px_#a435f033]' : 'border-hairline' }}"
                                             data-testid="recycle-card">
                                        {# recyclable copies badge: the tile's headline figure #}
                                        <span class="chip-mono absolute -right-2 -top-2 px-2 py-1 font-bold {{ totalSelected > 0 ? 'bg-gradient-to-r from-primary to-magenta text-black' : 'border border-primary bg-black text-primary' }}"
                                              data-testid="recyclable-badge">
                                            {% if totalSelected > 0 %}♻ {{ totalSelected }}/{{ recyclable }}{% else %}♻ {{ recyclable }} recyclable{{ recyclable > 1 ? 's' }}{% endif %}
                                        </span>

                                        <div class="flex items-start gap-3">
                                            <img src="{{ vich_uploader_asset(card) }}" alt="{{ card.name }}" loading="lazy" decoding="async"
                                                 onerror="this.onerror=null;this.src='{{ asset('images/default_card.png') }}';"
                                                 class="h-24 w-auto shrink-0 border border-hairline object-cover">
                                            <div class="min-w-0 pr-6">
                                                <h4 class="truncate font-display text-sm font-bold uppercase leading-tight text-ink-strong" title="{{ card.name }}">
                                                    {{ card.name }}
                                                </h4>
                                                <p class="chip-mono mt-1" style="color: var(--rarity-{{ card.rarity.value }});">{{ card.rarity.label }}</p>
                                                <p class="chip-mono mt-1.5 text-ink-dim">
                                                    ×{{ row.quantity }}{% if row.holoQuantity > 0 %} dont ✦{{ row.holoQuantity }}{% endif %} · 1 gardée
                                                </p>
                                            </div>
                                        </div>

                                        <div class="mt-3 flex flex-col gap-2 border-t border-hairline pt-3">
                                            {% if normalCap > 0 %}
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="chip-mono text-ink-muted">Normale · {{ card.rarity.recyclePoints }} pt{{ card.rarity.recyclePoints > 1 ? 's' }}</span>
                                                    <div class="flex items-center gap-1.5">
                                                        <button type="button" aria-label="Retirer une copie normale de {{ card.name }}"
                                                                data-action="live#action"
                                                                data-live-action-param="removeCopy"
                                                                data-live-card-id-param="{{ card.id }}"
                                                                data-live-kind-param="normal"
                                                                {{ sel.normal == 0 ? 'disabled' }}
                                                                class="border border-hairline px-2.5 py-0.5 font-mono text-sm text-ink-muted transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-30">−</button>
                                                        <span class="w-10 text-center font-mono text-sm font-bold {{ sel.normal > 0 ? 'text-primary' : 'text-ink-dim' }}" data-testid="normal-count">{{ sel.normal }}<span class="text-[10px] font-normal text-ink-dim">/{{ normalCap }}</span></span>
                                                        <button type="button" aria-label="Recycler une copie normale de {{ card.name }}"
                                                                data-action="live#action"
                                                                data-live-action-param="addCopy"
                                                                data-live-card-id-param="{{ card.id }}"
                                                                data-live-kind-param="normal"
                                                                data-testid="add-normal"
                                                                {{ (not canAddMore or sel.normal >= normalCap) ? 'disabled' }}
                                                                class="border border-hairline px-2.5 py-0.5 font-mono text-sm text-ink-muted transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-30">+</button>
                                                    </div>
                                                </div>
                                            {% endif %}
                                            {% if holoCap > 0 %}
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="chip-mono text-magenta">✦ Holo · {{ card.rarity.holoRecyclePoints }} pts</span>
                                                    <div class="flex items-center gap-1.5">
                                                        <button type="button" aria-label="Retirer une copie holo de {{ card.name }}"
                                                                data-action="live#action"
                                                                data-live-action-param="removeCopy"
                                                                data-live-card-id-param="{{ card.id }}"
                                                                data-live-kind-param="holo"
                                                                {{ sel.holo == 0 ? 'disabled' }}
                                                                class="border border-hairline px-2.5 py-0.5 font-mono text-sm text-ink-muted transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-30">−</button>
                                                        <span class="w-10 text-center font-mono text-sm font-bold {{ sel.holo > 0 ? 'text-magenta' : 'text-ink-dim' }}" data-testid="holo-count">{{ sel.holo }}<span class="text-[10px] font-normal text-ink-dim">/{{ holoCap }}</span></span>
                                                        <button type="button" aria-label="Recycler une copie holo de {{ card.name }}"
                                                                data-action="live#action"
                                                                data-live-action-param="addCopy"
                                                                data-live-card-id-param="{{ card.id }}"
                                                                data-live-kind-param="holo"
                                                                data-testid="add-holo"
                                                                {{ (not canAddMore or sel.holo >= holoCap) ? 'disabled' }}
                                                                class="border border-hairline px-2.5 py-0.5 font-mono text-sm text-ink-muted transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-30">+</button>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# ------------------------------------------ Barre de validation #}
            {# sticky at the bottom of the component: points, pack and confirm stay in reach while scrolling #}
            <div class="sticky bottom-0 z-30 border-t border-primary/50 bg-bg/95 px-4 py-2.5 shadow-[0_-8px_24px_#0b0712] backdrop-blur md:px-12 md:py-3"
                 data-testid="recycle-bar">
                <div class="mx-auto flex max-w-7xl flex-col gap-2 md:flex-row md:items-center md:gap-6">
                    <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4" data-testid="points-counter">
                        <p class="shrink-0 font-display text-2xl font-bold leading-none text-ink-strong md:text-3xl">
                            {{ this.points }}<span class="ml-1 font-mono text-xs font-normal text-ink-muted">pts</span>
                        </p>
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-display text-xs font-bold uppercase tracking-[.1em] {{ this.boosterCount > 0 ? 'text-primary' : 'text-ink-muted' }}" data-testid="recycle-outcome">
                                {% if this.boosterCount > 0 %}
                                    → {{ this.boosterCount }} booster{{ this.boosterCount > 1 ? 's' }}{% if this.lostPoints > 0 %}<span class="text-soon">, {{ this.lostPoints }} pt{{ this.lostPoints > 1 ? 's' }} perdu{{ this.lostPoints > 1 ? 's' }}</span>{% endif %}
                                {% else %}
                                    Encore {{ this.cost - this.points }} pt{{ this.cost - this.points > 1 ? 's' }} pour 1 booster
                                {% endif %}
                            </p>
                            <div class="mt-1.5 h-1.5 border border-hairline bg-bg" aria-hidden="true">
                                <div class="h-full bg-gradient-to-r from-primary to-magenta shadow-[0_0_10px_#a435f0]"
                                     style="width: {{ (this.lostPoints / this.cost * 100)|round }}%;"></div>
                            </div>
                            <p class="chip-mono mt-1 hidden truncate text-ink-dim sm:block">
                                {{ this.selectedCopies }} copie{{ this.selectedCopies > 1 ? 's' }} · {{ this.lostPoints }}/{{ this.cost }} vers le {{ this.boosterCount > 0 ? 'suivant' : 'premier' }}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        {% if this.boosters is empty %}
                            <p class="chip-mono text-ink-dim">Aucun pack disponible pour le moment.</p>
                        {% else %}
                            <label class="sr-only" for="recycle-booster">Pack à recevoir</label>
                            <select id="recycle-booster"
                                    data-model="boosterId"
                                    data-testid="booster-choice"
                                    class="min-w-0 flex-1 border border-hairline bg-surface px-3 py-2.5 font-display text-xs font-bold uppercase tracking-[.08em] text-ink-strong focus:border-primary focus:outline-none md:w-60 md:flex-none">
                                <option value="" {{ boosterId is null or this.selectedBooster is null ? 'selected' }}>2 · Choisis ton pack</option>
                                {% for booster in this.boosters %}
                                    <option value="{{ booster.id }}" {{ boosterId == (booster.id ~ '') ? 'selected' }}>
                                        {{ booster.displayName }}{{ booster.extension.name not in booster.displayName ? ' — ' ~ booster.extension.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}

                        {# plain label + opacity while loading: swapping two spans
                           leaves the hidden one hidden after the re-render #}
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="recycle"
                                data-loading="addClass(opacity-50)"
                                data-testid="recycle-confirm"
                                {{ this.boosterCount < 1 ? 'disabled' }}
                                class="shrink-0 border border-primary bg-primary px-4 py-2.5 font-display text-xs font-bold uppercase tracking-[.12em] text-black transition hover:bg-transparent hover:text-primary disabled:cursor-not-allowed disabled:border-hairline disabled:bg-surface disabled:text-ink-dim">
                            ♻ Recycler{% if this.boosterCount > 0 %}<span class="hidden sm:inline"> contre</span> {{ this.boosterCount }} pack{{ this.boosterCount > 1 ? 's' }}{% endif %}
                        </button>
                    </div>
                </div>
                <p class="chip-mono mx-auto mt-2 hidden max-w-7xl text-ink-dim md:block">Hors quota quotidien · irréversible</p>
            </div>
        {% endif %}
    </main>
</div>

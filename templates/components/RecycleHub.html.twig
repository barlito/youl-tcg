<div {{ attributes }}>
    {% set points = this.points %}
    {% set cost = this.cost %}
    <main>
        {% embed 'parts/ui/_page_header.html.twig' with {
            eyebrow: 'Mon espace',
            title: 'Recycle tes doublons',
            lead: cost ~ ' points de doublons = 1 pack de ton choix, une fois par jour. Tu gardes toujours au moins un exemplaire de chaque carte.',
        } %}
            {% block nav %}{{ include('parts/ui/_my_space_nav.html.twig', { current: 'recycle' }) }}{% endblock %}
        {% endembed %}

        <div class="wrap recycle-layout pb-24 pt-6 md:pt-8">
            <div class="flex min-w-0 flex-col gap-[18px]">
                {% if this.hasRecycledToday %}
                    <div class="panel flash-msg text-soon" role="status" data-testid="recycle-daily-done">
                        ♻ Tu as déjà recyclé aujourd'hui : une seule opération par jour. Prochain recyclage possible dans
                        <span data-controller="countdown" data-countdown-seconds-value="{{ this.secondsUntilReset }}">--:--:--</span>
                        (minuit, heure de Paris).
                    </div>
                {% endif %}

                {% if error %}
                    <div class="panel flash-msg flash-msg--err" role="alert" data-testid="recycle-error">⚠ {{ error }}</div>
                {% elseif success %}
                    <div class="panel flash-msg flash-msg--ok" role="status" data-testid="recycle-success">♻ {{ success }}</div>
                {% endif %}

                {% if not this.hasRows %}
                    <div class="panel flex flex-col items-center gap-2.5 border-dashed px-6 py-16 text-center" data-testid="recycle-empty">
                        <span class="d up text-lg text-ink-strong">Aucun doublon</span>
                        <span class="muted max-w-[46ch]">Rien à recycler pour l'instant : seules les copies en double se recyclent, ta collection reste intacte.</span>
                        <a href="{{ path('boosters') }}" class="btn btn-p btn-s mt-2">Ouvrir un pack</a>
                    </div>
                {% else %}
                    {% set activeExtension = this.activeExtension %}
                    <div class="flex flex-wrap items-center gap-2" data-testid="recycle-filters">
                        <label class="sr" for="recycle-universe">Univers</label>
                        <select id="recycle-universe" data-model="universe" class="dd dd-select{{ activeExtension ? ' on' }} recycle-filters__universe" data-testid="filter-universe">
                            <option value="">Univers : tous · {{ this.recyclableTotal }}</option>
                            {% for group in this.universes %}
                                <option value="{{ group.extension.slug }}" {{ activeExtension and activeExtension.slug == group.extension.slug ? 'selected' }}>{{ group.extension.name }} · {{ group.recyclable }}</option>
                            {% endfor %}
                        </select>
                        <label class="sr" for="recycle-rarity">Rareté</label>
                        <select id="recycle-rarity" data-model="rarity" class="dd dd-select{{ this.activeRarity ? ' on' }}" data-testid="filter-rarity">
                            <option value="">Rareté : toutes</option>
                            {% for rarity in this.scale|reverse %}
                                <option value="{{ rarity.value }}" {{ this.activeRarity == rarity ? 'selected' }}>{{ rarity.icon }} {{ rarity.label }}</option>
                            {% endfor %}
                        </select>
                        <button type="button" class="seg{{ holoOnly ? ' on' }}" aria-pressed="{{ holoOnly ? 'true' : 'false' }}"
                                data-action="live#action" data-live-action-param="toggleHoloOnly" data-testid="filter-holo">✦ Holos seulement</button>
                        {% if this.hasActiveFilters %}
                            <button type="button" class="tl ml-1" data-action="live#action" data-live-action-param="resetFilters" data-testid="reset-filters">Tout effacer</button>
                        {% endif %}
                    </div>

                    <div class="panel flex flex-wrap gap-x-[18px] gap-y-1.5 px-3.5 py-2.5 text-[13px]" data-testid="recycle-scale">
                        <span class="lbl">Barème</span>
                        {% for rarity in this.scale %}
                            <span class="r-{{ rarity.value|first }}">{{ rarity.icon }} {{ rarity.label }} {{ rarity.recyclePoints }} pt{{ rarity.recyclePoints > 1 ? 's' }}</span>
                        {% endfor %}
                        <span class="text-magenta">✦ Holo +1 pt</span>
                    </div>

                    <p class="muted text-[13px]" data-testid="recyclable-total">
                        <span class="mono text-ink-strong" data-testid="recyclable-count">{{ this.recyclableTotal }}</span>
                        exemplaire{{ this.recyclableTotal > 1 ? 's' }} recyclable{{ this.recyclableTotal > 1 ? 's' }}
                        {%- if this.maxPointsTotal > 0 %} · jusqu'à {{ this.maxPointsTotal }} pts{% endif %}
                    </p>

                    {% for group in this.visibleUniverses %}
                        <section class="flex flex-col gap-3" data-testid="recycle-universe" aria-labelledby="recycle-u-{{ group.extension.id }}">
                            <h2 id="recycle-u-{{ group.extension.id }}" class="h2 text-lg">
                                {{ group.extension.name }}
                                <span class="muted font-sans text-sm font-normal normal-case" data-testid="universe-recyclable">· {{ group.recyclable }} recyclable{{ group.recyclable > 1 ? 's' }}</span>
                            </h2>
                            <div class="recycle-grid" data-testid="recycle-grid">
                                {% for row in group.rows %}
                                    {{ _self.row(this, row) }}
                                {% endfor %}
                            </div>
                        </section>
                    {% else %}
                        <div class="panel flex flex-col items-center gap-2 border-dashed px-6 py-10 text-center" data-testid="recycle-no-match">
                            <span class="muted">Aucun doublon ne correspond à ces filtres.</span>
                            <button type="button" class="tl" data-action="live#action" data-live-action-param="resetFilters">Tout effacer</button>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {% if this.hasRows %}
                {# sticky: points, pack and confirm stay in reach (right column on desktop, bottom bar on mobile) #}
                <aside class="panel hot recycle-panel sticky" aria-label="Ton recyclage" data-testid="recycle-bar">
                    <span class="lbl recycle-panel__title text-ink">Ton recyclage du jour</span>
                    <div class="recycle-panel__score" data-testid="points-counter">
                        <span class="d recycle-panel__points">{{ points }}</span>
                        <span class="d muted recycle-panel__cost">/ {{ cost }} pts</span>
                    </div>
                    <div class="bar recycle-panel__bar" aria-hidden="true"><i style="width: {{ (min(points, cost) / cost * 100)|round }}%"></i></div>
                    <p class="muted recycle-panel__hint text-[13px]" data-testid="recycle-outcome">
                        {%- if this.boosterCount > 0 -%}
                            → 1 booster{% if this.lostPoints > 0 %}<span class="text-soon">, {{ this.lostPoints }} pt{{ this.lostPoints > 1 ? 's' }} perdu{{ this.lostPoints > 1 ? 's' }}</span>{% endif %}
                        {%- else -%}
                            Encore {{ cost - points }} pt{{ cost - points > 1 ? 's' }} pour 1 booster
                        {%- endif -%}
                    </p>
                    <p class="muted recycle-panel__more text-[13px]">
                        {{ this.selectedCopies }} copie{{ this.selectedCopies > 1 ? 's' }} sélectionnée{{ this.selectedCopies > 1 ? 's' }}. Les points au-delà de {{ cost }} sont perdus.
                    </p>
                    <button type="button" class="btn btn-g btn-s recycle-panel__auto"
                            data-action="live#action" data-live-action-param="autoComplete"
                            data-loading="addAttribute(disabled)"
                            data-testid="recycle-autofill"
                            {{ (points >= cost or this.hasRecycledToday) ? 'disabled' }}>Compléter automatiquement</button>
                    <div class="recycle-panel__pack">
                        {% if this.boosters is empty %}
                            <p class="muted text-[13px]">Aucun pack disponible pour le moment.</p>
                        {% else %}
                            <label for="recycle-booster" class="lbl recycle-panel__pack-label">Pack à recevoir</label>
                            <select id="recycle-booster" data-model="boosterId" data-testid="booster-choice" class="field dd-select w-full">
                                <option value="" {{ boosterId is null or this.selectedBooster is null ? 'selected' }}>Choisis ton pack</option>
                                {% for booster in this.boosters %}
                                    <option value="{{ booster.id }}" {{ boosterId == (booster.id ~ '') ? 'selected' }}>
                                        {{ booster.displayName }}{{ booster.extension.name not in booster.displayName ? ' — ' ~ booster.extension.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>
                    {# plain label + opacity while loading: swapping two spans leaves the hidden one hidden after the re-render #}
                    <button type="button" class="btn btn-p btn-w recycle-panel__confirm"
                            data-action="live#action" data-live-action-param="recycle"
                            data-loading="addAttribute(disabled) addClass(opacity-50)"
                            data-testid="recycle-confirm"
                            {{ (this.boosterCount < 1 or this.hasRecycledToday) ? 'disabled' }}>
                        {%- if this.boosterCount > 0 -%}
                            ♻ Recycler contre 1 pack
                        {%- else -%}
                            Recycler · {{ cost - points }} pt{{ cost - points > 1 ? 's' }} manquant{{ cost - points > 1 ? 's' }}
                        {%- endif -%}
                    </button>
                    <span class="lbl recycle-panel__rule text-center">1 recyclage par jour · irréversible</span>
                </aside>
            {% endif %}
        </div>
    </main>
</div>

{% macro row(hub, row) %}
    {% set card = row.card %}
    {% set sel = hub.selectionFor(card.id) %}
    {% set totalSelected = sel.normal + sel.holo %}
    {% set recyclable = hub.recyclableCopies(row) %}
    {% set normalCap = hub.normalCap(row) %}
    {% set holoCap = hub.holoCap(row) %}
    {% set engaged = hub.isEngaged(row) %}
    {% set listed = hub.isListed(row) %}
    <article class="panel recycle-row{{ totalSelected > 0 ? ' hot' }}" data-testid="recycle-card"{% if engaged %} data-engaged="true"{% endif %}>
        {{ include('parts/ui/_card_thumb.html.twig', { card: card, holo: row.holoQuantity > 0 }, with_context = false) }}
        <div class="flex min-w-0 flex-col gap-[3px]">
            <span class="cn" title="{{ card.name }}">{{ card.name }}</span>
            <span class="lbl r-{{ card.rarity.value|first }}">{{ card.rarity.icon }} {{ card.rarity.label }} · {{ card.rarity.recyclePoints }} pt{{ card.rarity.recyclePoints > 1 ? 's' }}</span>
            {% if engaged %}
                <span class="chip chip-soon self-start" data-testid="engaged-badge">{{ listed ? '¤ en vente' : '⇄ engagée dans un échange' }}</span>
                <span class="muted text-xs" data-testid="engaged-notice">
                    {{ listed ? 'Non recyclable tant qu\'une copie est en vente.' : 'Non recyclable tant que tu la proposes dans un échange.' }}
                </span>
            {% else %}
                <span class="muted text-xs" data-testid="recyclable-badge">
                    ×{{ row.quantity }}{% if row.holoQuantity > 0 %} <span class="text-magenta">dont ✦ {{ row.holoQuantity }}</span>{% endif %} · {{ totalSelected > 0 ? 'tu en gardes ' ~ (row.quantity - totalSelected) : recyclable ~ ' recyclable' ~ (recyclable > 1 ? 's') }}
                </span>
            {% endif %}
        </div>
        {% if not engaged %}
            <div class="recycle-row__steppers">
                {% if normalCap > 0 %}
                    {{ _self.stepper(card, 'normal', sel.normal, normalCap, holoCap > 0 ? 'Normale' : null,
                        totalSelected >= recyclable or sel.normal >= normalCap or not hub.canAddCopy(row, 'normal')) }}
                {% endif %}
                {% if holoCap > 0 %}
                    {{ _self.stepper(card, 'holo', sel.holo, holoCap, '✦ Holo',
                        totalSelected >= recyclable or sel.holo >= holoCap or not hub.canAddCopy(row, 'holo')) }}
                {% endif %}
            </div>
        {% endif %}
    </article>
{% endmacro %}

{% macro stepper(card, kind, selected, cap, label, addDisabled) %}
    {% set kindLabel = kind == 'holo' ? 'holo' : 'normale' %}
    <div class="recycle-stepper{{ kind == 'holo' ? ' recycle-stepper--holo' }}">
        {% if label %}<span class="recycle-stepper__label">{{ label }}</span>{% endif %}
        <button type="button" class="ib recycle-stepper__btn" aria-label="Retirer une copie {{ kindLabel }} de {{ card.name }}"
                data-action="live#action" data-live-action-param="removeCopy"
                data-live-card-id-param="{{ card.id }}" data-live-kind-param="{{ kind }}"
                {{ selected == 0 ? 'disabled' }}>−</button>
        <span class="mono recycle-stepper__count{{ selected > 0 ? ' is-on' }}" data-testid="{{ kind }}-count">{{ selected }}<span class="recycle-stepper__cap">/{{ cap }}</span></span>
        <button type="button" class="ib recycle-stepper__btn" aria-label="Recycler une copie {{ kindLabel }} de {{ card.name }}"
                data-action="live#action" data-live-action-param="addCopy"
                data-live-card-id-param="{{ card.id }}" data-live-kind-param="{{ kind }}"
                data-testid="add-{{ kind }}"
                {{ addDisabled ? 'disabled' }}>+</button>
    </div>
{% endmacro %}

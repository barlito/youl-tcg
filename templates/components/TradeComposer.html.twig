<div {{ attributes.defaults({ class: 'composer' }) }}>
    {% set theirName = this.counterpart.username %}
    {% set offeredSummary = this.summary('offered') %}
    {% set requestedSummary = this.summary('requested') %}
    {% set activeExtension = this.activeExtension %}

    <div class="wrap flex flex-col gap-4 pb-10 pt-5">
        {% if error %}
            <div class="panel flash-msg flash-msg--err" role="alert" data-testid="composer-error">⚠ {{ error }}</div>
        {% endif %}

        {# -------------------------------------------- Univers + recherche #}
        <div class="composer-toolbar">
            <label for="composer-universe" class="lbl max-md:sr-only">Univers</label>
            <select id="composer-universe" class="dd dd-select composer-toolbar__universe" data-model="universe" data-testid="composer-universe">
                <option value=""{{ activeExtension is null ? ' selected' }}>Tous les univers · {{ this.myTotal }} ⇄ {{ this.theirTotal }}</option>
                {% for option in this.universeOptions %}
                    <option value="{{ option.extension.slug }}"{{ activeExtension and activeExtension.id == option.extension.id ? ' selected' }}>
                        {{- option.extension.name }} · {{ option.mine }} ⇄ {{ option.theirs -}}
                    </option>
                {% endfor %}
            </select>
            <span class="muted text-[13px] max-xl:hidden">tes cartes ⇄ celles de {{ theirName }}</span>
            <label for="composer-search" class="sr">Rechercher une carte</label>
            <input id="composer-search" type="search"
                   class="field composer-toolbar__search"
                   data-model="debounce(300)|search"
                   value="{{ search }}"
                   placeholder="Rechercher une carte…"
                   data-testid="composer-search">
        </div>
        {% if this.hasMaskedCards %}
            <p class="muted text-[13px]" data-testid="masking-hint">
                Carte inconnue = carte que tu n'as pas encore : seule sa rareté est visible, la recherche l'ignore.
            </p>
        {% endif %}

        {# ------------------------------------ Onglets (mobile seulement) #}
        <div class="composer-tabs lg:hidden" role="tablist" aria-label="Côté de l'offre" data-testid="composer-tabs">
            {{ _self.tab('offered', 'Tu proposes', this.offeredCount, tab) }}
            {{ _self.tab('requested', 'Tu demandes', this.requestedCount, tab) }}
        </div>

        <div class="grid items-start gap-8 lg:grid-cols-2">
            {{ _self.column(
                'offered',
                'Tu proposes',
                this.myGroups,
                this.myVisibleCount,
                this.myTotal,
                'libre',
                tab,
                offered,
                'Aucun exemplaire disponible : tes cartes sont peut-être déjà engagées dans d\'autres offres.',
                this.chips('offered'),
                { theirName: theirName, wishlist: this.wishlistEnabled }
            ) }}
            {{ _self.column(
                'requested',
                'Tu demandes à ' ~ theirName,
                this.theirGroups,
                this.theirVisibleCount,
                this.theirTotal,
                '',
                tab,
                requested,
                theirName ~ ' n\'a aucune carte pour l\'instant.',
                this.chips('requested'),
                { theirName: theirName, wishlist: this.wishlistEnabled }
            ) }}
        </div>
    </div>

    {# ------------------------------------------------ Récapitulatif collant #}
    <div class="composer-bar" data-testid="composer-bar">
        {% if offeredSummary.lastCopies > 0 %}
            <p class="wrap composer-bar__warning" data-testid="last-copy-warning">
                ⚠ Ton offre contient {{ offeredSummary.lastCopies > 1 ? offeredSummary.lastCopies ~ ' derniers exemplaires' : 'un dernier exemplaire' }} : tu n'en auras plus après l'échange.
            </p>
        {% endif %}
        <div class="wrap composer-bar__inner">
            <div class="composer-bar__summary" data-testid="composer-summary">
                {{ _self.recap('Tu donnes', offeredSummary, 'offered') }}
                <span class="d composer-bar__swap" aria-hidden="true">⇄</span>
                {{ _self.recap('Tu reçois', requestedSummary, 'requested') }}
            </div>
            <div class="composer-bar__actions">
                {% if offeredSummary.copies + requestedSummary.copies > 0 %}
                    <button type="button" class="tl composer-bar__clear"
                            data-action="live#action"
                            data-live-action-param="clear"
                            data-testid="clear-offer">Vider</button>
                {% endif %}
                <button type="button" class="btn btn-p composer-bar__submit"
                        data-action="live#action"
                        data-live-action-param="submit"
                        data-loading="addAttribute(disabled)"
                        data-testid="submit-offer"
                        {{ this.isComplete ? '' : 'disabled' }}>
                    Envoyer<span class="max-sm:hidden"> l'offre</span>
                </button>
            </div>
        </div>
    </div>
</div>

{% macro tab(side, label, count, current) %}
    <button type="button"
            role="tab"
            aria-selected="{{ side == current ? 'true' : 'false' }}"
            data-action="live#action"
            data-live-action-param="showSide"
            data-live-side-param="{{ side }}"
            data-testid="tab-{{ side }}"
            class="seg{{ side == current ? ' on' }}">
        {{ label }} · {{ count }}
    </button>
{% endmacro %}

{% macro column(side, title, groups, visibleCount, total, adjective, current, selection, emptyMessage, chips, ctx) %}
    <section class="composer-col {{ side != current ? 'hidden lg:block' }}" aria-labelledby="composer-{{ side }}-title" data-testid="{{ side }}-column">
        <div class="composer-col__head">
            <h2 id="composer-{{ side }}-title" class="h2 text-[18px]">{{ title }}</h2>
            <span class="lbl">
                {{ visibleCount }}{{ visibleCount != total ? ' / ' ~ total }} carte{{ visibleCount > 1 ? 's' }}{{ adjective ? ' ' ~ adjective ~ (visibleCount > 1 ? 's') }}
            </span>
        </div>
        <div class="composer-chips" role="group" aria-label="{{ side == 'offered' ? 'Filtrer tes cartes' : 'Filtrer ses cartes' }}" data-testid="{{ side }}-chips">
            {% for chip in chips %}
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="filterSide"
                        data-live-side-param="{{ side }}"
                        data-live-filter-param="{{ chip.value }}"
                        data-testid="chip-{{ side }}-{{ chip.value }}"
                        aria-pressed="{{ chip.active ? 'true' : 'false' }}"
                        class="seg{{ chip.active ? ' on' }}">
                    {{ chip.label }}{% if chip.value != 'all' %} <span class="filter-chip__count">· {{ chip.count }}</span>{% endif %}
                </button>
            {% endfor %}
        </div>

        {% if groups is empty %}
            <div class="panel px-6 py-10 text-center text-sm text-ink-muted" data-testid="{{ side }}-empty">
                {{ total > 0 ? 'Aucune carte ne correspond au filtre.' : emptyMessage }}
            </div>
        {% else %}
            <div class="flex flex-col gap-6" data-testid="{{ side }}-list">
                {% for group in groups %}
                    <div class="flex flex-col gap-3" data-testid="{{ side }}-universe">
                        <h3 class="lbl">{{ group.extension.name }} · {{ group.entries|length }}</h3>
                        <div class="composer-grid">
                            {% for entry in group.entries %}
                                {{ _self.tile(side, entry, selection[entry.token]|default({ normal: 0, holo: 0 }), ctx) }}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endmacro %}

{% macro tile(side, entry, picked, ctx) %}
    {% set selectedCopies = picked.normal + picked.holo %}
    {% set tradable = side == 'requested' or entry.normal + entry.holo > 0 %}
    {% set rarity = entry.rarity.value %}
    <article class="cell trade-tile trade-tile--{{ side }}{{ selectedCopies > 0 ? ' is-selected' }}"
             data-testid="trade-tile"{% if selectedCopies > 0 %} data-selected{% endif %}>
        <div class="cell__art trade-tile__art">
            {% if entry.card %}
                {{ include('components/CardComponent.html.twig', {
                    card: entry.card,
                    holo: picked.holo > 0 or (entry.normal == 0 and entry.holo > 0),
                    interactive: false,
                    lazy: true,
                    id: 'trade-' ~ side ~ '-' ~ entry.token,
                }, with_context = false) }}
            {% else %}
                {{ include('parts/_masked_card.html.twig', { rarity: rarity }, with_context = false) }}
            {% endif %}
            {% if tradable %}
                <button type="button" class="trade-tile__hit"
                        aria-pressed="{{ selectedCopies > 0 ? 'true' : 'false' }}"
                        aria-label="{{ selectedCopies > 0 ? 'Retirer de l\'offre' : (side == 'offered' ? 'Proposer' : 'Demander') }} : {{ entry.card ? entry.card.name : 'carte inconnue ' ~ entry.rarity.label|lower }}"
                        data-action="live#action"
                        data-live-action-param="toggle"
                        data-live-side-param="{{ side }}"
                        data-live-token-param="{{ entry.token }}"
                        data-loading="addAttribute(disabled)"
                        data-testid="tile-toggle"></button>
            {% endif %}
            {% if selectedCopies > 0 %}
                <span class="qty trade-tile__check" data-testid="tile-badge">✓ ×{{ selectedCopies }}</span>
            {% elseif side == 'offered' and entry.mine > 1 %}
                <span class="qty">×{{ entry.mine }}</span>
            {% endif %}
            {% if ctx.wishlist and entry.card %}
                <button type="button"
                        data-action="live#action" data-live-action-param="toggleWish" data-live-token-param="{{ entry.token }}"
                        data-loading="addAttribute(disabled)"
                        aria-pressed="{{ entry.wished ? 'true' : 'false' }}"
                        aria-label="Ajouter ou retirer de ma wishlist"
                        data-testid="tile-wish"
                        class="trade-tile__wish">{{ entry.wished ? '♥' : '♡' }}</button>
            {% endif %}
        </div>

        {% if entry.card %}
            <p class="cn truncate" title="{{ entry.card.name }}">{{ entry.card.name }}</p>
        {% else %}
            <p class="cm truncate">Carte inconnue</p>
        {% endif %}
        <span class="lbl r-{{ rarity|first }}"{% if not entry.card %} data-testid="masked-rarity"{% endif %}>
            {{ entry.rarity.icon }} {{ entry.rarity.label }}
        </span>

        {% set lacks = tradable and (side == 'offered' ? entry.theirs == 0 : not entry.card) %}
        {% set doubleCount = tradable ? (side == 'offered' ? entry.mine : entry.theirs) : 0 %}
        {% set lastCopy = tradable and side == 'offered' and entry.mine == 1 %}
        {% set wantedByHim = side == 'offered' and entry.wanted %}
        {% if lacks or doubleCount >= 2 or lastCopy or wantedByHim %}
            <p class="trade-tile__hints" data-testid="tile-hints">
                {% if wantedByHim %}
                    <span class="chip chip-holo" data-testid="hint-wanted">♡ {{ ctx.theirName }} la cherche</span>
                {% endif %}
                {% if lacks %}
                    <span class="chip chip-live" data-testid="hint-lacks">✚ {{ side == 'offered' ? 'Lui manque' : 'Te manque' }}</span>
                {% endif %}
                {% if doubleCount >= 2 %}
                    <span class="chip" data-testid="hint-double">doublon{{ side == 'offered' ? ' ×' ~ doubleCount }}</span>
                {% endif %}
                {% if lastCopy %}
                    <span class="chip chip-soon" data-testid="hint-last">dernier exemplaire</span>
                {% endif %}
            </p>
        {% endif %}

        {% if entry.listed > 0 or tradable %}
            <div class="trade-tile__finishes">
                {% if entry.listed > 0 %}
                    <p class="lbl text-soon" data-testid="tile-listed">¤ en vente ×{{ entry.listed }}{{ entry.normal + entry.holo == 0 ? ' · verrouillée' }}</p>
                {% endif %}
                {% for finish in ['normal', 'holo'] %}
                    {% set available = entry[finish] %}
                    {% if available > 0 %}
                        <div class="trade-tile__finish">
                            <span class="trade-tile__flabel{{ finish == 'holo' ? ' text-magenta' }}">
                                {{- finish == 'holo' ? '✦ Holo' : 'Normale' }} · <span data-testid="cap-{{ side }}-{{ finish }}">{{ available }} dispo</span>
                            </span>
                            <div class="trade-tile__stepper">
                                {{ _self.stepper(side, entry.token, finish, -1, picked[finish] <= 0) }}
                                <span class="trade-tile__picked{{ picked[finish] > 0 ? (finish == 'holo' ? ' text-magenta' : ' text-ink-strong') }}"
                                      data-testid="qty-{{ side }}-{{ finish }}">{{ picked[finish] }}</span>
                                {{ _self.stepper(side, entry.token, finish, 1, picked[finish] >= available) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </article>
{% endmacro %}

{% macro stepper(side, token, finish, delta, disabled) %}
    <button type="button"
            class="trade-step"
            aria-label="{{ delta > 0 ? 'Ajouter' : 'Retirer' }} une copie {{ finish == 'holo' ? 'holo' : 'normale' }}"
            data-action="live#action"
            data-live-action-param="adjust"
            data-live-side-param="{{ side }}"
            data-live-token-param="{{ token }}"
            data-live-finish-param="{{ finish }}"
            data-live-delta-param="{{ delta }}"
            data-testid="{{ delta > 0 ? 'plus' : 'minus' }}-{{ side }}-{{ finish }}"
            {{ disabled ? 'disabled' }}>{{ delta > 0 ? '+' : '−' }}</button>
{% endmacro %}

{% macro recap(label, summary, side) %}
    {% set fresh = side == 'requested' ? summary.items|filter(item => not item.entry.card)|length : 0 %}
    <div class="composer-recap" data-testid="recap-{{ side }}">
        <span class="flex flex-col">
            <span class="lbl">{{ label }}</span>
            <span class="d composer-recap__count{{ summary.copies == 0 ? ' text-ink-dim' }}" data-testid="recap-{{ side }}-count">{{ summary.copies }}</span>
        </span>
        {% if summary.items is not empty %}
            <span class="composer-recap__thumbs" aria-hidden="true">
                {% for item in summary.items|slice(0, 4) %}
                    {% if item.entry.card %}
                        <img class="card-thumb" src="{{ item.entry.card.imageName ? vich_uploader_asset(item.entry.card) : asset('images/default_card.png') }}" alt="" loading="lazy">
                    {% else %}
                        <span class="composer-recap__back" style="--back-color: var(--rarity-{{ item.entry.rarity.value }});"></span>
                    {% endif %}
                {% endfor %}
                {% if summary.items|length > 4 %}<span class="lbl self-center">+{{ summary.items|length - 4 }}</span>{% endif %}
            </span>
            <span class="muted composer-recap__digest" data-testid="recap-{{ side }}-digest">
                {%- for bucket in summary.byRarity -%}
                    {{ bucket.copies }} {{ bucket.rarity.label|lower }}{{ bucket.copies > 1 ? 's' }}{{ not loop.last ? ', ' }}
                {%- endfor -%}
                {%- if fresh > 0 %}, {{ fresh > 1 ? fresh ~ ' nouvelles' : 'nouvelle' }} pour toi{% endif -%}
            </span>
            <span class="sr" data-testid="recap-{{ side }}-items">
                {% for item in summary.items %}
                    {{- item.entry.card ? item.entry.card.name : 'Inconnue (' ~ item.entry.rarity.label ~ ')' -}}
                    {{- item.normal > 0 ? ' ×' ~ item.normal -}}
                    {{- item.holo > 0 ? ' ✦×' ~ item.holo -}}
                    {{- not loop.last ? ' · ' -}}
                {% endfor %}
            </span>
        {% endif %}
    </div>
{% endmacro %}

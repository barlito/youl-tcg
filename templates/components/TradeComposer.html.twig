<div {{ attributes }}>
    {% if error %}
        <p class="mb-6 border border-magenta/40 bg-magenta/10 px-4 py-3 text-sm text-magenta" data-testid="composer-error">{{ error }}</p>
    {% endif %}

    <div class="grid items-start gap-8 lg:grid-cols-2">
        {# ------------------------------------------------------ Mon côté #}
        {{ _self.side(
            'Tu proposes',
            this.visibleMyCopies,
            offered,
            'offered',
            'searchMine',
            searchMine,
            'Aucun exemplaire disponible : tes cartes sont peut-être déjà engagées dans d\'autres offres.',
            null
        ) }}

        {# ---------------------------------------------------- Leur côté #}
        {{ _self.side(
            'Tu demandes à ' ~ this.counterpart.username,
            this.visibleTheirCopies,
            requested,
            'requested',
            'searchTheirs',
            searchTheirs,
            'Ce joueur n\'a aucune carte pour l\'instant.',
            'Les cartes que tu ne possèdes pas restent masquées : le filtre ne porte que sur les autres.'
        ) }}
    </div>

    {# ------------------------------------------------------------ Récap #}
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t-2 border-hairline pt-6">
        <p class="chip-mono text-ink-muted" data-testid="composer-summary">
            {{ this.offeredCount }} carte(s) proposée(s) · {{ this.requestedCount }} demandée(s)
        </p>
        <button type="button"
                data-action="live#action"
                data-live-action-param="submit"
                data-loading="addClass(opacity-50)"
                data-testid="submit-offer"
                {{ this.isComplete ? '' : 'disabled' }}
                class="notched-lg bg-primary px-6 py-3 font-display text-sm font-bold uppercase tracking-[.15em] text-black disabled:cursor-not-allowed disabled:opacity-40">
            Envoyer l'offre ▸
        </button>
    </div>
</div>

{% macro side(title, copies, selection, sideKey, searchModel, searchValue, emptyMessage, searchHint) %}
    <section>
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-display text-sm font-bold uppercase tracking-[.1em] text-ink-strong">{{ title }}</h2>
            <input type="search"
                   data-model="debounce(300)|{{ searchModel }}"
                   value="{{ searchValue }}"
                   placeholder="Filtrer…"
                   aria-label="Filtrer les cartes"
                   data-testid="search-{{ sideKey }}"
                   class="w-40 border border-hairline bg-surface px-3 py-1.5 font-mono text-xs text-ink placeholder:text-ink-dim focus:border-primary focus:outline-none">
        </div>
        {% if searchHint %}
            <p class="mt-2 text-xs text-ink-dim" data-testid="search-hint-{{ sideKey }}">{{ searchHint }}</p>
        {% endif %}

        {% if copies is empty %}
            <div class="mt-4 border border-dashed border-hairline px-6 py-10 text-center text-sm text-ink-dim">
                {{ searchValue ? 'Aucune carte ne correspond à « ' ~ searchValue ~ ' ».' : emptyMessage }}
            </div>
        {% else %}
            {# la collection entière est bien trop longue à plat : panneau scrollable #}
            <div class="mt-4 grid max-h-[65vh] gap-3 overflow-y-auto pr-1" data-testid="{{ sideKey }}-list">
                {% for cardId, entry in copies %}
                    {% set picked = selection[cardId]|default({ normal: 0, holo: 0 }) %}
                    <div class="flex items-center gap-4 border border-hairline bg-surface p-3">
                        <div class="w-16 shrink-0">
                            {% if entry.card %}
                                {{ include('components/CardComponent.html.twig', { card: entry.card, holo: entry.normal == 0, lazy: true }) }}
                            {% else %}
                                {# sans contexte : le rendu masqué n'a accès à aucune carte #}
                                {{ include('parts/_card_back.html.twig', {}, with_context = false) }}
                            {% endif %}
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-display text-sm font-bold uppercase tracking-[-0.02em] {{ entry.card ? 'text-ink-strong' : 'text-ink-dim' }}">
                                {{ entry.card ? entry.card.name : 'Carte inconnue' }}
                            </p>
                            <p class="chip-mono mt-0.5 text-ink-dim">
                                {{ entry.normal }} dispo{% if entry.holo > 0 %} · <span class="text-primary">✦ {{ entry.holo }}</span>{% endif %}
                            </p>
                            <div class="mt-2 flex flex-wrap gap-3">
                                {% for finish, available in { normal: entry.normal, holo: entry.holo } %}
                                    {% if available > 0 %}
                                        <div class="flex items-center gap-1.5">
                                            <span class="chip-mono {{ finish == 'holo' ? 'text-primary' : 'text-ink-dim' }}">{{ finish == 'holo' ? '✦' : '▣' }}</span>
                                            {{ _self.stepper(sideKey, cardId, finish, -1, '−') }}
                                            <span class="w-5 text-center font-mono text-sm text-ink-strong"
                                                  data-testid="qty-{{ sideKey }}-{{ finish }}">{{ picked[finish] }}</span>
                                            {{ _self.stepper(sideKey, cardId, finish, 1, '+') }}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endmacro %}

{% macro stepper(sideKey, cardId, finish, delta, label) %}
    <button type="button"
            data-action="live#action"
            data-live-action-param="adjust"
            data-live-side-param="{{ sideKey }}"
            data-live-card-id-param="{{ cardId }}"
            data-live-finish-param="{{ finish }}"
            data-live-delta-param="{{ delta }}"
            data-loading="addClass(opacity-50)"
            data-testid="{{ delta > 0 ? 'plus' : 'minus' }}-{{ sideKey }}-{{ finish }}"
            class="h-6 w-6 border border-hairline font-mono text-sm leading-none text-ink-muted transition-colors hover:border-primary hover:text-primary">
        {{ label }}
    </button>
{% endmacro %}

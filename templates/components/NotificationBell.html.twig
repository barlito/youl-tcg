{# Header bell: re-rendered by realtime notifications; the daily boosters
   entry is computed on render, never stored #}
{% set unread = this.unreadCount %}
{% set remainingClaims = this.remainingClaims %}
<div {{ attributes.defaults({
    class: 'relative',
    'data-testid': 'notification-bell',
    'data-controller': 'notification-bell',
    'data-action': 'live-updates:notification@window->live#$render click@window->notification-bell#clickOutside keydown.esc@window->notification-bell#close',
    'data-notification-bell-open-value': open ? 'true' : 'false',
    'data-notification-bell-remaining-value': remainingClaims,
    'data-notification-bell-seconds-value': this.secondsUntilReset,
    'data-notification-bell-period-value': this.claimPeriod,
    'data-notification-bell-next-period-value': this.nextClaimPeriod,
}) }}>
    <button type="button"
            class="ib{{ open ? ' hot' }}"
            data-action="live#action" data-live-action-param="toggle"
            aria-haspopup="true" aria-expanded="{{ open ? 'true' : 'false' }}"
            aria-label="Notifications{{ unread > 0 ? ' (' ~ unread ~ ' non lue' ~ (unread > 1 ? 's') ~ ')' }}"
            data-testid="notification-bell-toggle">
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4l2-2Z"/>
            <path d="M10 21h4"/>
        </svg>
        {% if unread > 0 %}
            <span class="badge absolute -right-[7px] -top-[7px] shadow-[0_0_12px_#ff3db088]"
                  data-testid="notification-badge">{{ unread > 9 ? '9+' : unread }}</span>
        {% elseif remainingClaims > 0 %}
            <span class="absolute -right-1 -top-1 h-2.5 w-2.5 bg-live shadow-[0_0_8px_#5be584]" aria-hidden="true"></span>
        {% endif %}
    </button>

    {% if open %}
        {% set notifications = this.notifications %}
        {% set fresh = notifications|filter(n => n.unread) %}
        {% set earlier = notifications|filter(n => not n.unread) %}
        <section class="bell-panel" role="dialog" aria-label="Notifications" data-testid="notification-panel">
            <header class="bell-panel__head">
                <span class="lbl text-magenta">Notifications</span>
                {% if unread > 0 %}<span class="badge">{{ unread > 9 ? '9+' : unread }}</span>{% endif %}
                {% if unread > 0 %}
                    <button type="button" class="tl ml-auto"
                            data-action="live#action" data-live-action-param="markAllRead"
                            data-testid="notification-mark-all">Tout marquer comme lu</button>
                {% endif %}
            </header>

            <div class="bell-panel__list">
                {% if remainingClaims > 0 or fresh is not empty %}
                    <span class="lbl bell-panel__group">Nouveau</span>
                {% endif %}
                {% if remainingClaims > 0 %}
                    <a href="{{ path('boosters') }}" class="bell-item bell-item--new" data-testid="notification-daily-boosters">
                        <span class="bell-item__ic text-live" aria-hidden="true">●</span>
                        <span class="min-w-0">
                            <span class="bell-item__text">Tes packs du jour sont disponibles</span>
                            <span class="muted text-xs">{{ remainingClaims }} gratuit{{ remainingClaims > 1 ? 's' }}</span>
                        </span>
                        <span class="lbl bell-item__cta">Récupérer ›</span>
                    </a>
                {% endif %}
                {% for notification in fresh %}
                    {{ _self.item(notification) }}
                {% endfor %}

                {% if earlier is not empty %}
                    <span class="lbl bell-panel__group{{ remainingClaims > 0 or fresh is not empty ? ' bell-panel__group--sep' }}">Plus tôt</span>
                    {% for notification in earlier %}
                        {{ _self.item(notification) }}
                    {% endfor %}
                {% endif %}

                {% if notifications is empty and remainingClaims == 0 %}
                    <p class="muted px-4 py-8 text-center text-sm" data-testid="notification-empty">Rien de neuf pour l'instant.</p>
                {% endif %}
            </div>
        </section>
    {% endif %}
</div>

{% macro item(notification) %}
    {% set tones = { '♛': 'text-soon', '★': 'text-live', '✓': 'text-live', '▲': 'text-soon', '+': 'tone-violet', '⇄': 'tone-violet', '✕': 'tone-danger', '$': 'text-live', '♡': 'text-magenta', '!': 'text-magenta', '#': 'tone-violet' } %}
    <button type="button"
            class="bell-item{{ notification.unread ? ' bell-item--new' }}"
            data-action="live#action" data-live-action-param="openNotification"
            data-live-id-param="{{ notification.id }}"
            data-testid="notification-item"{{ notification.unread ? ' data-unread' }}>
        <span class="bell-item__ic {{ tones[notification.icon] ?? 'text-ink-muted' }}" aria-hidden="true">{{ notification.icon }}</span>
        <span class="flex min-w-0 flex-col gap-0.5">
            <span class="bell-item__text">{{ notification.text }}</span>
            {% if notification.body %}
                {# plain text, auto-escaped: line breaks kept by CSS, never |raw #}
                <span class="muted line-clamp-4 whitespace-pre-line break-words text-xs" data-testid="notification-body">{{ notification.body }}</span>
            {% endif %}
            {% if notification.createdAt %}
                <span class="muted text-xs">{{ notification.createdAt|date('d/m · H:i', 'Europe/Paris') }}</span>
            {% endif %}
        </span>
        {% if notification.unread and notification.link %}
            <span class="lbl bell-item__cta">Voir ›</span>
        {% endif %}
    </button>
{% endmacro %}

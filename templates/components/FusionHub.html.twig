<div {{ attributes.defaults({'data-action': 'live-updates:inventory-changed@window->live#$render live-updates:market-changed@window->live#$render live-updates:trades-changed@window->live#$render'}) }}>
    {% set cost = this.cost %}
    {% set ready = this.ready %}
    {% set almost = this.almost %}
    <main>
        {% embed 'parts/ui/_page_header.html.twig' with { eyebrow: 'Mon espace', readyCount: ready|length } %}
            {% block title %}Fusionne tes doublons{% endblock %}
            {% block aside %}
                <p class="lead">
                    {{ cost }} exemplaires normaux d'une même carte deviennent 1 exemplaire <span class="text-magenta">✦ holo</span>.
                    Les copies en vente ou dans un échange en attente ne comptent pas.
                </p>
                <p class="sr" data-testid="fusion-rule">{{ cost }} normales → 1 holo</p>
            {% endblock %}
            {% block nav %}{{ include('parts/ui/_my_space_nav.html.twig', { current: 'fusion', counts: { fusion: readyCount > 0 ? readyCount : null } }) }}{% endblock %}
        {% endembed %}

        <div class="wrap flex flex-col gap-8 pb-24 pt-6 md:pt-8">
            {% if error %}
                <div class="panel flash-msg flash-msg--err" role="alert" data-testid="fusion-error">⚠ {{ error }}</div>
            {% elseif success %}
                <div class="panel flash-msg flash-msg--ok fusion-flash flex items-center gap-4" role="status" data-testid="fusion-success">
                    {% set fused = this.fusedCard %}
                    {% if fused %}
                        <div class="w-16 shrink-0">
                            {{ include('components/CardComponent.html.twig', {
                                card: fused, holo: true, interactive: false, lazy: true, id: 'fused-' ~ fused.id,
                            }, with_context = false) }}
                        </div>
                    {% endif %}
                    <p>✦ {{ success }}</p>
                </div>
            {% endif %}

            {% if not this.hasRows %}
                <div class="panel flex flex-col items-center gap-2.5 border-dashed px-6 py-16 text-center" data-testid="fusion-empty">
                    <span class="d up text-lg text-ink-strong">Aucune carte fusionnable</span>
                    <span class="muted max-w-[46ch]">Il te faut au moins {{ cost }} exemplaires normaux d'une même carte.</span>
                    <a href="{{ path('boosters') }}" class="btn btn-p btn-s mt-2">Ouvrir un pack</a>
                </div>
            {% else %}
                <p class="muted text-[13px]" data-testid="fusable-total">
                    <span class="mono text-ink-strong">{{ this.fusableTotal }}</span> fusion{{ this.fusableTotal > 1 ? 's' }} possible{{ this.fusableTotal > 1 ? 's' }} dans ta collection
                </p>

                {% if ready is not empty %}
                    <section aria-labelledby="fusion-ready" class="flex flex-col gap-3.5">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 id="fusion-ready" class="h2">Prêtes à fusionner</h2>
                            <span class="muted">{{ ready|length }} carte{{ ready|length > 1 ? 's' }}</span>
                        </div>
                        <div class="fusion-grid" data-testid="fusion-grid">
                            {% for row in ready %}{{ _self.card(this, row) }}{% endfor %}
                        </div>
                    </section>
                {% endif %}

                {% if almost is not empty %}
                    <section aria-labelledby="fusion-almost" class="flex flex-col gap-3.5">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 id="fusion-almost" class="h2">Presque</h2>
                            <span class="muted">des copies sont en vente ou dans un échange</span>
                        </div>
                        <div class="fusion-grid" data-testid="fusion-almost-grid">
                            {% for row in almost %}{{ _self.card(this, row) }}{% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endif %}
        </div>
    </main>
</div>

{% macro card(hub, row) %}
    {% set card = row.card %}
    {% set cost = hub.cost %}
    {% set free = hub.freeNormal(row) %}
    {% set maxFusions = hub.maxFusions(row) %}
    {% set engagedNormal = hub.engagedNormal(row) %}
    {% set listed = hub.isListed(row) %}
    {% set asking = hub.isConfirming(row) %}
    <article class="panel fusion-card{{ maxFusions > 0 ? ' hot' }}{{ asking ? ' fusion-card--asking' }}" data-testid="fusion-card">
        {{ include('parts/ui/_card_thumb.html.twig', { card: card, holo: false }, with_context = false) }}
        <div class="flex min-w-0 flex-col gap-1.5">
            <span class="cn" title="{{ card.name }}">{{ card.name }}</span>
            <span class="lbl truncate"><span class="r-{{ card.rarity.value|first }}">{{ card.rarity.icon }} {{ card.rarity.label }}</span> · {{ card.extension.name }}</span>
            <span class="flex justify-between gap-2 text-[13px]">
                <span class="muted">normales libres</span>
                <span class="mono text-ink-strong" data-testid="free-normal">{{ free }} / {{ cost }}</span>
            </span>
            <div class="bar" aria-hidden="true"><i style="width: {{ (min(free, cost) / cost * 100)|round }}%"></i></div>
            {% if engagedNormal > 0 %}
                <span class="chip chip-soon self-start" data-testid="engaged-badge">{{ listed ? '¤ en vente' : '⇄ en échange' }} ×{{ engagedNormal }}</span>
            {% endif %}
            {% if maxFusions < 1 %}
                <span class="text-xs text-soon" data-testid="engaged-notice">
                    {{ engagedNormal }} copie{{ engagedNormal > 1 ? 's' }} {{ listed ? 'en vente dans ta boutique' : 'dans un échange en attente' }}
                </span>
                {% if listed %}
                    <a class="btn btn-g btn-s mt-auto" href="{{ path('market_my_shop') }}">Retirer de la vente</a>
                {% elseif feature_enabled('trades') %}
                    <a class="btn btn-g btn-s mt-auto" href="{{ path('trades') }}">Voir mes échanges</a>
                {% endif %}
            {% else %}
                {% if row.holoQuantity > 0 %}
                    <span class="muted text-xs">tu as déjà <span class="text-magenta">✦ ×{{ row.holoQuantity }}</span></span>
                {% endif %}
                {% if asking %}
                    <div class="mt-auto flex flex-col gap-2 border-t border-hairline pt-2.5">
                        <div class="flex items-center justify-between gap-2">
                            <span class="lbl">Fusions</span>
                            <span class="flex items-center gap-1.5">
                                <button type="button" class="ib fusion-step" aria-label="Moins de fusions"
                                        data-action="live#action" data-live-action-param="changeTimes" data-live-delta-param="-1"
                                        {{ hub.times <= 1 ? 'disabled' }}>−</button>
                                <span class="mono w-12 text-center text-ink-strong" data-testid="fusion-times">{{ hub.times }}<span class="muted text-[10px]">/{{ maxFusions }}</span></span>
                                <button type="button" class="ib fusion-step" aria-label="Plus de fusions"
                                        data-action="live#action" data-live-action-param="changeTimes" data-live-delta-param="1"
                                        data-testid="fusion-plus" {{ hub.times >= maxFusions ? 'disabled' }}>+</button>
                            </span>
                        </div>
                        <p class="muted text-xs" data-testid="fusion-confirmation">{{ hub.times * cost }} normales → {{ hub.times }} <span class="text-magenta">✦ holo</span>. Irréversible.</p>
                        <div class="flex gap-2">
                            <button type="button" class="btn btn-g btn-s" data-action="live#action" data-live-action-param="abort" data-testid="fusion-abort">Annuler</button>
                            <button type="button" class="btn btn-p btn-s flex-1"
                                    data-action="live#action" data-live-action-param="fuse"
                                    data-loading="addAttribute(disabled) addClass(opacity-50)"
                                    data-testid="fusion-confirm">✓ Confirmer</button>
                        </div>
                    </div>
                {% else %}
                    <button type="button" class="btn btn-p btn-s mt-auto"
                            data-action="live#action" data-live-action-param="askFuse" data-live-card-id-param="{{ card.id }}"
                            data-testid="fusion-ask">✦ Fusionner {{ cost }} → 1 holo{% if maxFusions > 1 %} · ×{{ maxFusions }}{% endif %}</button>
                {% endif %}
            {% endif %}
        </div>
    </article>
{% endmacro %}

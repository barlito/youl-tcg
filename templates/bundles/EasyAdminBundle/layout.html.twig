{% extends '@!EasyAdmin/layout.html.twig' %}

{# The Violet Arcade back-office theme (styles/admin/theme.css) is dark only:
   the scheme is pinned before the first paint instead of EA's light/dark/auto
   handler, whose selector is hidden by Dashboard::disableDarkMode(). #}
{% block javascript_page_color_scheme %}
    <script>
        document.body.classList.remove('ea-light-scheme');
        document.body.classList.add('ea-dark-scheme');
        document.body.style.colorScheme = 'dark';
        document.body.setAttribute('data-bs-theme', 'dark');
    </script>
{% endblock javascript_page_color_scheme %}

{
	{$CADDY_GLOBAL_OPTIONS}

  	servers {
    	protocols h1 h2
  	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root * /app/public
	encode zstd br gzip

	# Built-in Mercure hub (same origin as the app, served before php_server).
	# One key for publishers (PHP) and subscribers (mercureAuthorization cookie):
	# only the app signs JWTs. No anonymous subscribers, every update is private
	# except the public broadcast topic, which carries no personal data.
	mercure {
		# Mercure 1.0 modern mode needs RFC 9068 tokens (iss/aud/authorization_details),
		# which symfony/mercure does not issue yet: keep the 0.x token format.
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_JWT_SECRET} HS256
		subscriber_jwt {env.MERCURE_JWT_SECRET} HS256
		cors_origins {$MERCURE_CORS_ORIGINS:https://ytcg.youlz.fr}
		publish_origins {$MERCURE_CORS_ORIGINS:https://ytcg.youlz.fr}
		transport bolt {
			path /app/var/mercure.db
		}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	php_server
}

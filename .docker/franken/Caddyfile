{
	{$CADDY_GLOBAL_OPTIONS}

  	servers {
    	protocols h1 h2
  	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root * /app/public
	encode zstd br gzip

	# Built-in Mercure hub (same origin as the app), protocol 1.0 modern mode.
	# Only the app signs tokens (one key, bound to its `iss`). `aud` is pinned to
	# the public URL: behind Traefik the hub would derive an http:// identifier.
	# No anonymous subscribers: every update is private except /broadcast.
	mercure {
		issuer {$MERCURE_TRUSTED_ISSUER:https://ytcg.youlz.fr} {
			publisher {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
			subscriber {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
		}
		resource_identifier {$MERCURE_RESOURCE_IDENTIFIER:https://ytcg.youlz.fr/.well-known/mercure}
		cookie_name __Secure-mercure_access_token
		cors_origins {$MERCURE_CORS_ORIGINS:https://ytcg.youlz.fr}
		publish_origins {$MERCURE_CORS_ORIGINS:https://ytcg.youlz.fr}
		transport bolt {
			path /app/var/mercure.db
		}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	php_server
}
